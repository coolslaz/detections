DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where FileName in~ ("grep", "find", "bash", "sh", "awk")
| where ProcessCommandLine has_any ("-r", "-R", "-name", "--include", "-exec")
| where ProcessCommandLine has_any ("/etc/shadow", "id_rsa", "id_dsa", "id_ecdsa", "id_ed25519", ".ssh/authorized_keys", ".ssh")
 or (ProcessCommandLine has_any ("grep", "find") and ProcessCommandLine has_any ("password", "passwd", "pwd=", "pass="))
 or ProcessCommandLine has_any ("connectionstring", "connection_string", "jdbc:", "DATABASE_URL", "db_password", "database.yml", "config.php")
| where not(InitiatingProcessFileName in~ ("ansible", "puppet", "chef-client", "cron", "crond", "nessus", "auditd", "osqueryd"))
| where not(ProcessCommandLine has_any ("nagios", "zabbix", "prometheus", "security-audit", "compliance-scan", "backup.sh"))
| where not(AccountName in~ ("svc_backup", "svc_audit", "svc_monitoring", "root_audit", "ansible", "nagios", "zabbix"))
| where InitiatingProcessCommandLine !has "/opt/approved-scripts/"
| summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Commands = make_set(ProcessCommandLine, 10) by DeviceName, AccountName, FileName, InitiatingProcessFileName, InitiatingProcessCommandLine
| where FirstSeen != LastSeen or array_length(Commands) > 0
| order by LastSeen desc