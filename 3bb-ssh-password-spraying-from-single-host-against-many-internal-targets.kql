let SprayLookbook = 1d;
let TimeWindow = 15m;
let MinDistinctTargets = 55;
let MinFailedAttempts = 55;
let KnownScannerAllowList = dynamic([]);
DeviceLogonEvents
| where TimeGenerated > ago(SprayLookbook)
| where ActionType == "LogonFailed"
| where Protocol =~ "SSH" or LogonType has "Network"
| where RemoteIP != "" or RemoteDeviceName != ""
| where RemoteIP !in (KnownScannerAllowList)
| summarize FailedAttempts = count(), TargetHosts = make_set(DeviceName, 100), DistinctTargetCount = dcount(DeviceName) by InitiatingProcessAccountName, RemoteIP, TimeGenerated=bin(TimeGenerated, TimeWindow)
| where DistinctTargetCount >= MinDistinctTargets and FailedAttempts >= MinFailedAttempts
| project TimeGenerated, RemoteIP, InitiatingProcessAccountName, DistinctTargetCount, FailedAttempts, TargetHosts
| sort by DistinctTargetCount desc