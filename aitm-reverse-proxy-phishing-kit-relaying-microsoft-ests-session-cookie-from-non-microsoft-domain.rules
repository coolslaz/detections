alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AiTM reverse-proxy phishing kit relaying Microsoft ESTS session cookie from non-Microsoft domain"; flow:from_server,established; http.header_names; content:"Set-Cookie"; http.header; content:"Set-Cookie:"; nocase; content:"ESTSAUTH"; nocase; distance:0; within:40; http.host; content:!"login.microsoftonline.com"; content:!"login.microsoftonline.us"; content:!"login.microsoft.com"; content:!"login.windows.net"; content:!"sts.windows.net"; content:!"login.live.com"; content:!"account.microsoft.com"; content:!"msauth.net"; content:!"msftauth.net"; classtype:credential-theft; metadata: author Arnold Chan, created_at 2026-01-01, mitre_tactic_id TA0006, mitre_technique_id T1557, mitre_technique_id T1539, tag suricata; reference:url,https://thehackernews.com/2026/09/know-your-enemy-browser-based-attack.html; sid:1000101; rev:2;)

