DeviceProcessEvents
| where TimeGenerated > ago(14d)
| where ProcessCommandLine has_any ("radcheck", "radreply", "radgroupcheck", "radgroupreply", "radacct", "radippool", "raddb", "/etc/freeradius", "radius.sqlite", "radius.db")
| where ProcessCommandLine has_any ("mysqldump", "pg_dump", "sqlite3", "SELECT", "COPY", "export", "dump")
| where ProcessCommandLine has_any ("password", "credential", "subscriber", "users", "auth")
// Exclude routine scheduled backup/maintenance jobs
| where not(InitiatingProcessCommandLine has_any ("cron", "crontab", "systemd", "backup.sh", "logrotate", "scheduled"))
| where not(InitiatingProcessFileName in~ ("cron", "crond", "systemd", "anacron"))
// Exclude known administrative accounts that legitimately manage these databases
| where not(AccountName in~ ("radius_admin", "freeradius", "svc_backup", "root") and InitiatingProcessFileName in~ ("radiusd", "freeradius", "mysqldump", "pg_dump"))
// Flag anomalous access pattern: bulk export volume, off-hours activity, or unexpected process performing the access
| extend HourOfDay = hourofday(TimeGenerated)
| extend IsOffHours = (HourOfDay < 6 or HourOfDay > 21)
| extend IsBulkExport = (ProcessCommandLine has_any ("SELECT *", "COPY", "mysqldump", "pg_dump") and ProcessCommandLine has_any (">", "-o ", "--result-file", "output"))
| extend IsUnexpectedProcess = not(FileName in~ ("mysqldump", "pg_dump", "sqlite3", "radiusd", "freeradius"))
| where IsOffHours or IsBulkExport or IsUnexpectedProcess
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessAccountName, InitiatingProcessFileName, HourOfDay, IsOffHours, IsBulkExport, IsUnexpectedProcess
| sort by TimeGenerated desc