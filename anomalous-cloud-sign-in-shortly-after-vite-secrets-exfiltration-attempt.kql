// Detects cloud authentication with anomalous sign-in properties occurring within a tight
// correlation window after an HTTP request to sensitive credential/config files on a Vite
// dev server (exfiltration precursor). Excludes trusted corporate locations/devices.
let CorrelationWindow = 3h;
let ExfilIndicators = dynamic([".env", ".env.production", ".env.local", "/.aws/credentials", "/.aws/config", "terraform.tfstate", "serverless.yml", "/proc/self/environ", "/proc/1/environ", "/proc/self/cwd/.env", "/etc/passwd"]);
let ViteExfilEvents = CommonSecurityLog
| where isnotempty(RequestURL)
| where RequestURL has_any (ExfilIndicators)
| project ExfilTime = TimeGenerated, ExfilSourceIP = SourceIP, RequestURL;
SigninLogs
| where ResultType == 0
| extend SignInTime = TimeGenerated, SignInIP = IPAddress
// Exclude sign-ins from named locations already marked as trusted (corporate ranges)
| where not(NetworkLocationDetails has "trusted")
// Exclude already-trusted / compliant / domain-joined devices
| extend DeviceTrustType = tostring(DeviceDetail.trustType), IsCompliant = tobool(DeviceDetail.isCompliant), IsManaged = tobool(DeviceDetail.isManaged)
| where not(IsCompliant == true or IsManaged == true or DeviceTrustType in ("Azure AD joined", "Hybrid Azure AD joined"))
// Require anomalous sign-in signals: risk detection, unfamiliar/new device, or impossible travel/anomalous location
| extend RiskEventTypesStr = tostring(RiskEventTypes)
| where RiskLevelDuringSignIn in ("medium", "high") or RiskState =~ "atRisk" or RiskEventTypesStr has_any ("unfamiliarFeatures", "anomalousLocation", "impossibleTravel", "newDevice") or DeviceTrustType == "" or isempty(DeviceDetail.deviceId)
| join kind=inner (ViteExfilEvents) on $left.SignInTime > $right.ExfilTime
| where SignInTime <= ExfilTime + CorrelationWindow
| where SignInIP != ExfilSourceIP
| project SignInTime, Identity = UserPrincipalName, SignInIP, AppDisplayName, Location = tostring(LocationDetails.city), RiskLevelDuringSignIn, RiskState, RiskEventTypesStr, DeviceTrustType, IsCompliant, IsManaged, ExfilTime, ExfilSourceIP, RequestURL, Platform = "Azure AD"
| sort by SignInTime asc