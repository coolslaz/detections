# WMI_ADMIN_HOSTS: operator-tunable variable listing known jump-boxes/admin subnets permitted to perform routine internal WMI/WinRM management. Default placeholder value below should be overridden in suricata.yaml or via -S/vars config, e.g. WMI_ADMIN_HOSTS: "[10.10.10.0/24]"
alert tcp $EXTERNAL_NET any -> $HOME_NET [135,5985,5986] (msg:"Anomalous external DCOM/WinRM connection attempt (possible remote WMI abuse)"; flow:to_server,established; tcp.flags:S; threshold:type limit, track by_src, count 3, seconds 120; metadata: author Arnold Chan, mitre_technique_id T1047, mitre_technique_id T1021; classtype:attempted-admin; sid:1000101; rev:2;)

alert tcp $HOME_NET any -> $HOME_NET [135,5985,5986] (msg:"Internal DCOM/WinRM session setup outside management baseline"; flow:to_server,established; tcp.flags:S; threshold:type threshold, track by_src, count 10, seconds 300; metadata: author detections.ai, mitre_technique_id T1047, mitre_technique_id T1021; classtype:attempted-admin; sid:1000102; rev:2;)