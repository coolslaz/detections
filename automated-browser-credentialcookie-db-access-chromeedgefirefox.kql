DeviceFileEvents
| where TimeGenerated > ago(1d)
| where FileName in~ ("Login Data", "Local State", "Cookies", "key4.db", "logins.json")
| where FolderPath has_any (@"Google\Chrome\User Data", @"Microsoft\Edge\User Data", @"Mozilla\Firefox\Profiles")
| where ActionType in ("FileCreated", "FileModified", "FileRenamed")
| where InitiatingProcessFileName !in~ ("chrome.exe", "msedge.exe", "firefox.exe", "explorer.exe", "SearchIndexer.exe", "SearchProtocolHost.exe", "MsMpEng.exe", "OneDrive.exe", "svchost.exe", "TrustedInstaller.exe")
| where InitiatingProcessFolderPath has_any (@"\ProgramData\", @"\AppData\Roaming\", @"\AppData\Local\Temp\")
| project TimeGenerated, DeviceId, DeviceName, FileName, FolderPath, ActionType, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, InitiatingProcessAccountName
| order by TimeGenerated desc