OfficeActivity
| where TimeGenerated > ago(1d)
| where Operation == "SearchQueryPerformed"
| summarize QueryCount = count(), Sites = make_set(Site_Url, 50), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by UserId, ClientIP
| extend DurationMinutes = datetime_diff('minute', LastSeen, FirstSeen), DistinctSiteCount = array_length(Sites)
// Volume + site-diversity heuristic: the M365 audit log does not capture the search query body for
// SearchQueryPerformed events, so enumeration is inferred from query volume and site spread rather
// than distinct query text.
| where QueryCount > 20 and DistinctSiteCount > 5
| project UserId, ClientIP, QueryCount, DistinctSiteCount, Sites, FirstSeen, LastSeen, DurationMinutes
| sort by QueryCount desc