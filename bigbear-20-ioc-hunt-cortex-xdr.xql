dataset = xdr_data | filter event_type = ENUM.NETWORK or (event_type = ENUM.PROCESS and action_process_image_path != null) | alter MatchedIndicator = coalesce(action_remote_ip, null), IndicatorType = if(event_type = ENUM.NETWORK, "ip", "domain"), IndicatorAge = if(action_remote_ip in ("38.60.250.157", "95.179.233.79", "80.240.27.55", "65.20.103.58", "38.54.124.88", "208.85.20.79", "95.179.169.154", "107.191.46.14", "130.94.82.180", "38.54.124.58", "208.85.18.18", "45.32.147.239", "208.76.222.214", "130.94.82.230", "65.20.102.80"), "current", "historical") | filter MatchedIndicator != null or (event_type = ENUM.PROCESS and action_process_image_path contains "konceptenterprises.com" or action_process_image_path contains "ccpipharma.com" or action_process_image_path contains "annastudios-paros.com" or action_process_image_path contains "dnsforward.com" or action_process_image_path contains "hotelmidtownsurat.com" or action_process_image_path contains "dataclust.com" or action_process_image_path contains "cifutura.com" or action_process_image_path contains "hoaivt.com" or action_process_image_path contains "dronalms.com" or action_process_image_path contains "virextec.com" or action_process_image_path contains "offtic.com" or action_process_image_path contains "rootreseller.com" or action_process_image_path contains "management.michaelmarcotte.com" or action_process_image_path contains "kgsscans.com" or action_process_image_path contains "soil-management.com" or action_process_image_path contains "daengrentacar.com" or action_process_image_path contains "arrmmy.com" or action_process_image_path contains "captelind.com" or action_process_image_path contains "planisteradmin.com" or action_process_image_path contains "hnospascualfadon.com" or action_process_image_path contains "haliotisbar.com" or action_process_image_path contains "knowncontractor.com" or action_process_image_path contains "valtteri.net") | fields _time, agent_hostname, MatchedIndicator, IndicatorType, IndicatorAge | sort desc _time