alert tls $HOME_NET any -> $EXTERNAL_NET 443 (msg:"BridgeAgent-style periodic TLS beacon/reverse-shell C2 over port 443"; flow:to_server,established; tls.sni; content:!""; threshold:type threshold, track by_src, count 5, seconds 300; metadata: author detections.ai, attack_id T1572, attack_id T1071.001, attack_id T1036.005, malware BridgeAgent, note "pair with EDR detection of process masquerading as /usr/bin/gnome-shell running as root and persisted via zabbix_agent.service"; classtype:trojan-activity; sid:1000201; rev:1;)