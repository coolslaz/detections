// Detects bulk-pull activity against a container registry consistent with mass image harvesting
// for embedded credentials, configs, and internal source code (T1552.001, T1610)
AzureActivity
| where ResourceProvider =~ "MICROSOFT.CONTAINERREGISTRY"
| where OperationName in ("Pull", "GetManifest", "GetBlob")
| extend CallerIdentity = Caller, CallerIpAddress = CallerIpAddress, RepoName = tostring(parse_json(Properties).resource)
// Exclude well-known cluster system identities and CI/CD build-agent service principals
| where not(CallerIdentity has_any ("aks-system", "aks-cluster-identity", "system:serviceaccount", "build-agent", "ci-pipeline", "azuredevops", "github-actions"))
| summarize DistinctImagesPulled = dcount(RepoName), TotalPulls = count(), Repos = make_set(RepoName, 50) by CallerIdentity, CallerIpAddress, ResourceId, TimeGenerated = bin(TimeGenerated, 1h)
| where DistinctImagesPulled >= 30 and TotalPulls >= 150
| project TimeGenerated, CallerIdentity, CallerIpAddress, ResourceId, DistinctImagesPulled, TotalPulls, Repos
| sort by DistinctImagesPulled desc