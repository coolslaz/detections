AzureActivity
| where TimeGenerated > ago(1h)
| where OperationNameValue has_any (
    "MICROSOFT.CONTAINERSERVICE/MANAGEDCLUSTERS/SECRETS",
    "MICROSOFT.CONTAINERSERVICE/MANAGEDCLUSTERS/LISTCLUSTERUSERCREDENTIAL",
    "MICROSOFT.CONTAINERSERVICE/MANAGEDCLUSTERS/LISTCLUSTERADMINCREDENTIAL",
    "MICROSOFT.RECOVERYSERVICES/VAULTS/BACKUPFABRICS/PROTECTIONCONTAINERS/PROTECTEDITEMS/RECOVERYPOINTS",
    "MICROSOFT.RECOVERYSERVICES/VAULTS/BACKUPJOBS",
    "MICROSOFT.RECOVERYSERVICES/VAULTS/BACKUPRESTORE",
    "MICROSOFT.KEYVAULT/VAULTS/SECRETS/LIST",
    "MICROSOFT.DATAFACTORY/FACTORIES/LINKEDSERVICES",
    "MICROSOFT.WEB/CONNECTIONS"
)
| extend Caller = tostring(Caller), Op = tostring(OperationNameValue), Res = tostring(ResourceId)
| extend SystemCategory = case(
    Op has_any ("MICROSOFT.CONTAINERSERVICE/MANAGEDCLUSTERS/SECRETS", "MICROSOFT.CONTAINERSERVICE/MANAGEDCLUSTERS/LISTCLUSTERUSERCREDENTIAL", "MICROSOFT.CONTAINERSERVICE/MANAGEDCLUSTERS/LISTCLUSTERADMINCREDENTIAL"), "K8s",
    Op has_any ("MICROSOFT.RECOVERYSERVICES/VAULTS/BACKUPFABRICS/PROTECTIONCONTAINERS/PROTECTEDITEMS/RECOVERYPOINTS", "MICROSOFT.RECOVERYSERVICES/VAULTS/BACKUPJOBS", "MICROSOFT.RECOVERYSERVICES/VAULTS/BACKUPRESTORE"), "BackupVault",
    Op has_any ("MICROSOFT.KEYVAULT/VAULTS/SECRETS/LIST"), "KeyVault",
    Op has_any ("MICROSOFT.DATAFACTORY/FACTORIES/LINKEDSERVICES", "MICROSOFT.WEB/CONNECTIONS"), "ConnectorRegistry",
    "Other"
)
| summarize
    OperationCount = count(),
    DistinctResources = dcount(Res),
    DistinctOperationTypes = dcount(Op),
    DistinctSystemCategories = dcount(SystemCategory),
    Operations = make_set(Op, 20),
    Resources = make_set(Res, 20),
    SystemCategories = make_set(SystemCategory, 10),
    TimeGenerated = arg_max(TimeGenerated, *)
    by Caller, CallerIpAddress, bin(TimeGenerated, 1h)
| where OperationCount >= 40 and DistinctResources >= 10 and DistinctOperationTypes >= 3 and DistinctSystemCategories >= 3
| project TimeGenerated, Caller, CallerIpAddress, OperationCount, DistinctResources, DistinctOperationTypes, DistinctSystemCategories, SystemCategories, Operations, Resources
| sort by OperationCount desc