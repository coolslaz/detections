// Detects volume-anomalous access to WSO2 API Manager Store/Publisher endpoints exposing consumer key/secret pairs, using bearer tokens whose JWT header matches the forged alg=none / unsupported-algorithm pattern from CVE-2026-5430 exploitation
let lookback = 14d;
let recent = 1d;
let AutomationSignatures = dynamic(["Jenkins","GitLab-CI","GitHub-Actions","Postman","Selenium","Nagios","Zabbix","Datadog","Prometheus","UptimeRobot"]);
let RawEvents = CommonSecurityLog
| where DeviceVendor has "WSO2" or Message has "WSO2" or DeviceProduct has_any ("API Manager", "API-M", "Traffic Manager")
| where RequestURL has_any ("/keys", "/oauth-keys", "/generate-keys", "consumer-key", "consumer-secret", "/applications") or Message has_any ("consumer-key", "consumer-secret", "applications")
| extend AuthorizationHeader = extract(@"Bearer\s+([A-Za-z0-9\-_\.]+)", 1, Message)
| where isnotempty(AuthorizationHeader)
| extend JwtParts = split(AuthorizationHeader, ".")
| where array_length(JwtParts) >= 2
| extend JwtHeaderDecoded = tostring(base64_decode_tostring(tostring(JwtParts[0])))
| where JwtHeaderDecoded has_any ("\"alg\":\"none\"", "\"alg\": \"none\"", "\"alg\":\"None\"", "'alg':'none'") or not(JwtHeaderDecoded has_any ("RS256", "HS256", "PS256", "ES256"))
| extend ResponseCode = toint(extract(@"(?:status|responseCode|sc)[=:]\s*(\d{3})", 1, Message))
| where ResponseCode between (200 .. 299)
| where not(Message has_any (AutomationSignatures))
;
let Baseline = RawEvents
| where TimeGenerated between (ago(lookback) .. ago(recent))
| summarize BaselineDaily = count() by SourceIP, DestinationHostName, bin(TimeGenerated, 1d)
| summarize BaselineP95 = percentile(BaselineDaily, 95) by SourceIP, DestinationHostName
;
let Current = RawEvents
| where TimeGenerated > ago(recent)
| summarize
    RequestCount = count(),
    DistinctEndpoints = dcount(RequestURL),
    Endpoints = make_set(RequestURL, 20),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by SourceIP, DestinationHostName
;
Current
| join kind=leftouter (Baseline) on SourceIP, DestinationHostName
| extend BaselineP95 = coalesce(BaselineP95, 0.0)
| extend Threshold = iff(BaselineP95 > 0.0, BaselineP95 * 2, 10.0)
| where RequestCount > Threshold and DistinctEndpoints >= 5
| project FirstSeen, LastSeen, SourceIP, DestinationHostName, RequestCount, DistinctEndpoints, BaselineP95, Threshold, Endpoints
| sort by RequestCount desc