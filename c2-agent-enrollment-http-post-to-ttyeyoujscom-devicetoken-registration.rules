alert http $HOME_NET any -> $EXTERNAL_NET 8443 (msg:"C2 Agent Enrollment HTTP POST to tt.yeyoujs.com (device/token registration)"; flow:to_server,established; http.method; content:"POST"; http.host; content:"tt.yeyoujs.com"; nocase; endswith; http.uri; content:"/api/agent/enroll"; nocase; startswith; fast_pattern; http.user_agent; content:"Python/3.10 aiohttp/3.14.1"; metadata: author Arnold Chan, created_at 2025-01-01, mitre_tactic_id TA0011, mitre_technique_id T1071.001, mitre_technique_id T1102; classtype:command-and-control; sid:1000101; rev:1;)