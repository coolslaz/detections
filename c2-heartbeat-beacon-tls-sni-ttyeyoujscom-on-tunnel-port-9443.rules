alert tls $HOME_NET any -> $EXTERNAL_NET 9443 (msg:"C2 heartbeat beacon TLS SNI tt.yeyoujs.com on tunnel port 9443"; flow:to_server,established; tls.sni; content:"tt.yeyoujs.com"; nocase; fast_pattern; threshold:type threshold, track by_src, count 3, seconds 600; metadata: attack_id T1071.001, attack_id T1029, author Arnold Chan; classtype:command-and-control; sid:1000201; rev:1;)

alert dns $HOME_NET any -> any any (msg:"DNS query for C2 tunnel host tt.yeyoujs.com (heartbeat beacon)"; dns.query; content:"tt.yeyoujs.com"; nocase; fast_pattern; threshold:type limit, track by_src, count 1, seconds 170; metadata: attack_id T1071.001, attack_id T1029; classtype:command-and-control; sid:1000202; rev:1;)