alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Casbaneiro: C2 Malformed HTTP GET /$p Beacon"; flow:to_server,established; http.method; content:"GET"; http.uri; content:"/$p"; startswith; http.header_names; content:"Content-Length"; flow:to_server; metadata: attack_id T1071.001, attack_id T1001, author Arnold Chan; classtype:trojan-activity; reference:url,https://attack.mitre.org/software/S0455/; sid:1000001; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Casbaneiro C2 Malformed HTTP POST /$or Beacon"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/$or?u="; startswith; metadata: attack_id T1071.001, attack_id T1001; classtype:trojan-activity; sid:1000002; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Casbaneiro C2 Malformed HTTP POST Missing Host Header with Anomalous Content-Length"; flow:to_server,established; http.method; content:"POST"; http.header_names; content:!"Host"; nocase; http.header; content:"Content-Length"; pcre:"/Content-Length\x3a\s*\d{8,}/i"; classtype:trojan-activity; metadata: attack_id T1071.001, attack_id T1001; sid:1000003; rev:2;)