alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Casbaneiro Geofenced Lure Page Redirects Non-Targeted IP to Google/YouTube Root"; flow:from_server,established; http.stat_code; content:"302"; http.location; content:"http"; fast_pattern; pcre:"/^https?:\/\/(www\.)?(google|youtube)\.com\/?$/i"; http.host; content:!"google"; nocase; content:!"youtube"; nocase; content:!"doubleclick"; nocase; content:!"googlesyndication"; nocase; content:!"googleadservices"; nocase; content:!"bit.ly"; nocase; classtype:bad-unknown; metadata: author Arnold Chan, created_at 2026-08-18, mitre_technique_id T1027, mitre_technique_id T1497, malware Casbaneiro, malware Ousaban; sid:1000101; rev:2;)