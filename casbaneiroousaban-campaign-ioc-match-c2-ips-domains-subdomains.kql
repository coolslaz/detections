// Branch 1: known C2 IP addresses seen in network connections
let IPMatches = DeviceNetworkEvents
| where RemoteIP in (KnownC2IPs)
| extend IOCType = "C2_IP", IOCValue = RemoteIP, MatchedField = "RemoteIP"
| project TimeGenerated, DeviceId, DeviceName, IOCType, IOCValue, MatchedField, RemoteUrl, RemotePort, InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId;
// Branch 2: known C2/exfil domains and distributed data-receiving subdomains, matched on the exact parsed hostname (not a substring of the whole URL, which risks matching unrelated paths/query strings)
let DomainNetworkMatches = DeviceNetworkEvents
| where isnotempty(RemoteUrl)
| extend ParsedHost = tostring(parse_url(RemoteUrl).Host)
| where ParsedHost in~ (KnownC2Domains)
| extend IOCType = "C2_Domain", IOCValue = ParsedHost, MatchedField = "RemoteUrl_Host"
| project TimeGenerated, DeviceId, DeviceName, IOCType, IOCValue, MatchedField, RemoteUrl, RemotePort, InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId;
// Branch 3: known C2/exfil domains and subdomains seen in DNS query events, matched on the exact query name
let DomainDNSMatches = DeviceEvents
| where ActionType in ("DnsQueryResponse", "DnsQuery")
| extend QueryName = tostring(parse_json(AdditionalFields).QueryName)
| where QueryName in~ (KnownC2Domains)
| extend IOCType = "C2_Domain_DNS", IOCValue = QueryName, MatchedField = "DNS_QueryName"
| project TimeGenerated, DeviceId, DeviceName, IOCType, IOCValue, MatchedField, QueryName, InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId;
// Branch 4: known malicious file hashes (PDF lures, HTA downloaders, AutoIt scripts, Casbaneiro payload) observed on disk
let FileHashMatches = DeviceFileEvents
| where SHA256 in~ (KnownMaliciousHashes)
| extend IOCType = "Known_Malicious_Hash", IOCValue = SHA256, MatchedField = "DeviceFileEvents_SHA256"
| project TimeGenerated, DeviceId, DeviceName, IOCType, IOCValue, MatchedField, FileName, FolderPath, InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId;
// Branch 5: known malicious file hashes observed executing as a process
let ProcessHashMatches = DeviceProcessEvents
| where SHA256 in~ (KnownMaliciousHashes)
| extend IOCType = "Known_Malicious_Hash", IOCValue = SHA256, MatchedField = "DeviceProcessEvents_SHA256"
| project TimeGenerated, DeviceId, DeviceName, IOCType, IOCValue, MatchedField, FileName, FolderPath, InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId;
IPMatches
| union DomainNetworkMatches
| union DomainDNSMatches
| union FileHashMatches
| union ProcessHashMatches
| sort by TimeGenerated desc