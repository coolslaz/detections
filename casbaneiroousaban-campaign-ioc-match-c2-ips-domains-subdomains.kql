// Casbaneiro/Ousaban known C2 infrastructure IOC detection across endpoint telemetry
// Union of IP-based and domain/subdomain-based indicator matches
let KnownC2IPs = dynamic(["72.167.48.63", "209.99.188.28"]);
let KnownC2Domains = dynamic([
    "gexwalltool.com",
    "x-wolverine.servebbs.com",
    "128.200.178.68.host.secureserver.net",
    "13.189.202.64.host.secureserver.net",
