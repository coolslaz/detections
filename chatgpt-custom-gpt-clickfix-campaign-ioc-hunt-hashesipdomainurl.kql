let malicious_hashes = dynamic([
 "14e3376befd4b7b52de0757b6264da294ac6b0f9e4ff51cb9bc5b19b243fe335",
 "c4603646701069ebdeabc96f74e1f947355ace8575560986d8393fcc6b88d0b7",
 "6761aad48a3f987238994d92bca97e4b8550e0150607bd67b47b1b6366a371fc",
 "e58831766e8d4313db9f8b85f90c3a840aa0d84cfeac285beefa40e39ad0d1fb",
 "b77575413c0f97eaf31e4a44c884c1ecdc0049ec89916ceb0bf3aaaedc0442fe",
 "eff5d63ddf1813962f0d8ad1250cea5486c8bb5dd27c3f432b43957a33e43764",
 "9c615db040b88c18ce6b96f30d08797045b7d506f940bea452dc7a6992fdbb8d",
 "54c94f85ba6e950903d5ff42c0971c5a9d0741596be26e06afe7d60ec38edf31",
 "e614b7d5a7a363fb1b355a87e2e8d9e8a05bbbca08f2cee3d606bdb5015ac53b",
 "20c7befc174a61117770535e809046c75e93c71284bf1a9c6cd532f55b315f53",
 "ab65bbfc505dbe1cebe6021fb36e2011f6aa1d64f5d87cee1cbee3fc2a0c7907",
 "278e2f3e2f26c18666b89ef774b4af9ce954e36b2bf54a2392608619245d8c48"
]);
let malicious_ips = dynamic(["96.62.224.81", "45.140.205.28"]);
let malicious_domains = dynamic(["chattypetty.com"]);
let malicious_urls = dynamic([
 "https://sites.google.com/view/antibot172881",
 "http://96.62.224.81/app/afafa98279c9/ISOSimple.msi",
 "http://96.62.224.81/s/50d6565cf39e",
 "http://96.62.224.81/app/50d6565cf39e/IconEdit2Turb.msi",
 "http://96.62.224.81/app/a26b67343315/UltraFreeISOCreateWizardSolution.msi"
]);
let hash_hits =
 union DeviceFileEvents, DeviceProcessEvents
 | where SHA256 in (malicious_hashes) or (isnotempty(column_ifexists("InitiatingProcessSHA256", "")) and InitiatingProcessSHA256 in (malicious_hashes))
 | extend MatchType = "FileHash", MatchedValue = SHA256
 | project Timestamp, DeviceName, MatchType, MatchedValue, FileName = column_ifexists("FileName", ""), ProcessCommandLine = column_ifexists("ProcessCommandLine", "");
let network_hits =
 DeviceNetworkEvents
 | where RemoteIP in (malicious_ips)
 | extend MatchType = "RemoteIP", MatchedValue = RemoteIP
 | project Timestamp, DeviceName, MatchType, MatchedValue, FileName = InitiatingProcessFileName, ProcessCommandLine = InitiatingProcessCommandLine;
let dns_hits =
 DeviceNetworkEvents
 | where RemoteUrl has_any (malicious_domains)
 | extend MatchType = "DNS/Domain", MatchedValue = RemoteUrl
 | project Timestamp, DeviceName, MatchType, MatchedValue, FileName = InitiatingProcessFileName, ProcessCommandLine = InitiatingProcessCommandLine;
let url_hits =
 union DeviceNetworkEvents, DeviceEvents
 | where isnotempty(column_ifexists("RemoteUrl", "")) and RemoteUrl in (malicious_urls)
 | extend MatchType = "URL", MatchedValue = RemoteUrl
 | project Timestamp, DeviceName, MatchType, MatchedValue, FileName = column_ifexists("InitiatingProcessFileName", ""), ProcessCommandLine = column_ifexists("InitiatingProcessCommandLine", "");
union hash_hits, network_hits, dns_hits, url_hits
| sort by Timestamp desc