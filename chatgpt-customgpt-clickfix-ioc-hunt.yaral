rule chatgpt_customgpt_clickfix_ioc_hunt {
  meta:
    author = "Arnold Chan"
    description = "Detects indicators associated with the ChatGPT Custom GPT ClickFix campaign across process, network connection, DNS, and HTTP telemetry: known malicious file hashes, C2 IP addresses, the chattypetty.com domain, and known payload-hosting URLs."
    severity = "Medium"
    reference = "https://www.huntress.com/blog/chatgpt-custom-gpts-clickfix-rat"
    tags = "yara-l"
    false_positive1 = "Security tools or scanners re-analyzing the same malicious files within the environment"
    false_positive2 = "Users legitimately accessing public cloud storage if those URLs were previously associated with malicious content but repurposed"
    false_positive3 = "Direct network connections to infrastructure that has been re-provisioned for legitimate services after being used as C2"
events:
    $hash.metadata.event_type = "PROCESS_LAUNCH"
    (
      $hash.target.process.file.sha256 = "14e3376befd4b7b52de0757b6264da294ac6b0f9e4ff51cb9bc5b19b243fe335" or
      $hash.target.process.file.sha256 = "c4603646701069ebdeabc96f74e1f947355ace8575560986d8393fcc6b88d0b7" or
      $hash.target.process.file.sha256 = "6761aad48a3f987238994d92bca97e4b8550e0150607bd67b47b1b6366a371fc" or
      $hash.target.process.file.sha256 = "e58831766e8d4313db9f8b85f90c3a840aa0d84cfeac285beefa40e39ad0d1fb" or
      $hash.target.process.file.sha256 = "b77575413c0f97eaf31e4a44c884c1ecdc0049ec89916ceb0bf3aaaedc0442fe" or
      $hash.target.process.file.sha256 = "eff5d63ddf1813962f0d8ad1250cea5486c8bb5dd27c3f432b43957a33e43764" or
      $hash.target.process.file.sha256 = "9c615db040b88c18ce6b96f30d08797045b7d506f940bea452dc7a6992fdbb8d" or
      $hash.target.process.file.sha256 = "54c94f85ba6e950903d5ff42c0971c5a9d0741596be26e06afe7d60ec38edf31" or
      $hash.target.process.file.sha256 = "e614b7d5a7a363fb1b355a87e2e8d9e8a05bbbca08f2cee3d606bdb5015ac53b" or
      $hash.target.process.file.sha256 = "20c7befc174a61117770535e809046c75e93c71284bf1a9c6cd532f55b315f53" or
      $hash.target.process.file.sha256 = "ab65bbfc505dbe1cebe6021fb36e2011f6aa1d64f5d87cee1cbee3fc2a0c7907" or
      $hash.target.process.file.sha256 = "278e2f3e2f26c18666b89ef774b4af9ce954e36b2bf54a2392608619245d8c48" or
      $hash.principal.process.file.sha256 = "14e3376befd4b7b52de0757b6264da294ac6b0f9e4ff51cb9bc5b19b243fe335" or
      $hash.principal.process.file.sha256 = "c4603646701069ebdeabc96f74e1f947355ace8575560986d8393fcc6b88d0b7" or
      $hash.principal.process.file.sha256 = "6761aad48a3f987238994d92bca97e4b8550e0150607bd67b47b1b6366a371fc" or
      $hash.principal.process.file.sha256 = "e58831766e8d4313db9f8b85f90c3a840aa0d84cfeac285beefa40e39ad0d1fb" or
      $hash.principal.process.file.sha256 = "b77575413c0f97eaf31e4a44c884c1ecdc0049ec89916ceb0bf3aaaedc0442fe" or
      $hash.principal.process.file.sha256 = "eff5d63ddf1813962f0d8ad1250cea5486c8bb5dd27c3f432b43957a33e43764" or
      $hash.principal.process.file.sha256 = "9c615db040b88c18ce6b96f30d08797045b7d506f940bea452dc7a6992fdbb8d" or
      $hash.principal.process.file.sha256 = "54c94f85ba6e950903d5ff42c0971c5a9d0741596be26e06afe7d60ec38edf31" or
      $hash.principal.process.file.sha256 = "e614b7d5a7a363fb1b355a87e2e8d9e8a05bbbca08f2cee3d606bdb5015ac53b" or
      $hash.principal.process.file.sha256 = "20c7befc174a61117770535e809046c75e93c71284bf1a9c6cd532f55b315f53" or
      $hash.principal.process.file.sha256 = "ab65bbfc505dbe1cebe6021fb36e2011f6aa1d64f5d87cee1cbee3fc2a0c7907" or
      $hash.principal.process.file.sha256 = "278e2f3e2f26c18666b89ef774b4af9ce954e36b2bf54a2392608619245d8c48"
    )

    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.network.direction = "OUTBOUND"
    ($conn.target.ip = "96.62.224.81" or $conn.target.ip = "45.140.205.28")

    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = "chattypetty.com"

    $http.metadata.event_type = "NETWORK_HTTP"
    (
      $http.target.url = "https://sites.google.com/view/antibot172881" or
      $http.target.url = "http://96.62.224.81/app/afafa98279c9/ISOSimple.msi" or
      $http.target.url = "http://96.62.224.81/s/50d6565cf39e" or
      $http.target.url = "http://96.62.224.81/app/50d6565cf39e/IconEdit2Turb.msi" or
      $http.target.url = "http://96.62.224.81/app/a26b67343315/UltraFreeISOCreateWizardSolution.msi"
    )

  outcome:
    $risk_score = 65

  condition:
    $hash or $conn or $dns or $http
}