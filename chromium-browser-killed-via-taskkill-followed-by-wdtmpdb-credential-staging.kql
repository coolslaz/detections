// Detects the Lunex Chromium credential-theft sequence: process termination of a Chromium browser
// via taskkill, followed shortly after by creation of a wd_tmp.db staging file used to copy
// Login Data/Cookies/Web Data before parsing and exfiltration.
let browserKill = DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where FileName =~ "taskkill.exe"
| where ProcessCommandLine has "/F" and ProcessCommandLine has "/IM" and ProcessCommandLine has "/T"
| where ProcessCommandLine has_any ("chrome.exe", "msedge.exe", "brave.exe", "browser.exe", "opera.exe", "launcher.exe", "vivaldi.exe")
| project KillTime = TimeGenerated, DeviceId, ProcessCommandLine, InitiatingProcessAccountName;
let wdTmpCreation = DeviceFileEvents
| where TimeGenerated > ago(1d)
| where FileName =~ "wd_tmp.db"
| where FolderPath has_any (@"\Google\Chrome\User Data", @"\Microsoft\Edge\User Data", @"\BraveSoftware\", @"\Opera Software\", @"\Vivaldi\", @"\Yandex\")
| project FileTime = TimeGenerated, DeviceId, FolderPath, FileName, InitiatingProcessFileName;
browserKill
| join kind=inner (wdTmpCreation) on DeviceId
| where FileTime between (KillTime .. (KillTime + 10m))
| project KillTime, FileTime, DeviceId, ProcessCommandLine, FolderPath, FileName, InitiatingProcessFileName, InitiatingProcessAccountName