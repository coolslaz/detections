DeviceFileEvents
| where TimeGenerated > ago(1d)
| where FileName in~ ("Login Data", "Cookies")
| where FolderPath has_any (@"\Google\Chrome\User Data\Default", @"\Microsoft\Edge\User Data\Default\Network")
| where (FolderPath has "Login Data" and FileName =~ "Login Data") or (FolderPath has @"\Network" and FileName =~ "Cookies")
| where InitiatingProcessFileName !in~ ("chrome.exe", "msedge.exe", "GoogleUpdate.exe", "MicrosoftEdgeUpdate.exe")
| where ActionType in ("FileModified", "FileCreated", "FileRenamed")
| join kind=inner (DeviceProcessEvents | project DeviceId, InitiatingProcessId, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, InitiatingProcessSignatureStatus, InitiatingProcessSignerType) on DeviceId, InitiatingProcessId
| where InitiatingProcessSignatureStatus != "Valid" or InitiatingProcessFolderPath has_any (@"\AppData\Local\Temp", @"\AppData\Roaming", @"\Temp\", @"\Users\Public")
| where not(InitiatingProcessSignerType in~ ("Microsoft", "WindowsStore"))
| project TimeGenerated, DeviceId, DeviceName, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, InitiatingProcessId, InitiatingProcessSignatureStatus, InitiatingProcessSignerType, FileName, FolderPath, ActionType
| sort by TimeGenerated desc