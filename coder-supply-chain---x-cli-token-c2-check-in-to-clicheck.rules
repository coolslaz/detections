alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Coder Supply Chain - X-CLI-Token C2 check-in to /cli/check"; flow:to_server,established; http.uri; content:"/cli/check"; http.header_names; content:"X-CLI-Token"; http.header; content:"X-CLI-Token|3A| your-secret-token"; fast_pattern; metadata: author Arnold Chan, created_at 2026-08-31, mitre_technique_id T1071.001; classtype:trojan-activity; sid:1000201; rev:1;)