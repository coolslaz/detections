// Detects the PREY-0058/UNC6671 pattern: IT help-desk impersonation vishing leads to a password reset
// followed shortly after by MFA device re-registration for the same user, without prior verification
let timeWindow = 30m;
let ResetEvents = AuditLogs
| where ActivityDisplayName in ("Reset password (by admin)", "Reset password (self-service)", "Change password (self-service)", "Update user")
| where Result == "success"
| extend TargetUser = tostring(TargetResources[0].userPrincipalName)
| extend ResetInitiatedBy = tostring(InitiatedBy.user.userPrincipalName)
// Tightened: only resets initiated by someone OTHER than the target account (admin/help-desk-initiated,
// matching the vishing pretext) - excludes routine self-service password resets/changes.
| where isnotempty(ResetInitiatedBy) and ResetInitiatedBy != TargetUser
| project ResetTime = TimeGenerated, TargetUser, ResetActivity = ActivityDisplayName, ResetInitiatedBy;
let MfaRegEvents = AuditLogs
| where ActivityDisplayName in ("User registered security info", "Register security information", "Update user") or ActivityDisplayName has "MFA"
| extend TargetUser = tostring(TargetResources[0].userPrincipalName)
| project MfaTime = TimeGenerated, TargetUser, MfaActivity = ActivityDisplayName;
ResetEvents
| join kind=inner (MfaRegEvents) on TargetUser
| where MfaTime between (ResetTime .. (ResetTime + timeWindow))
| project ResetTime, TargetUser, ResetActivity, ResetInitiatedBy, MfaTime, MfaActivity
| sort by ResetTime desc