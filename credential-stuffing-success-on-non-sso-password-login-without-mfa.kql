// Detects credential-stuffing pattern: a burst of failed password authentications from
// multiple source IPs against an account, followed by a successful login that used
// single-factor (password-only) authentication outside MFA/SSO coverage. Tightened:
// window shrunk from 2h to 30m and thresholds raised so a user mistyping a password
// across a couple of home/mobile networks doesn't match, and the successful login's
// IP must overlap the set of IPs that produced failures -- tying the eventual success
// to the same rotating attacker pool rather than the user's own legitimate device.
SigninLogs
| where TimeGenerated > ago(30m)
| where AuthenticationRequirement == "singleFactorAuthentication"
| where isnotempty(UserPrincipalName)
| summarize FailedAttempts = countif(ResultType != "0"),
            SuccessCount = countif(ResultType == "0"),
            FailIPs = make_set_if(IPAddress, ResultType != "0", 20),
            DistinctFailIPs = dcountif(IPAddress, ResultType != "0"),
            DistinctApps = dcount(AppDisplayName),
            LastSuccessTime = maxif(TimeGenerated, ResultType == "0"),
            SuccessIPs = make_set_if(IPAddress, ResultType == "0", 10)
          by UserPrincipalName
| where FailedAttempts >= 8 and DistinctFailIPs >= 5 and SuccessCount >= 1
| where isnotnull(LastSuccessTime)
| where array_length(set_intersect(FailIPs, SuccessIPs)) > 0
| project UserPrincipalName, FailedAttempts, DistinctFailIPs, SuccessCount, DistinctApps, LastSuccessTime, FailIPs, SuccessIPs
| order by FailedAttempts desc