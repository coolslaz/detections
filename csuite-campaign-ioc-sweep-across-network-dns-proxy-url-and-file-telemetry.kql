let DeviceNetBase = DeviceNetworkEvents
| where TimeGenerated > ago(1d)
| extend Host = tostring(parse_url(RemoteUrl).Host)
| extend HostForMatch = iff(isempty(Host), tostring(RemoteUrl), Host);
let DeviceNetIpUrl = DeviceNetBase
| where RemoteIP in (csuite_ips) or RemoteUrl in (csuite_urls)
| extend MatchType = iff(RemoteIP in (csuite_ips), "IP", "URL")
| project TimeGenerated, SourceTable = "DeviceNetworkEvents", MatchType, MatchedValue = coalesce(RemoteIP, RemoteUrl), DeviceName, AccountName = InitiatingProcessAccountName, ProcessName = InitiatingProcessFileName;
let DeviceNetDomain = DeviceNetBase
| mv-expand Domain = csuite_domains to typeof(string)
| where HostForMatch == Domain or HostForMatch endswith strcat(".", Domain)
| extend MatchType = "Domain"
| project TimeGenerated, SourceTable = "DeviceNetworkEvents", MatchType, MatchedValue = HostForMatch, DeviceName, AccountName = InitiatingProcessAccountName, ProcessName = InitiatingProcessFileName;
let DeviceNet = union DeviceNetIpUrl, DeviceNetDomain;
let DnsBase = DnsEvents
| where TimeGenerated > ago(1d);
let DnsEv = DnsBase
| mv-expand Domain = csuite_domains to typeof(string)
| where Name == Domain or Name endswith strcat(".", Domain)
| extend MatchType = "Domain"
| project TimeGenerated, SourceTable = "DnsEvents", MatchType, MatchedValue = Name, DeviceName = Computer, AccountName = "", ProcessName = "";
let CSLBase = CommonSecurityLog
| where TimeGenerated > ago(1d)
| extend Host = tostring(parse_url(RequestURL).Host);
let CSLIpUrl = CSLBase
| where DestinationIP in (csuite_ips) or RequestURL in (csuite_urls)
| extend MatchType = iff(DestinationIP in (csuite_ips), "IP", "URL")
| project TimeGenerated, SourceTable = "CommonSecurityLog", MatchType, MatchedValue = coalesce(DestinationIP, RequestURL), DeviceName, AccountName = SourceUserName, ProcessName = "";
let CSLDomain = CSLBase
| mv-expand Domain = csuite_domains to typeof(string)
| where Host == Domain or Host endswith strcat(".", Domain)
| extend MatchType = "Domain"
| project TimeGenerated, SourceTable = "CommonSecurityLog", MatchType, MatchedValue = Host, DeviceName, AccountName = SourceUserName, ProcessName = "";
let CSL = union CSLIpUrl, CSLDomain;
let EmailUrlBase = EmailUrlInfo
| where TimeGenerated > ago(1d)
| extend Host = tostring(parse_url(Url).Host);
let EmailUrlExact = EmailUrlBase
| where Url in (csuite_urls)
| extend MatchType = "URL"
| project TimeGenerated, SourceTable = "EmailUrlInfo", MatchType, MatchedValue = Url, DeviceName = "", AccountName = "", ProcessName = "";
let EmailUrlDomain = EmailUrlBase
| mv-expand Domain = csuite_domains to typeof(string)
| where Host == Domain or Host endswith strcat(".", Domain)
| extend MatchType = "Domain"
| project TimeGenerated, SourceTable = "EmailUrlInfo", MatchType, MatchedValue = Url, DeviceName = "", AccountName = "", ProcessName = "";
let EmailUrl = union EmailUrlExact, EmailUrlDomain;
let UrlClickBase = UrlClickEvents
| where TimeGenerated > ago(1d)
| extend Host = tostring(parse_url(Url).Host);
let UrlClickExact = UrlClickBase
| where Url in (csuite_urls)
| extend MatchType = "URL"
| project TimeGenerated, SourceTable = "UrlClickEvents", MatchType, MatchedValue = Url, DeviceName = "", AccountName = AccountUpn, ProcessName = "";
let UrlClickDomain = UrlClickBase
| mv-expand Domain = csuite_domains to typeof(string)
| where Host == Domain or Host endswith strcat(".", Domain)
| extend MatchType = "Domain"
| project TimeGenerated, SourceTable = "UrlClickEvents", MatchType, MatchedValue = Url, DeviceName = "", AccountName = AccountUpn, ProcessName = "";
let UrlClick = union UrlClickExact, UrlClickDomain;
let DeviceFileHash = DeviceFileEvents
| where Timestamp > ago(1d)
| where SHA256 in (csuite_hashes)
| extend MatchType = "Hash"
| project TimeGenerated = Timestamp, SourceTable = "DeviceFileEvents", MatchType, MatchedValue = SHA256, DeviceName, AccountName = InitiatingProcessAccountName, ProcessName = FileName;
union DeviceNet, DnsEv, CSL, EmailUrl, UrlClick, DeviceFileHash
| summarize arg_max(TimeGenerated, *) by SourceTable, MatchedValue, DeviceName, AccountName
| sort by TimeGenerated desc