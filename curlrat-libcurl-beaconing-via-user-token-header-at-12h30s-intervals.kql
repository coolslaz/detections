let lookback = 7d;
// WARNING: HttpEvents table not found in standard schema; defaulting to DeviceNetworkEvents based on context
DeviceNetworkEvents
| where TimeGenerated > ago(lookback)
| extend AdditionalFields = parse_json(AdditionalFields)
| extend RequestHeaders = tostring(AdditionalFields.RequestHeaders), RequestMethod = tostring(AdditionalFields.RequestMethod), RequestBody = tostring(AdditionalFields.RequestBody), RequestUrl = tostring(AdditionalFields.RequestUrl)
| where RequestHeaders has "User-token"
| where RequestMethod =~ "POST"
| where RequestBody has_all ("name=", "value=", "type=")
| sort by LocalIP, RemoteIP, TimeGenerated asc
| serialize
| extend PrevTime = prev(TimeGenerated), PrevSrc = prev(LocalIP), PrevDst = prev(RemoteIP)
| where LocalIP == PrevSrc and RemoteIP == PrevDst
| extend IntervalSeconds = datetime_diff('second', TimeGenerated, PrevTime)
// curlRAT default beacon interval is 43200s (12h); operator fast-poll flag drops it to 30s
| where IntervalSeconds between (15 .. 45) or IntervalSeconds between (42900 .. 43500)
| extend BeaconMode = iff(IntervalSeconds < 60, "fast-poll (30s)", "default (12h)")
| project TimeGenerated, LocalIP, RemoteIP, IntervalSeconds, BeaconMode, RequestUrl, RequestBody, RequestHeaders
| sort by TimeGenerated desc