alert dns $HOME_NET any -> any any (msg:"DNS query for ShipmentsFree scam domain network"; dns.query; content:"shipment"; nocase; pcre:"/^(free-?shipments|freeshpmts|myshipmentsfree|shipmentfree|shipmentsfree(club|zone)?)\.com$/i"; classtype:policy-violation; metadata: attack_id T1583.001, author Arnold Chan; threshold: type limit, track by_src, count 1, seconds 3600; reference:url,https://www.malwarebytes.com/blog/threat-intel/2026/09/that-shipping-rebate-offer-may-come-with-a-monthly-charge; sid:1000201; rev:2;)

alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"TLS SNI to ShipmentsFree scam domain network"; tls.sni; pcre:"/^(free-?shipments|freeshpmts|myshipmentsfree|shipmentfree|shipmentsfree(club|zone)?)\.com$/i"; classtype:policy-violation; metadata: attack_id T1583.001; threshold: type limit, track by_src, count 1, seconds 3600; sid:1000202; rev:2;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"HTTP request to ShipmentsFree scam login/account page"; flow:to_server,established; http.host; pcre:"/^(free-?shipments|freeshpmts|myshipmentsfree|shipmentfree|shipmentsfree(club|zone)?)\.com$/i"; http.uri; pcre:"/^\/account(\/|$|\?)/i"; classtype:policy-violation; metadata: attack_id T1583.001; threshold: type limit, track by_src, count 1, seconds 3600; sid:1000203; rev:2;)