alert smtp any any -> $HOME_NET any (msg:"DoppelBrand: BEC lookalike ServiceNow domain observed in MAIL FROM or Reply-To"; flow:to_server,established; content:"service-nowinc.com"; nocase; pcre:"/^(MAIL FROM|Reply-To)\s*:[^\r\n]*service-nowinc\.com/mi"; classtype:trojan-activity; metadata: author Arnold Chan, mitre_technique_id T1583.001, mitre_technique_id T1566.002, mitre_technique_id T1585.002; sid:1000101; rev:2;)

