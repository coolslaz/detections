alert dns $HOME_NET any -> any any (msg:"DoppelBrand campaign - DNS query for known IOC domain (service-nowinc.com/domainlify.net)"; dns.query; pcrexform:"/(.*)/"; pcre:"/(?:^|\.)(service-nowinc\.com|domainlify\.net)$/i"; metadata: author Arnold Chan, created_at 2026-08-06, mitre_technique_id T1583.001, mitre_technique_id2 T1585.002, campaign Operation_DoppelBrand; classtype:trojan-activity; sid:1000201; rev:2;)

alert smtp any any -> $HOME_NET any (msg:"DoppelBrand campaign - SMTP MAIL FROM matches known threat-actor address gomez@service-nowinc.com"; flow:to_server,established; content:"MAIL FROM|3a|"; fast_pattern; pcre:"/MAIL FROM:\s*<?gomez@service-nowinc\.com>?/i"; metadata: author detections.ai, created_at 2026-08-06, mitre_technique_id T1583.001, mitre_technique_id2 T1585.002, campaign Operation_DoppelBrand; classtype:trojan-activity; sid:1000202; rev:1;)

alert smtp any any -> $HOME_NET any (msg:"DoppelBrand campaign - SMTP Reply-To header matches known IOC domain domainlify.net"; flow:to_server,established; content:"Reply-To|3a|"; fast_pattern; content:"domainlify.net"; distance:0; within:100; metadata: author detections.ai, created_at 2026-08-06, mitre_technique_id T1585.002, campaign Operation_DoppelBrand; classtype:trojan-activity; sid:1000203; rev:1;)