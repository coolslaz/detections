alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"DoppelCart-style shared hosting - high volume of distinct .shop hostnames to same destination IP"; flow:to_server,established; http.method; content:"GET"; http.host; content:".shop"; endswith; nocase; threshold:type threshold, track by_dst, count 200, seconds 3600; metadata: author Arnold Chan, created_at 2026-09-01, mitre_technique_id T1584.004, mitre_technique_id T1583.001, mitre_technique_id T1583.003; classtype:bad-unknown; sid:1000201; rev:2;)