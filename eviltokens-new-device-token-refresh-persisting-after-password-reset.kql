// Detects EvilTokens-style persistence: stolen OAuth session tokens continuing
// to authenticate via silent/refresh-token exchanges AFTER a password reset,
// consistent with 'automatic token renewal' / 'session persistence after
// password change' advertised by the EvilTokens PhaaS platform.
// Tightened: excludes a short grace period post-reset (revocation propagation
// delay), requires the refreshing device/IP to be unrecognized (not seen
// pre-reset), and raises the refresh count threshold.
let GracePeriod = 10m;
let PasswordChanges = CloudAppEvents
| where ActionType in ("Change user password.", "Reset user password.")
| project ChangeTime = TimeGenerated, AccountObjectId, AccountDisplayName;
let PreResetKnown = EntraIdSignInEvents
| where TokenIssuerType == "AzureAD"
| join kind=inner (PasswordChanges) on AccountObjectId
| where Timestamp < ChangeTime and Timestamp > ChangeTime - 24h
| summarize KnownDevices = make_set(DeviceId, 1000), KnownIPs = make_set(IPAddress, 1000) by AccountObjectId, ChangeTime;
EntraIdSignInEvents
| where TokenIssuerType == "AzureAD"
| join kind=inner (PasswordChanges) on AccountObjectId
| where Timestamp > ChangeTime + GracePeriod and Timestamp < ChangeTime + 24h
| join kind=inner (PreResetKnown) on AccountObjectId, ChangeTime
| where not(DeviceId in (KnownDevices)) and not(IPAddress in (KnownIPs))
| summarize
    RefreshCount = count(),
    DistinctDevices = dcount(DeviceId),
    DistinctIPs = dcount(IPAddress),
    FirstPostResetSignIn = min(Timestamp),
    LastPostResetSignIn = max(Timestamp),
    Apps = make_set(ClientAppUsed, 10),
    Resources = make_set(ResourceDisplayName, 10)
    by AccountObjectId, AccountUpn, ChangeTime
| where RefreshCount >= 5
| project AccountUpn, ChangeTime, FirstPostResetSignIn, LastPostResetSignIn, RefreshCount, DistinctDevices, DistinctIPs, Apps, Resources
| sort by RefreshCount desc