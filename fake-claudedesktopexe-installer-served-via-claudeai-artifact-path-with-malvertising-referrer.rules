alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Fake ClaudeDesktop.exe installer served via claude.ai artifact path with malvertising referrer"; flow:from_server,established; http.host; content:"claude.ai"; http.uri; content:"/artifacts/"; nocase; http.uri; content:".exe"; endswith; http.uri; content:!"/download/desktop"; nocase; http.response_line; content:"200"; http.content_type; content:"application/octet-stream"; file.name; content:"ClaudeDesktop.exe"; nocase; fast_pattern; http.referer; content:!"claude.ai"; nocase; content:!"anthropic.com"; nocase; filesize:<5000000; metadata: attack_id T1189, attack_id T1204.002, attack_id T1583.001, author Arnold Chan; classtype:trojan-activity; sid:1000101; rev:2;)