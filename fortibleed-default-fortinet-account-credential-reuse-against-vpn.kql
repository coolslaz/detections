CommonSecurityLog
| where TimeGenerated > ago(1d)
| where DeviceVendor =~ "Fortinet"
| where DestinationPort in (443, 4443, 8443, 10443)
| where DestinationUserName has_any ("fgt-", "FortiManager-", "tech-support-")
| extend AccountPattern = case(
    DestinationUserName startswith "fgt-", "fgt-",
    DestinationUserName startswith "FortiManager-", "FortiManager-",
    DestinationUserName startswith "tech-support-", "tech-support-",
    "other"
  )
| extend IsSuccess = Activity has_any ("success", "login_success", "accept")
| summarize
    DistinctSourceIPs = dcount(SourceIP),
    DistinctAccounts = dcount(DestinationUserName),
    TotalAttempts = count(),
    SuccessCount = countif(IsSuccess),
    SuccessSourceIPs = dcountif(SourceIP, IsSuccess),
    FailureCount = countif(not(IsSuccess)),
    SourceIPList = make_set(SourceIP, 25),
    AccountList = make_set(DestinationUserName, 25)
    by DeviceVendor, DeviceProduct, DestinationHostName, DestinationIP, DestinationPort, AccountPattern, bin(TimeGenerated, 1h)
// Tightened: require BOTH source-IP and account diversity (not just one) to flag a true bulk-reuse pattern
// rather than a single busy admin/vendor account seen from a few IPs, or one account name tested by scanners.
| where DistinctSourceIPs >= 5 and DistinctAccounts >= 5
// Tightened: require at least one successful authentication from multiple distinct sources -- pure failed/
// scanning noise against default account names (extremely common on the open internet) no longer alone triggers.
| where SuccessCount > 0 and SuccessSourceIPs >= 2
| sort by TotalAttempts desc