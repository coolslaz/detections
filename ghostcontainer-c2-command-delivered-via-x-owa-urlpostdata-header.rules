alert http $EXTERNAL_NET any -> $HOME_NET [80,443] (msg:"GhostContainer C2 command delivered via x-owa-urlpostdata header"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/owa/"; nocase; http.header_names; content:"x-owa-urlpostdata"; nocase; http.header; content:"x-owa-urlpostdata|3a|"; nocase; pcre:"/x-owa-urlpostdata\x3a\s*[A-Za-z0-9+\/]{40,}={0,2}/i"; metadata: author Arnold Chan, created_at 2025-01-01, mitre_technique_id T1071.001, mitre_technique_id T1105; classtype:trojan-activity; sid:1000020; rev:2;)