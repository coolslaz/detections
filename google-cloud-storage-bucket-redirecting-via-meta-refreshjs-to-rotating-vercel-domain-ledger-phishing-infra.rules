alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Google Cloud Storage bucket redirecting via meta-refresh/JS to rotating Vercel domain (Ledger phishing infra)"; flow:from_server,established; http.host; content:"storage.googleapis.com"; nocase; http.uri; content:"leg"; nocase; http.response_body; content:".vercel.app"; nocase; fast_pattern; http.response_body; pcre:"/(?:http-equiv\s*=\s*[\x22\x27]?refresh[\x22\x27]?[^>]{0,120}url\s*=\s*[\x22\x27]?https?:\/\/[a-z0-9][a-z0-9-]*\.vercel\.app|location\.replace\(\s*[\x22\x27]https?:\/\/[a-z0-9][a-z0-9-]*\.vercel\.app)/i"; metadata: mitre_technique_id T1583.009, mitre_technique_id T1566.002, author Arnold Chan; classtype:web-application-attack; reference:url,https://threatlabz.zscaler.com/blogs/security-research/threat-actors-use-google-ads-target-ledger-users; sid:1000101; rev:2;)