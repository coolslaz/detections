alert http any any -> any any (msg:"Grafana MCP grafana_api_request SSRF - X-Grafana-URL targeting internal/link-local range"; flow:to_server,established; http.header_names; content:"X-Grafana-URL"; http.header; content:"X-Grafana-URL|3a|"; pcre:"/X-Grafana-URL\s*:\s*https?:\/\/(?!your-grafana-instance\.internal\b)(127\.|10\.|169\.254\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|localhost|metadata\.google\.internal)/i"; fast_pattern; metadata: author "detections.ai", created_at 2026-01-01, mitre_technique_id T1190, mitre_technique_id T1552.005, mitre_technique_id T1090, note "Replace the placeholder below with your actual configured Grafana instance host(s)/IP(s). Without this, this signature cannot distinguish a legitimately internally-hosted Grafana instance (a common, expected deployment) from an attacker directing grafana_api_request at OTHER internal/private destinations."; reference:url,https://grafana.com/blog/grafana-mcp-server-side-request-forgery-via-x-grafana-url-header; classtype:web-application-attack; sid:1000101; rev:2;)
alert http any any -> any any (msg:"Grafana MCP grafana_api_request SSRF - X-Grafana-URL targeting cloud metadata endpoint 169.254.169.254"; flow:to_server,established; http.header_names; content:"X-Grafana-URL"; http.header; content:"X-Grafana-URL|3a|"; content:"169.254.169.254"; fast_pattern; distance:0; metadata: author "detections.ai", created_at 2026-01-01, mitre_technique_id T1552.005, mitre_technique_id T1190; classtype:web-application-attack; sid:1000102; rev:1;)
alert http any any -> any any (msg:"Grafana MCP grafana_api_request tool invocation with non-GET method to internal/link-local host via X-Grafana-URL"; flow:to_server,established; http.request_body; content:"grafana_api_request"; http.header_names; content:"X-Grafana-URL"; http.header; pcre:"/X-Grafana-URL\s*:\s*https?:\/\/(?!your-grafana-instance\.internal\b)(127\.|10\.|169\.254\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|localhost|metadata\.google\.internal)/i"; http.method; content:!"GET"; metadata: author "detections.ai", created_at 2026-01-01, mitre_technique_id T1210, mitre_technique_id T1059, note "Non-GET method alone is normal, expected grafana_api_request usage (creating/updating dashboards, alerts, datasources against the real Grafana instance). Now requires the method AND destination together be internal/link-local/metadata -- i.e. an attacker actively mutating state via SSRF, not any legitimate write to the configured instance."; classtype:web-application-attack; sid:1000103; rev:2;)