// Detect the Grafana MCP server's configured service-account identity invoking the admin-capable grafana_api_request tool within a session that lacks confirmed prior authentication (no bearer-token auth event seen for the session, or auth occurred after the tool call) -- i.e. a spoofed/unauthenticated session riding the server's own privileged credential.
// The mcp-session-<uuid> ID format alone is NOT a suspicious signal: it is the standard shape for every session, legitimate and spoofed alike -- matching on format alone previously flagged all sessions equally. Also dropped the broad 'has "service"' account-name substring match (matched e.g. any "customer service" user) in favor of the auth-bypass signal.
// NOTE: previously queried a fictional 'MCCEventLogs' table that does not exist in this environment's schema (every column reference against it failed validation). Rewritten against CommonSecurityLog, extracting the MCP-specific fields (session id, tool name) from its Message/RequestURL columns, consistent with the fix already applied to the sibling "grafana_api_request call without prior bearer auth" rule.
let AuthedSessions = CommonSecurityLog
| where DeviceProduct has "mcp-grafana" or DeviceProduct has "Grafana MCP Server"
| where Message has "AuthenticationEvent" and (Message has "Bearer" or Message has "Authorization")
| extend SessionId = extract(@"(mcp-session-[0-9a-fA-F-]+)", 1, tostring(Message))
| where isnotempty(SessionId)
| summarize AuthTime = min(TimeGenerated) by SessionId;
CommonSecurityLog
| where DeviceProduct has "mcp-grafana" or DeviceProduct has "Grafana MCP Server"
| where RequestURL has "grafana_api_request" or Message has "grafana_api_request"
| extend SessionId = extract(@"(mcp-session-[0-9a-fA-F-]+)", 1, tostring(coalesce(RequestURL, Message)))
| where isnotempty(SessionId)
| join kind=leftouter AuthedSessions on SessionId
| where isnull(AuthTime) or AuthTime > TimeGenerated
| summarize AdminCallCount = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by SessionId, SourceIP
| project SessionId, SourceIP, AdminCallCount, FirstSeen, LastSeen