alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Grafana MCP unauthenticated tools/call invoking grafana_api_request via spoofed Mcp-Session-Id (no bearer auth) -- meaningful only on deployments with bearer-token auth enabled (v1.1.0+); tools/list is excluded as normal unauthenticated-by-design discovery traffic"; flow:to_server,established; http.method; content:"POST"; http.header_names; content:"Mcp-Session-Id"; http.header_names; content:!"Authorization"; http.header; content:"Mcp-Session-Id|3a| mcp-session-"; fast_pattern; http.request_body; content:"grafana_api_request"; pcre:"/\"method\"\s*:\s*\"tools\/call\"/"; metadata: author detections.ai, created_at 2026-01-01, mitre_technique_id T1078, mitre_technique_id T1550, mitre_technique_id T1190, mitre_technique_id T1550.001; classtype:attempted-admin; sid:1000101; rev:2;)