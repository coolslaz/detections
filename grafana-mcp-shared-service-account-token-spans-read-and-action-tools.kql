// Sharing one service-account token across read and action tools is the DEFAULT Grafana MCP deployment today -- alone it is not anomalous.
// Only flag when a session that also lacks confirmed prior authentication (no bearer-token auth event seen, or auth happened after tool calls began) 
// exercises BOTH read-only and action-capable tools -- i.e. an unauthenticated/spoofed session riding the shared credential's full privilege range (T1078, T1552).
let ActionTools = dynamic(["grafana_api_request", "create_dashboard", "update_dashboard", "delete_dashboard", "create_alert_rule", "update_alert_rule", "delete_alert_rule", "create_datasource", "update_datasource", "delete_datasource", "create_team", "update_team", "delete_team"]);
let ReadOnlyTools = dynamic(["tools/list", "list_dashboards", "get_dashboard", "query_prometheus", "query_loki", "list_datasources", "search", "list_alert_rules", "get_alert_rule"]);
let AuthedSessions = DeviceEvents
| where ActionType =~ "AuthenticationEvent" and isnotempty(AdditionalFields.BearerToken)
| summarize AuthTime = min(TimeGenerated) by DeviceId;
DeviceEvents
| where ActionType has_any (ActionTools) or ActionType has_any (ReadOnlyTools)
| extend ToolCategory = case(
    ActionType in (ActionTools), "ActionCapable",
    ActionType in (ReadOnlyTools), "ReadOnly",
    "Other")
| join kind=leftouter AuthedSessions on DeviceId
| extend Unauthenticated = isnull(AuthTime) or AuthTime > TimeGenerated
| summarize
    ToolsUsed = make_set(ActionType, 20),
    CategoriesUsed = make_set(ToolCategory, 5),
    ActionCallCount = countif(ToolCategory == "ActionCapable"),
    ReadOnlyCallCount = countif(ToolCategory == "ReadOnly"),
    UnauthenticatedCallCount = countif(Unauthenticated),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by DeviceId
| where array_length(CategoriesUsed) > 1 and ActionCallCount > 0 and ReadOnlyCallCount > 0 and UnauthenticatedCallCount > 0
| project DeviceId, ActionCallCount, ReadOnlyCallCount, UnauthenticatedCallCount, ToolsUsed, FirstSeen, LastSeen