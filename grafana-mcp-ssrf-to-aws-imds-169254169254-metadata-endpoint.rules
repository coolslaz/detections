alert http any any -> [169.254.169.254,169.254.0.0/16] any (msg:"Grafana MCP SSRF to AWS IMDS 169.254.169.254 Metadata Endpoint"; flow:to_server,established; http.request_body; content:"grafana_api_request"; http.header_names; content:"X-Grafana-URL"; http.header; content:"X-Grafana-URL|3a|"; pcre:"/X-Grafana-URL\s*:\s*https?:\/\/(169\.254\.)/i"; metadata: author detections.ai, created_at 2026-01-01, mitre_technique_id T1552.005, mitre_technique_id T1190, mitre_technique_id T1090; classtype:attempted-admin; reference:url,https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2026-19516; reference:cve,2026-19516; sid:1000003; rev:2;)

alert dns any any -> any any (msg:"Grafana MCP host resolving GCP metadata.google.internal - possible SSRF metadata access"; dns.query; content:"metadata.google.internal"; nocase; metadata: author detections.ai, created_at 2026-01-01, mitre_technique_id T1552.005, mitre_technique_id T1190; classtype:attempted-recon; sid:1000004; rev:1;)