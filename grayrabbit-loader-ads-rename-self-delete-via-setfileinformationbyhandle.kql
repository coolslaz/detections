// Detects GRAYRABBIT loader self-deletion using NTFS ADS rename technique:
// SetFileInformationByHandle with FileRenameInfo (class 3) to rename the default
// data stream to an actual Alternate Data Stream name (colon-delimited), followed by
// FileDispositionInfo (class 4) to mark the file for deletion on handle close — no
// DeleteFileW call emitted. Scoped to processes launched from unusual/user-writable
// locations and excludes known legitimate installer/updater self-delete behavior.
DeviceEvents
| where ActionType == "SetFileInformationByHandle"
| extend AdditionalFields = parse_json(AdditionalFields)
| extend FileInformationClass = tostring(AdditionalFields.FileInformationClass)
| where FileInformationClass in ("3", "4", "FileRenameInfo", "FileDispositionInfo")
// Narrow to processes executing from unusual/temporary/user-writable locations
| where InitiatingProcessFolderPath has_any ("\\Public\\", "\\Temp\\", "\\AppData\\", "\\Downloads\\")
// Exclude known legitimate installers/updaters that legitimately self-delete via similar rename patterns
| where InitiatingProcessFileName !in~ (
    "GoogleUpdate.exe", "MicrosoftEdgeUpdate.exe", "OneDriveSetup.exe",
    "setup.exe", "Installer.exe", "ChromeSetup.exe", "FirefoxSetup.exe",
    "MicrosoftEdgeSetup.exe", "EdgeUpdate.exe", "updater.exe"
)
| summarize
    InformationClasses = make_set(FileInformationClass, 10),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    FileNames = make_set(FileName, 10),
    FolderPaths = make_set(FolderPath, 10)
    by DeviceId, DeviceName, InitiatingProcessId, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, InitiatingProcessAccountName
| where set_has_element(InformationClasses, "3") or set_has_element(InformationClasses, "FileRenameInfo")
| where set_has_element(InformationClasses, "4") or set_has_element(InformationClasses, "FileDispositionInfo")
// Require the renamed target filename to use an actual ADS naming pattern (colon-delimited stream name)
| where FileNames has_any ("7z.dll", "7zp.dll", "boy.dll")
    or FolderPaths has_any ("Public", "Temp", "AppData", "Downloads")
| mv-expand FileNameCandidate = FileNames
| extend FileNameCandidate = tostring(FileNameCandidate)
| where FileNameCandidate matches regex @"^[^:]+:[^:\\/]+$"
| summarize
    FirstSeen = min(FirstSeen),
    LastSeen = max(LastSeen),
    ADSFileNames = make_set(FileNameCandidate, 10),
    FolderPaths = take_any(FolderPaths),
    InformationClasses = take_any(InformationClasses)
    by DeviceName, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, InitiatingProcessAccountName
| project
    FirstSeen,
    LastSeen,
    DeviceName,
    InitiatingProcessFileName,
    InitiatingProcessFolderPath,
    InitiatingProcessCommandLine,
    InitiatingProcessAccountName,
    ADSFileNames,
    FolderPaths,
    InformationClasses