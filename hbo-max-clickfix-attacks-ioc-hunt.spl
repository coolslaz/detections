(DestinationIP IN ("45.94.47.204", "77.91.65.13", "165.22.199.85", "164.90.161.147", "92.246.136.14", "62.60.226.69", "176.53.159.66", "172.236.51.169", "138.124.93.32", "168.100.9.122", "199.217.98.33", "38.244.158.103", "38.244.158.56") OR SourceIP IN ("45.94.47.204", "77.91.65.13", "165.22.199.85", "164.90.161.147", "92.246.136.14", "62.60.226.69", "176.53.159.66", "172.236.51.169", "138.124.93.32", "168.100.9.122", "199.217.98.33", "38.244.158.103", "38.244.158.56") OR DestinationHostName IN ("*filequanticore.com*", "*filesiriuscore.com*", "*alfredaps.com*", "*hbomaxx.us*", "*hbomax-macos.com*", "*bright-links.com*", "*codex-notes.com*", "*storageprofiler.com*", "*cladesktop.gitlab.io*", "*cli-desktop.com*", "*cli-stack.com*", "*homebrwmac-hub.com*", "*clean-disk-guide.com*", "*flutelikelurkerunsinewy.com*", "*camaligsalvatrefoils.com*", "*press29.com*", "*leaf68.com*", "*basequill9.com*", "*perchframe15.com*", "*canvas-35.com*", "*pine63.com*", "*trekmesh15.com*", "*weaveridge7.com*", "*ember-bridge.com*", "*rudder-moss.com*", "*wuess.com*", "*arkypc.com*", "*harbor-29.com*", "*fern-plume.com*", "*node-slate.com*", "*grove-12.com*", "*verse-18.com*", "*lakhov.com*", "*mpasvw.com*", "*ouilov.com*", "*aforvm.com*", "*desktop-version.com*", "*oakenfjrod.ru*", "*sic180.com*", "*hbomaxx.app*") OR Message IN ("*filequanticore.com*", "*filesiriuscore.com*", "*alfredaps.com*", "*hbomaxx.us*", "*hbomax-macos.com*", "*bright-links.com*", "*codex-notes.com*", "*storageprofiler.com*", "*cladesktop.gitlab.io*", "*cli-desktop.com*", "*cli-stack.com*", "*homebrwmac-hub.com*", "*clean-disk-guide.com*", "*flutelikelurkerunsinewy.com*", "*camaligsalvatrefoils.com*", "*press29.com*", "*leaf68.com*", "*basequill9.com*", "*perchframe15.com*", "*canvas-35.com*", "*pine63.com*", "*trekmesh15.com*", "*weaveridge7.com*", "*ember-bridge.com*", "*rudder-moss.com*", "*wuess.com*", "*arkypc.com*", "*harbor-29.com*", "*fern-plume.com*", "*node-slate.com*", "*grove-12.com*", "*verse-18.com*", "*lakhov.com*", "*mpasvw.com*", "*ouilov.com*", "*aforvm.com*", "*desktop-version.com*", "*oakenfjrod.ru*", "*sic180.com*", "*hbomaxx.app*")) ```exclude known scanner / threat-intel feed sources that proactively probe IOC lists rather than real victim traffic```
| eval is_scanner_src=if(match(lower(coalesce(SourceIP,"")), "^(?:167\.94\.|162\.142\.|71\.6\.|198\.20\.|93\.174\.|185\.142\.|89\.248\.)") OR match(lower(coalesce(http_user_agent,UserAgent,"")), "(censys|shodan|shadowserver|internetscanner|masscan|zgrab|greynoise|rapid7|criminalip|onyphe|expanse|leakix|netlas|binaryedge|palo alto networks-urlfiltering|virustotal|threatbook|intrigue|hunter\.io|nmap scripting engine)"), 1, 0)
| where is_scanner_src=0 ```drop scanner/TI-feed probes```
| eval domain_hit=if(match(lower(coalesce(DestinationHostName,"")), "(filequanticore\.com|filesiriuscore\.com|alfredaps\.com|hbomaxx\.us|hbomax-macos\.com|bright-links\.com|codex-notes\.com|storageprofiler\.com|cladesktop\.gitlab\.io|cli-desktop\.com|cli-stack\.com|homebrwmac-hub\.com|clean-disk-guide\.com|flutelikelurkerunsinewy\.com|camaligsalvatrefoils\.com|press29\.com|leaf68\.com|basequill9\.com|perchframe15\.com|canvas-35\.com|pine63\.com|trekmesh15\.com|weaveridge7\.com|ember-bridge\.com|rudder-moss\.com|wuess\.com|arkypc\.com|harbor-29\.com|fern-plume\.com|node-slate\.com|grove-12\.com|verse-18\.com|lakhov\.com|mpasvw\.com|ouilov\.com|aforvm\.com|desktop-version\.com|oakenfjrod\.ru|sic180\.com|hbomaxx\.app)") OR match(lower(coalesce(Message,"")), "(filequanticore\.com|filesiriuscore\.com|alfredaps\.com|hbomaxx\.us|hbomax-macos\.com|bright-links\.com|codex-notes\.com|storageprofiler\.com|cladesktop\.gitlab\.io|cli-desktop\.com|cli-stack\.com|homebrwmac-hub\.com|clean-disk-guide\.com|flutelikelurkerunsinewy\.com|camaligsalvatrefoils\.com|press29\.com|leaf68\.com|basequill9\.com|perchframe15\.com|canvas-35\.com|pine63\.com|trekmesh15\.com|weaveridge7\.com|ember-bridge\.com|rudder-moss\.com|wuess\.com|arkypc\.com|harbor-29\.com|fern-plume\.com|node-slate\.com|grove-12\.com|verse-18\.com|lakhov\.com|mpasvw\.com|ouilov\.com|aforvm\.com|desktop-version\.com|oakenfjrod\.ru|sic180\.com|hbomaxx\.app)"), 1, 0)
| eval ip_only_hit=if((DestinationIP IN ("45.94.47.204", "77.91.65.13", "165.22.199.85", "164.90.161.147", "92.246.136.14", "62.60.226.69", "176.53.159.66", "172.236.51.169", "138.124.93.32", "168.100.9.122", "199.217.98.33", "38.244.158.103", "38.244.158.56") OR SourceIP IN ("45.94.47.204", "77.91.65.13", "165.22.199.85", "164.90.161.147", "92.246.136.14", "62.60.226.69", "176.53.159.66", "172.236.51.169", "138.124.93.32", "168.100.9.122", "199.217.98.33", "38.244.158.103", "38.244.158.56")) AND domain_hit=0, 1, 0)
| where domain_hit=1 OR ip_only_hit=0 ```require domain/message correlation for generic reused IOC IPs, allowing pure domain/message hits through```
| bin _time span=15m
| stats count as match_count, values(DestinationHostName) as matched_hostnames, values(Message) as matched_messages, values(DestinationIP) as dest_ips, values(SourceIP) as src_ips, earliest(_time) as first_seen, latest(_time) as last_seen by host, _time
| where match_count > 0 ```one alert per host per 15-minute window instead of one per raw event```
| sort -last_seen