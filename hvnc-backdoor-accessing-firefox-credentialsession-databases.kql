DeviceFileEvents
| where FileName in~ ("cookies.sqlite", "places.sqlite", "permissions.sqlite")
| where FolderPath has "Mozilla\\Firefox\\Profiles"
| where InitiatingProcessFileName in~ ("UpdateAssistant.exe", "AppUpdateHelper.exe", "SysMaintenance.exe")
| where InitiatingProcessFileName !~ "firefox.exe"
| where InitiatingProcessFolderPath !has "Mozilla Firefox"
| project TimeGenerated, DeviceName, InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, FileName, FolderPath, ActionType
| order by TimeGenerated desc
// false_positives: Legitimate Firefox browser process (firefox.exe) or processes running from the standard Mozilla Firefox installation path accessing these profile database files during normal operation. This rule is scoped to only the specific non-Firefox process names (UpdateAssistant.exe, AppUpdateHelper.exe, SysMaintenance.exe) observed masquerading as system components, and explicitly excludes firefox.exe and processes launched from the Mozilla Firefox program directory.