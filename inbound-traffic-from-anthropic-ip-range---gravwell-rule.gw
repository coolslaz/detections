tag=entra*,device*,graph*,cloud*,email* start=-30d | json IPAddress RemoteIP IpAddress IPAddress SenderIPv4 | eval is_match = (IPAddress ~ "160.79.104.0/21") || (RemoteIP ~ "160.79.104.0/21") || (IpAddress ~ "160.79.104.0/21") || (SenderIPv4 ~ "160.79.104.0/21") | eval is_email = tag == "email" | eval is_entra = tag == "entra" | eval is_network = tag == "device" | eval is_graph = tag == "graph" | eval is_m365 = tag == "cloud" | eval valid = is_match && (is_email || is_entra || is_network || is_graph || is_m365) | eval valid ? "match" : "drop" | table *