DeviceFileEvents
| where TimeGenerated > ago(1d)
| where FileName in~ ("Login Data", "Local State", "Cookies", "Web Data")
| where FolderPath has_any ("\\Google\\Chrome\\User Data", "\\Microsoft\\Edge\\User Data", "\\BraveSoftware\\Brave-Browser\\User Data", "\\Mozilla\\Firefox\\Profiles", "Library/Application Support/Google/Chrome", "Library/Cookies")
| where InitiatingProcessFileName !~ "chrome.exe" and InitiatingProcessFileName !~ "msedge.exe" and InitiatingProcessFileName !~ "firefox.exe" and InitiatingProcessFileName !~ "brave.exe" and InitiatingProcessFileName !~ "explorer.exe"
// Exclude common legitimate processes that legitimately touch these same browser files
| where InitiatingProcessFileName !~ "SearchIndexer.exe" and InitiatingProcessFileName !~ "SearchProtocolHost.exe"
| where InitiatingProcessFileName !~ "MsMpEng.exe" and InitiatingProcessFileName !~ "MpCopyAccelerator.exe"
| where not(InitiatingProcessFileName has_any ("backup", "onedrive", "dropbox"))
| where InitiatingProcessFileName !~ "GoogleUpdate.exe" and InitiatingProcessFileName !~ "MicrosoftEdgeUpdate.exe" and InitiatingProcessFileName !~ "updater.exe"
| where not(InitiatingProcessFolderPath has_any ("CrowdStrike", "SentinelOne", "Carbon Black", "Cb\\", "Defender", "Microsoft Defender ATP", "MDATP", "EDR", "Velociraptor", "KAPE"))
// Require initiating process to run from a suspicious/user-writable location, not a trusted install path
| extend InitPathLower = tolower(InitiatingProcessFolderPath)
| extend IsSuspiciousPath = (InitPathLower has_any ("\\temp\\", "\\appdata\\local\\temp", "\\downloads\\", "\\appdata\\roaming\\", "\\programdata\\") or not(InitPathLower has_any ("\\program files\\", "\\program files (x86)\\", "\\windows\\", "\\system32\\")))
| where IsSuspiciousPath
| extend SuspectedFamily = case(
    InitiatingProcessFileName has_any ("vidar"), "Vidar",
    InitiatingProcessFileName has_any ("lumma", "lummac2"), "Lumma/LummaC2",
    InitiatingProcessFileName has_any ("stealc"), "StealC",
    InitiatingProcessFileName has_any ("redline"), "RedLine",
    InitiatingProcessFileName has_any ("acreed"), "Acreed",
    InitiatingProcessFileName has_any ("amos", "atomicstealer"), "Atomic Stealer (AMOS)",
    "Unknown/Unsigned Process"
)
| project TimeGenerated, DeviceName, FileName, FolderPath, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, InitiatingProcessSHA256, SuspectedFamily, ActionType
| summarize AccessedFiles = make_set(FileName, 10), DistinctSensitiveFileTypes = dcount(FileName), AccessCount = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by DeviceName, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessSHA256, SuspectedFamily
// Require access to at least two distinct sensitive credential/cookie store types in one run
| where DistinctSensitiveFileTypes >= 2
| where AccessCount >= 2
| sort by LastSeen desc