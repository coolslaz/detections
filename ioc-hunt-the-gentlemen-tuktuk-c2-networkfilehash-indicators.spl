(index=device_logs (sourcetype=device_network OR sourcetype=device_file OR sourcetype=device_process)) earliest=-30d | eval c2_ip="65.109.70.162", c2_domain="borjumaniya.store" | eval sha256_iocs="97bd65e98cdc4e93d49edd4ea905d43a61244df0fd3323e6649330de3b1be091,e2b31ac7ee077b26332444a83a68ab75be641113e7d86979d844a0f3478f01f9,e74088419de2e5b47b1889f2ba1369cb4b436405ce03cf07da452791681f9923,096ec37870eb401793592c9b53b5b52fc7a70b113bc2d9cd3f53231142d6c584", sha1_iocs="138c41085f5f07adbdeff4df97a6a80252571e28" | eval is_match=case(sourcetype="device_network" AND (RemoteIP==c2_ip OR RemoteUrl==c2_domain OR like(RemoteUrl, "%." . c2_domain)), "NetworkIOC", (sourcetype="device_file" OR sourcetype="device_process") AND (SHA256 IN (split(sha256_iocs, ",")) OR SHA1 IN (split(sha1_iocs, ","))), "HashIOC", true(), "none") | where is_match!="none" | eval MatchedIndicator=if(sourcetype="device_network", if(RemoteIP==c2_ip, c2_ip, c2_domain), coalesce(SHA256, SHA1)) | rename ActionType AS ActionType, RemoteIP AS RemoteIP, RemoteUrl AS RemoteUrl, RemotePort AS RemotePort, InitiatingProcessFileName AS InitiatingProcessFileName, InitiatingProcessCommandLine AS InitiatingProcessCommandLine | table _time, DeviceId, DeviceName, ActionType, RemoteIP, RemoteUrl, RemotePort, InitiatingProcessFileName, InitiatingProcessCommandLine, is_match, MatchedIndicator | sort - _time