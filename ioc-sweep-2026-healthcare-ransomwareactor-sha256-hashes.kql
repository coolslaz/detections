| extend SHA256 = tolower(SHA256);
let QuarantinePathPatterns = dynamic([
 "\\microsoft\\windows defender\\quarantine\\",
 "\\microsoft\\windows defender\\scans\\",
 "\\microsoft\\windows defender atp\\",
 "\\quarantine\\",
 "\\sandbox\\",
 "\\sample-collection\\",
 "\\samples\\",
 "\\cyclonedx\\edr\\samples\\",
 "\\programdata\\sophos\\",
 "\\programdata\\mcafee\\quarantine\\",
 "\\programdata\\crowdstrike\\quarantine\\",
 "\\programdata\\microsoft\\windows defender\\"
]);
let IsQuarantinePath = (path:string) {
 let lowered = tolower(path);
 array_length(QuarantinePathPatterns) > 0 and (lowered has "quarantine" or lowered has "sandbox" or lowered has "sample-collection" or lowered has "windows defender\\scans" or lowered has "windows defender atp")
};
let FileHits = DeviceFileEvents
| where isnotempty(SHA256)
| extend SHA256 = tolower(SHA256)
| join kind=inner HashFamilyMap on $left.SHA256 == $right.SHA256
| where not(IsQuarantinePath(FolderPath))
| project Timestamp, DeviceName, Family, SHA256, FileName, FolderPath, ActionType, InitiatingProcessAccountName, SourceTable = "DeviceFileEvents";
let ProcessHits = DeviceProcessEvents
| where isnotempty(SHA256)
| extend SHA256 = tolower(SHA256)
| join kind=inner HashFamilyMap on $left.SHA256 == $right.SHA256
| where not(IsQuarantinePath(FolderPath))
| project Timestamp, DeviceName, Family, SHA256, FileName, FolderPath, ProcessCommandLine, InitiatingProcessAccountName, SourceTable = "DeviceProcessEvents";
FileHits
| union ProcessHits
| extend DedupWindow = bin(Timestamp, 24h)
| summarize arg_max(Timestamp, *) by DeviceName, SHA256, DedupWindow
| project-away DedupWindow
| sort by Timestamp desc