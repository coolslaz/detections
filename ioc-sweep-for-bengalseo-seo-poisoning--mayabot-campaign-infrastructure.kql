// IOC sweep for BengalSEO SEO-poisoning / MayaBot campaign infrastructure
// Matches endpoint network connections against known TDS redirectors, Matomo tracking domains, C2 domains, and the Hostmaza backend IP
// Note: the source intel contains no file hashes (MD5/SHA1/SHA256) -- this sweep covers IP and domain indicators only
let KnownBadIP = "5.101.140.80";
let KnownBadDomains = dynamic([
    "stats.us3.org", "us3.my", "us3.org",
    "cus.cam", "dll.lat", "tax.dll.lat", "us99.org",
