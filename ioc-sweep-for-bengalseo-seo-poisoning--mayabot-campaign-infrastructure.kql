    "us00.us", "us1.my", "us1.site", "us110.my", "us115.my", "us130.my", "us135.my", "us2.my", "us202.my", "us203.my", "us210.my", "us215.my", "us220.my", "us225.my", "us228.my", "us230.my", "us30.my", "us300.my", "us302.my", "us305.my", "us31.my", "us310.my", "us315.my", "us32.my", "us320.my", "us33.my", "us34.my", "us35.my", "us350.my", "us355.my", "us4.my", "us400.my", "us5.co", "us5.my", "us50.my", "us500.my", "us501.cc", "us503.my", "us505.my", "us506.my", "us51.my", "us52.my", "us53.my", "us54.my", "us55.my", "us60.my", "us600.my", "us603.my", "us605.cc", "us605.my", "us61.my", "us610.my", "us62.my", "us63.my", "us64.my", "us65.my", "us7.my", "us70.my", "us700.my", "us705.my", "us706.cc", "us707.cc", "us708.my", "us71.my", "us710.my", "us72.my", "us73.my", "us74.my", "us75.my", "us8.my", "us800.cc", "us800.my", "us801.my", "us802.my", "us803.my", "us804.my", "us805.my", "us807.my", "us810.my", "us815.my", "us9.my", "us900.cc", "us900.my", "us902.my", "us905.my", "us906.my", "us91.my", "us910.my", "us915.my", "us92.my", "us93.my", "us94.my", "us95.my", "us951.cc", "us96.my",
    "usact1.my", "usact2.info", "usact2.my", "usact3.info", "usact3.my", "usact4.info", "usact4.my", "usact5.info", "usact5.my", "usact6.my",
    "ustechnio.com", "ustechnio10.com", "ustechnio20.com", "ustechnio30.com", "ustechnio50.com", "ustechnio60.com", "ustechnio70.com", "ustechnio80.com",
    "ustechno.cc", "ustechno.my", "ustechno1.com", "ustechno100.cc", "ustechno151.cc", "ustechno25.cc", "ustechno5.com", "ustechno50.cc",
    "4jio.com", "fm.ci", "link72.com", "pre.im", "printredir.com", "q82.net", "to.ghredir.com", "ts.remdos.com", "tx.newredir.com", "tx.platdir.com", "url19.com", "url90.com", "us00.net", "us6.my", "ww0.us", "flosyr.com", "redircoms.com",
    "u320.my", "reficon.pro", "aol.cx", "iconnectpc.com", "wapp.live"
]);
DeviceNetworkEvents
| where TimeGenerated > ago(30d)
| extend RemoteHost = tolower(tostring(parse_url(RemoteUrl).Host))
| where RemoteIP == KnownBadIP
    or RemoteHost in~ (KnownBadDomains)
| extend MatchedIndicator = iff(RemoteIP == KnownBadIP, KnownBadIP, RemoteHost)
| project TimeGenerated, DeviceName, DeviceId, InitiatingProcessFileName, InitiatingProcessCommandLine, RemoteIP, RemoteUrl, RemoteHost, MatchedIndicator, RemotePort, ActionType
| sort by TimeGenerated desc