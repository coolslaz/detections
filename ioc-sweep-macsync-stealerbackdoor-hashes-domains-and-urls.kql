let macsync_md5_hashes = dynamic(["26a0f7cdb9f7dc5ace9a40af825b1538","2d69812584269699fade26622e6490c5","7df1049cbd56c0bfa4a3364a379b4c2c","9f15fe9c4415cd668334339f705b94d8","fb90887592655a8c989e443c640167aa","6791dad263cac6d63ebba6a4b57e7d71","3ded1d71a822b53b12c3b67bcaf633f5","781ce50001d4b449600afa347c9b0208","8e84b01d5ac9624f0b181ade0e737193","980e2134679bc0c609f7659882883d77","4203ec932bfcc0907f91732440d6d997","eb760d5c88f13f7ee0f8f86ba3407123","f9f70096aabb4d22a6657014f4853a53","3deeed48fd38f22e369f5c3092bd68a1","f97d24212fa6a21be0c4d211e10f044c","00d12d842596bf5ee1805effb4571d30","9a0043d900a9ac78c886c59c9a328fd0","7212229c85852c3bffaf9740002b2f39","c53d0ea45dbc622afb7f16ea3eec78bc","fc3ba5ed282d77127efd0b0f2403531b","8dc8561349d144d4661bc66f2ec49f9f"]);
let macsync_domains = dynamic(["toria.app","warpcast.asia","streamyard.appstore.com.mx","slack.apple03cloudstore.com","toria.apple03cloudstore.com","waaako.appstore.com.mx","docsend.appstore.com.mx"]);
let macsync_urls = dynamic(["https://warpcast.asia/Toria.dmg","https://streamyard.appstore.com.mx/installer.sh","https://slack.apple03cloudstore.com/installer.sh","https://waaako.appstore.com.mx/installer.sh","https://toria.apple03cloudstore.com/e3c1a6b00bc31e14/stage2.enc","https://docsend.appstore.com.mx/dcc737d157ef4271/stage2.enc","https://docsend.appstore.com.mx/dcc737d157ef4271/CoreUpdate.pkg.enc","https://docsend.appstore.com.mx/dcc737d157ef4271/Helper.pkg.enc"]);
let process_hash_hits = DeviceProcessEvents
| where TimeGenerated > ago(14d)
| where MD5 in~ (macsync_md5_hashes) or InitiatingProcessMD5 in~ (macsync_md5_hashes)
| project TimeGenerated, DeviceId, DeviceName, MatchType = "ProcessHash", IndicatorMatched = coalesce(MD5, InitiatingProcessMD5), FileName, FolderPath, ProcessCommandLine, InitiatingProcessFileName, ReportId;
let file_hash_hits = DeviceFileEvents
| where TimeGenerated > ago(14d)
| where MD5 in~ (macsync_md5_hashes)
| project TimeGenerated, DeviceId, DeviceName, MatchType = "FileHash", IndicatorMatched = MD5, FileName, FolderPath, ProcessCommandLine = InitiatingProcessCommandLine, InitiatingProcessFileName, ReportId;
let network_domain_hits = DeviceNetworkEvents
| where TimeGenerated > ago(14d)
| extend RemoteHost = tolower(tostring(parse_url(RemoteUrl).Host))
| where RemoteHost in~ (macsync_domains)
| project TimeGenerated, DeviceId, DeviceName, MatchType = "NetworkDomain", IndicatorMatched = RemoteHost, FileName = InitiatingProcessFileName, FolderPath = InitiatingProcessFolderPath, ProcessCommandLine = InitiatingProcessCommandLine, InitiatingProcessFileName, ReportId;
let http_url_hits = DeviceNetworkEvents
| where TimeGenerated > ago(14d)
| where RemoteUrl in~ (macsync_urls)
| project TimeGenerated, DeviceId, DeviceName, MatchType = "NetworkURL", IndicatorMatched = RemoteUrl, FileName = InitiatingProcessFileName, FolderPath = InitiatingProcessFolderPath, ProcessCommandLine = InitiatingProcessCommandLine, InitiatingProcessFileName, ReportId;
union process_hash_hits, file_hash_hits, network_domain_hits, http_url_hits
| sort by TimeGenerated desc