alert dns any any -> any any (msg:"IronToll - Government/Brand Impersonation Keyword on Non-Standard TLD (Lookalike Domain)"; dns.query; content:"."; pcre:"/(?:^|\.)(gov|justice|amendes)[a-z0-9-]*\.(autos|rest|shop|cfd|sbs|icu|buzz|cyou|pics|boats)$/i"; metadata: author Arnold Chan, created_at 2025-01-01, mitre_tactic_id TA0001, mitre_technique_id T1583.001, mitre_technique_id T1566.002; classtype:bad-unknown; sid:1000201; rev:2;)