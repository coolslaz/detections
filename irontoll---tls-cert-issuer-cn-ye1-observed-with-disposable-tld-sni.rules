alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"IronToll - TLS Cert Issuer CN 'YE1' Observed with Disposable-TLD SNI"; flow:to_server,established; tls.cert_issuer; content:"YE1"; tls.sni; pcre:"/\.(cfd|sbs|icu|buzz|shop|autos|rest|boats|bond|lat|work|xyz|fit|forum|fun|hair|help|homes|reisen|skin|courses|bar|biz|casa|my\.id)$/i"; metadata: author Arnold Chan, campaign IronToll, mitre_technique_id T1588.004; reference:url,detections.ai/inspirations/01a090cc-85c2-72ff-9a16-2a77a5194f3a; classtype:trojan-activity; sid:1000114; rev:1;)