alert dns $HOME_NET any -> any any (msg:"IronToll Government-Impersonation Phishing Domain Query"; dns.query; content:"digitalgov"; nocase; pcre:"/^(digitalgov|amendes-justice-gov|vodafaonne|telestraau|euprava-gov)\.|at-govt-.*\.icu$|apcoa.*fine\.cfd$|q-parkfine\.cfd$|finess.*\.cfd$|malowzx\.sbs$/i"; metadata: author Arnold Chan, created_at 2025-01-01, mitre_technique_id T1566.002, mitre_technique_id_secondary T1583.001, campaign IronToll; classtype:phishing; sid:1000201; rev:1;)

alert dns $HOME_NET any -> any any (msg:"IronToll Phishing Lookalike Domain Query - Non-standard TLD with gov/justice/tax Keyword"; dns.query; pcre:"/(?:^|\.)(gov|justice|tax|fine|amendes)[a-z0-9-]*\.(autos|rest|shop|cfd|sbs|icu|buzz|cyou|pics|boats)$/i"; metadata: author detections.ai, created_at 2025-01-01, mitre_technique_id T1566.002, mitre_technique_id_secondary T1583.001, campaign IronToll; classtype:phishing; sid:1000202; rev:2;)

alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"IronToll Phishing Domain in TLS SNI"; tls.sni; pcre:"/^(digitalgov\.autos|amendes-justice-gov\.rest|vodafaonne\.shop|telestraau\.|euprava-gov\.|at-govt-.*\.icu|apcoa.*fine\.cfd|q-parkfine\.cfd|finess.*\.cfd|malowzx\.sbs)/i"; metadata: author detections.ai, created_at 2025-01-01, mitre_technique_id T1566.002, mitre_technique_id_secondary T1583.001, campaign IronToll; classtype:phishing; sid:1000203; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"IronToll Phishing Domain in HTTP Host Header"; flow:to_server,established; http.host; pcre:"/^(digitalgov\.autos|amendes-justice-gov\.rest|vodafaonne\.shop|telestraau\.|euprava-gov\.|at-govt-.*\.icu|apcoa.*fine\.cfd|q-parkfine\.cfd|finess.*\.cfd|malowzx\.sbs)/i"; metadata: author detections.ai, created_at 2025-01-01, mitre_technique_id T1566.002, mitre_technique_id_secondary T1583.001, campaign IronToll; classtype:phishing; sid:1000204; rev:1;)