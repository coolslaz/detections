tag=device-network-events start=-30d json RemoteUrl RemoteIP DeviceName DeviceId InitiatingProcessAccountName InitiatingProcessFileName InitiatingProcessCommandLine RemotePort Protocol | eval ( isHighConf = RemoteUrl ~ "enhanced.jeetbot.cc" || RemoteUrl ~ "enhanced-1.jeetbot.cc" || RemoteUrl ~ "ext-03.jeetbot.cc" || RemoteUrl ~ "ext-styles.jeetbot.cc" || RemoteUrl ~ "morphilina.me" || RemoteUrl ~ "proxy.morphilina.me" || RemoteUrl ~ "drisnya.online" || RemoteUrl ~ "img.drisnya.online" || RemoteUrl ~ "thebeholder-proxy.deno.dev" || RemoteUrl ~ "proxy.thebeholder.deno.net" || RemoteUrl ~ "alexue4.dev"; isJeetBotIP = RemoteIP == "152.53.177.186" || RemoteIP == "132.243.113.25" || RemoteIP == "80.74.26.162"; isAmbiguous = (RemoteUrl ~ "jeetbot.cc" || RemoteUrl ~ "api.jeetbot.cc") && (RemoteUrl ~ "&auth=" || RemoteUrl ~ "set-token" || RemoteUrl ~ "/api/v1/proxies" || RemoteUrl ~ "/api/v1/forced-proxy"); match = isHighConf || isJeetBotIP || isAmbiguous; DetectionReason = "Connection to JeetBot-associated domain"; if (RemoteUrl ~ "&auth=") { DetectionReason = "Possible Twitch OAuth token forwarded in URL"; } else if (RemoteUrl ~ "set-token") { DetectionReason = "Historical OAuth token collection endpoint"; } else if (RemoteUrl ~ "/api/v1/proxies") { DetectionReason = "JeetBot proxy configuration request"; } else if (RemoteUrl ~ "/api/v1/forced-proxy") { DetectionReason = "JeetBot forced proxy configuration request"; } else if (isHighConf) { DetectionReason = "Connection to JeetBot extension proxy/dev infrastructure"; } else if (isJeetBotIP) { DetectionReason = "Connection to known JeetBot IP infrastructure (verify current ownership - hosting IPs can be reassigned)"; } match; ) | table TimeGenerated DeviceName DeviceId InitiatingProcessAccountName InitiatingProcessFileName InitiatingProcessCommandLine RemoteUrl RemoteIP RemotePort Protocol DetectionReason