index=network (RemoteUrl="*enhanced.jeetbot.cc*" OR RemoteUrl="*enhanced-1.jeetbot.cc*" OR RemoteUrl="*ext-03.jeetbot.cc*" OR RemoteUrl="*ext-styles.jeetbot.cc*" OR RemoteUrl="*morphilina.me*" OR RemoteUrl="*proxy.morphilina.me*" OR RemoteUrl="*drisnya.online*" OR RemoteUrl="*img.drisnya.online*" OR RemoteUrl="*thebeholder-proxy.deno.dev*" OR RemoteUrl="*proxy.thebeholder.deno.net*" OR RemoteUrl="*alexue4.dev*" OR RemoteIP IN ("152.53.177.186", "132.243.113.25", "80.74.26.162") OR ((RemoteUrl="*jeetbot.cc*" OR RemoteUrl="*api.jeetbot.cc*") AND (RemoteUrl="*&auth=*" OR RemoteUrl="*set-token*" OR RemoteUrl="*/api/v1/proxies*" OR RemoteUrl="*/api/v1/forced-proxy*"))) earliest=-30d | eval DetectionReason=case(like(RemoteUrl, "%&auth=%"), "Possible Twitch OAuth token forwarded in URL", like(RemoteUrl, "%set-token%"), "Historical OAuth token collection endpoint", like(RemoteUrl, "% /api/v1/proxies%"), "JeetBot proxy configuration request", like(RemoteUrl, "% /api/v1/forced-proxy%"), "JeetBot forced proxy configuration request", match(RemoteUrl, "(enhanced\.jeetbot\.cc|enhanced-1\.jeetbot\.cc|ext-03\.jeetbot\.cc|ext-styles\.jeetbot\.cc|morphilina\.me|proxy\.morphilina\.me|drisnya\.online|img\.drisnya\.online|thebeholder-proxy\.deno\.dev|proxy\.thebeholder\.deno\.net|alexue4\.dev)"), "Connection to JeetBot extension proxy/dev infrastructure", cidrmatch("152.53.177.186/32", RemoteIP) OR cidrmatch("132.243.113.25/32", RemoteIP) OR cidrmatch("80.74.26.162/32", RemoteIP), "Connection to known JeetBot IP infrastructure (verify current ownership)", true(), "Connection to JeetBot-associated domain") | table _time, DeviceName, DeviceId, InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, RemoteUrl, RemoteIP, RemotePort, Protocol, DetectionReason | sort -_time