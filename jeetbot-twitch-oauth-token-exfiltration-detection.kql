// JeetBot / Twitch Enhanced Viewer - OAuth Token Exposure
// Source: Socket Threat Research / The Hacker News - September 2026
let JeetBotDomains = dynamic([
    "jeetbot.cc",
    "api.jeetbot.cc",
    "enhanced.jeetbot.cc",
    "enhanced-1.jeetbot.cc",
    "ext-03.jeetbot.cc",
    "ext-styles.jeetbot.cc",
    "morphilina.me",
    "proxy.morphilina.me",
    "drisnya.online",
    "img.drisnya.online",
    "thebeholder-proxy.deno.dev",
    "proxy.thebeholder.deno.net",
    "alexue4.dev"
]);
let JeetBotIPs = dynamic([
    "152.53.177.186",
    "132.243.113.25",
    "80.74.26.162"
]);
DeviceNetworkEvents
| where TimeGenerated > ago(30d)
| where
    RemoteIP in (JeetBotIPs)
    or RemoteUrl has_any (JeetBotDomains)
| extend DetectionReason = case(
    RemoteUrl contains "&auth=", "Possible Twitch OAuth token forwarded in URL",
    RemoteUrl contains "set-token", "Historical OAuth token collection endpoint",
    RemoteUrl contains "/api/v1/proxies", "JeetBot proxy configuration request",
    RemoteUrl contains "/api/v1/forced-proxy", "JeetBot forced proxy configuration request",
    RemoteIP in (JeetBotIPs), "Connection to known JeetBot infrastructure",
    "Connection to JeetBot-associated domain"
)
| project
    TimeGenerated,
    DeviceName,
    DeviceId,
    InitiatingProcessAccountName,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    RemoteUrl,
    RemoteIP,
    RemotePort,
    Protocol,
    DetectionReason
| order by TimeGenerated desc