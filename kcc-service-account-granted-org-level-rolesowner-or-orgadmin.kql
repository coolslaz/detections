// Detects the precondition described in the ConfigConfusion chain: Config Connector's
// shared Workload-Identity-bound Google service account (GSA) being granted an
// organization-scoped roles/owner or roles/resourcemanager.organizationAdmin binding
// instead of running KCC in namespaced mode with per-namespace scoped identities.
GCPAuditLogs
| where TimeGenerated > ago(30d)
| where ServiceName == "iam.googleapis.com" or MethodName has "SetIamPolicy"
| extend Payload = parse_json(ServiceData)
| mv-expand BindingDelta = Payload.policyDelta.bindingDeltas
| extend Role = tostring(BindingDelta.role), Member = tostring(BindingDelta.member), Action = tostring(BindingDelta.action)
| where Action =~ "ADD"
| where Role in ("roles/owner", "roles/resourcemanager.organizationAdmin")
| where GCPResourceName has "organizations/"
| where Member has "iam.gserviceaccount.com"
// KCC's default Workload Identity-bound GSA is conventionally deployed in the
// cnrm-system namespace, or named after the config-connector / kcc controller.
| where Member has_any ("cnrm-system", "config-connector", "kcc")
// Collapse to one alert per unique service-account + role pair instead of re-firing on every event
| summarize arg_max(TimeGenerated, PrincipalEmail, MethodName, GCPResourceName) by Member, Role
| project TimeGenerated, PrincipalEmail, Member, Role, GCPResourceName, MethodName