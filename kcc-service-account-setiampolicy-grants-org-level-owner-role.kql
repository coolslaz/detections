// Detects Google Cloud Audit Log setIamPolicy calls made by a Config Connector (KCC) Google Service Account
// that add roles/owner or roles/resourcemanager.organizationAdmin bindings at Organization or Folder scope.
// This is the second half of the ConfigConfusion chain: KCC's own high-privilege identity performs the
// IAM binding on behalf of a namespace-scoped Kubernetes user, and Cloud IAM only checks KCC's own authority.
GCPAuditLogs
| where MethodName =~ "SetIamPolicy" or MethodName has "setIamPolicy"
| where PrincipalEmail has "gserviceaccount.com"
// Restrict to KCC's own known GSA naming convention -- excludes unrelated IaC/automation
// service accounts (e.g. Terraform, Deployment Manager) that legitimately do org-level IAM changes
| where PrincipalEmail has_any ("cnrm-system", "config-connector", "kcc")
| where GCPResourceName has_any ("organizations/", "folders/")
| where ServiceName has_any ("cloudresourcemanager.googleapis.com", "iam.googleapis.com")
| extend RequestBody = tostring(Request)
| where RequestBody has_any ("roles/owner", "roles/resourcemanager.organizationAdmin")
| project TimeGenerated, PrincipalEmail, MethodName, GCPResourceName, ServiceName, RequestBody
| sort by TimeGenerated desc