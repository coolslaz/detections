// Detects Keycloak admin console configuration changes that enable the 'Forgot password' (resetPasswordAllowed) setting on a realm,
// which is the temporary mitigation for CVE-2026-18963. Flags cases where the change targets a known-vulnerable Keycloak version.
// Warning: KeycloakAuditEvents is an assumed table name; verify your workspace schema.
KeycloakAuditEvents
| where OperationType in ("UPDATE", "ACTION")
| where ResourceType =~ "REALM"
| extend RepresentationJson = parse_json(Representation)
| where RepresentationJson.resetPasswordAllowed == true
| extend KeycloakVersion = tostring(RepresentationJson.keycloakVersion)
| where KeycloakVersion in ("26.4", "26.4.15", "26.6", "26.6.6")
 or KeycloakVersion startswith "26.4."
 or KeycloakVersion startswith "26.6."
| project TimeGenerated, AdminUsername, RealmId, OperationType, ResourceType, KeycloakVersion, Representation
| sort by TimeGenerated desc