alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Keycloak Reset-Credentials Endpoint Request Missing Action Token (CVE-2026-18963)"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/login-actions/reset-credentials"; fast_pattern; http.uri; content:!"key="; http.uri; content:!"execution="; classtype:web-application-attack; metadata: attack_id T1190, cve CVE-2026-18963; reference:url,access.redhat.com/security/cve/CVE-2026-18963; sid:1000201; rev:1;)