// Detects Kothamine's getdiscord/getsessions C2 commands: the injected explorer.exe agent process
// (loaded with the dropped MicrosoftEdgeUpdateCore.dll payload) reading browser cookie stores
// alongside Steam/Minecraft credential JSON files in short succession
let browserPaths = dynamic(["\\Local State", "\\Cookies", "\\Network\\Cookies", "\\discord\\Local Storage", "\\Discord\\Local Storage"]);
let gamingPaths = dynamic(["\\Steam\\config\\loginusers.vdf", "\\.minecraft\\launcher_accounts.json", "\\.minecraft\\launcher_profiles.json", "\\Steam\\config\\config.vdf"]);
// Identify explorer.exe processes that had the Kothamine payload DLL injected into them
let injectedExplorer = DeviceImageLoadEvents
| where InitiatingProcessFileName =~ "explorer.exe"
| where FileName =~ "MicrosoftEdgeUpdateCore.dll"
| where FolderPath has "\\AppData\\Roaming\\"
| project DeviceId, InitiatingProcessId, InjectTime = Timestamp;
DeviceFileEvents
| where InitiatingProcessFileName =~ "explorer.exe" or InitiatingProcessFileName =~ "MicrosoftEdgeUpdateCore.dll"
| where ActionType in ("FileCreated", "FileModified", "FileRenamed") or ActionType == "FileAccessed"
| extend IsBrowserCred = FolderPath has_any (browserPaths)
| extend IsGamingCred = FolderPath has_any (gamingPaths)
| where IsBrowserCred or IsGamingCred
| join kind=inner (injectedExplorer) on DeviceId, InitiatingProcessId
| where Timestamp >= InjectTime
| summarize BrowserHits = countif(IsBrowserCred), GamingHits = countif(IsGamingCred), Files = make_set(FolderPath, 20), FirstSeen = min(Timestamp), LastSeen = max(Timestamp) by DeviceId, DeviceName, InitiatingProcessFileName, InitiatingProcessId, bin(Timestamp, 10m)
| where BrowserHits > 0 and GamingHits > 0
| project FirstSeen, LastSeen, DeviceId, DeviceName, InitiatingProcessFileName, InitiatingProcessId, BrowserHits, GamingHits, Files