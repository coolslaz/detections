AWSCloudTrail
| where TimeGenerated > ago(14d)
| where SourceIpAddress == "23.234.84.102"
| where EventName in ("GetCallerIdentity", "ListTopics")
| extend UserAgentValue = tostring(UserAgent)
| where isempty(UserAgentValue) or not(UserAgentValue has_any ("aws-internal", "aws-sdk-health-check", "canary"))
| extend UserArn = tostring(UserIdentityArn)
| extend AccessKey = tostring(UserIdentityAccessKeyId)
| summarize EventCount = count(), EventNames = make_set(EventName), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by SourceIpAddress, UserArn, AccessKey, AWSRegion
| where EventCount >= 2
| project FirstSeen, LastSeen, SourceIpAddress, UserArn, AccessKey, AWSRegion, EventNames, EventCount