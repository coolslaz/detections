alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LeakySensey: Possible access to exposed LeakySensey transaction/compromise log endpoint"; flow:to_server,established; http.uri; content:"log"; nocase; pcre:"/\/logs?\/(transaction|compromise)/i"; classtype:trojan-activity; metadata: author Arnold Chan, created_at 2025-01-01, mitre_technique_id T1102, mitre_technique_id T1583.006, confidence low, false_positives Generic_keyword_match_requires_IOC_enrichment_with_confirmed_hosting_range; sid:1000015; rev:1;)