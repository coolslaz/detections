alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"LeakySensey: Possible residential proxy relay - outbound HTTP CONNECT from consumer device"; flow:to_server,established; content:"CONNECT "; depth:8; content:"HTTP/1."; distance:0; fast_pattern; threshold:type threshold, track by_src, count 20, seconds 60; classtype:trojan-activity; metadata: author Arnold Chan, mitre_tactic_id TA0011, mitre_technique_id T1090.002, mitre_technique_id T1090, mitre_technique_id T1584.005; sid:1000015; rev:1;)