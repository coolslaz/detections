alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"LeakySensey: Possible Xray VLESS/REALITY TLS obfuscation - missing SNI indicative of DPI/TSPU evasion"; flow:to_server,established; tls.sni; absent; threshold:type threshold, track by_src, count 10, seconds 300; metadata: author Arnold Chan, created_at 2025-01-01, mitre_technique_id T1572, mitre_technique_id T1090.003; classtype:command-and-control; sid:1000015; rev:1;)