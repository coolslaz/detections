alert tcp $EXTERNAL_NET any -> $HOME_NET [1723,1701] (msg:"LeakySensey: Repeated PPTP/L2TP authentication attempts indicating brute-force activity"; flow:to_server,stateless; tcp.flags:S,12; detection_filter:track by_src, count 20, seconds 120; metadata: attack_id T1110, attack_id T1133, attack_id T1110.003, attack_id T1110.001, author Arnold Chan; classtype:attempted-admin; sid:1000101; rev:1;)