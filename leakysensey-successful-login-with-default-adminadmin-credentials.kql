// Detects successful authentication using the default weak account 'admin' on network device management interfaces (routers, VPN concentrators, NAS units), consistent with LeakySensey's admin/admin credential-spraying monetization pattern
DeviceLogonEvents
| where ActionType == "LogonSuccess"
| where AccountName =~ "admin"
| where LogonType in ("Network", "RemoteInteractive")
| where RemoteIPType == "Public"
| project TimeGenerated, DeviceName, AccountName, RemoteIP, LogonType, ActionType
| summarize LogonCount = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), RemoteIPs = make_set(RemoteIP, 20) by DeviceName, AccountName