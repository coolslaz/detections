alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Ledger Phishing - BIP-39 wordlist fetch from Vercel-hosted phishing endpoint"; flow:to_server,established; http.method; content:"GET"; http.uri; content:"api/bip39-english.txt"; pcre:"/^\/(?:[a-z0-9_\-]+\/)*api\/bip39-english\.txt$/i"; http.host; content:".vercel.app"; endswith; flowbits:set,ledger.bip39.fetch; flowbits:noalert; classtype:credential-theft; metadata: attack_id T1557, attack_id T1566.002, author Arnold Chan; sid:1000101; rev:2;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Ledger Phishing - Secret recovery phrase POST to Vercel endpoint following BIP-39 wordlist fetch"; flow:to_server,established; flowbits:isset,ledger.bip39.fetch; http.method; content:"POST"; http.host; content:".vercel.app"; endswith; classtype:credential-theft; metadata: attack_id T1557, attack_id T1566.002; reference:url,threatlabz.zscaler.com; sid:1000102; rev:2;)