alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Ledger phishing - device fingerprint/interaction telemetry POST to Vercel-hosted page embedded via Google Sites iframe"; flow:to_server,established; http.method; content:"POST"; http.host; content:".vercel.app"; endswith; http.referer; content:"sites.google.com/view/"; nocase; http.referer; pcre:"/ledger|start-ledger|apps-ledger|download(s)?-ledger/i"; http.request_body; content:"|22|mousemove|22|"; nocase; pcre:"/\x22(keypress|keydown|touchstart|touchmove|fingerprint|deviceInfo|userAgent)\x22/i"; reference:url,https://threatlabz.zscaler.com/blogs/security-research/threat-actors-use-google-ads-target-ledger-users; sid:1000101; rev:2; classtype:trojan-activity; metadata: mitre_technique_id T1497.001, mitre_technique_id T1082, author Arnold Chan;)