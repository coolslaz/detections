alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LiteLLM MCP Auth Bypass Attempt - Malformed Single-Character Bearer Token to /mcp/"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/mcp/"; http.header; pcre:"/Authorization\x3a\s*Bearer\s+[!-~]\r?$/mi"; http.request_body; content:"jsonrpc"; content:"initialize"; distance:0; flowbits:set,litellm.mcp.malformed_bearer; flowbits:noalert; reference:url,wiz.io; metadata: info "Tightened into a two-stage flowbits detection: the request-side rule only sets state (flowbits:noalert) on a malformed-token attempt; the visible alert now requires the server response to actually confirm the bypass (HTTP 200 + mcp-session-id header), cutting false positives from attempts that simply fail.", author "Arnold Chan", created_at 2026-08-30, mitre_tactic_id TA0001, mitre_technique_id T1210, cve CVE-2026-59822; classtype:attempted-admin; reference:cve,2026-59822; sid:1000201; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LiteLLM MCP Auth Bypass Confirmed - Session Established After Malformed Bearer Token (CVE-2026-59822)"; flow:to_client,established; flowbits:isset,litellm.mcp.malformed_bearer; http.stat_code; content:"200"; http.header_names; content:"mcp-session-id"; reference:url,wiz.io; metadata: author "detections.ai", created_at 2026-08-30, mitre_tactic_id TA0001, mitre_technique_id T1210, cve CVE-2026-59822; classtype:attempted-admin; sid:1000202; rev:1;)