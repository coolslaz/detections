// Detects MCP tool invocations on a LiteLLM proxy performed under an empty/blank credential (auth-bypass indicator)
// against MCP servers exposed via allow_all_keys, reaching sensitive integrations (databases, GitHub, Slack, CI/CD)
// Tightened: replaced the invalid AzureDiagnostics source with ContainerLogV2; require an actual
// tools/call invocation (not just an incidental keyword match) and an explicit allow_all_keys=true
// (previously defaulted to alerting whenever that field was simply absent from the record).
let sensitiveTools = dynamic(["database", "github", "slack", "ci/cd", "cicd", "jira"]);
union isfuzzy=true
    (AppRequests | where isnotempty(Url)),
    (ContainerLogV2 | where ContainerName has "litellm")
| where Url has "/mcp/" or LogMessage has "/mcp/"
| extend ApiKeyUsed = coalesce(column_ifexists("ApiKey", ""), column_ifexists("AuthorizationHeader", ""))
| where isempty(ApiKeyUsed)
| where (LogMessage has "tools/call" or Url has "tools/call")
| where LogMessage has_any (sensitiveTools) or Url has_any (sensitiveTools)
| extend AllowAllKeys = column_ifexists("allow_all_keys", "")
| where AllowAllKeys =~ "true"
| project TimeGenerated, Url, LogMessage, ApiKeyUsed, AllowAllKeys
| sort by TimeGenerated desc