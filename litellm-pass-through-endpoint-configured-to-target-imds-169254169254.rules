alert http any any -> any any (msg:"LiteLLM pass-through endpoint configured to target IMDS 169.254.169.254"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/config/pass_through_endpoint"; http.request_body; content:"169.254.169.254"; fast_pattern; metadata: author "Arnold Chan", created_at 2026-08-30, mitre_technique_id T1552.005, mitre_technique_id T1528; reference:url,https://www.wiz.io/blog/litellm-vulnerabilities; classtype:attempted-recon; sid:1000001; rev:1;)

# Tightened: fixed direction/port (was $EXTERNAL_NET:4000, which doesn't correspond to the actual
# proxy-to-IMDS flow) and dropped the separate blanket "any IP traffic to 169.254.169.254" rule, which
# had no content match and would fire on all normal instance-metadata traffic from any process on the host.
alert http $HOME_NET any -> 169.254.169.254 any (msg:"LiteLLM proxy retrieving IAM credentials from IMDS security-credentials path via pass-through endpoint"; flow:to_server,established; http.uri; content:"/meta-data/iam/security-credentials/"; fast_pattern; metadata: author "detections.ai", created_at 2026-08-30, mitre_technique_id T1552.005, mitre_technique_id T1078.004; reference:url,https://www.wiz.io/blog/litellm-vulnerabilities; classtype:credential-theft; sid:1000002; rev:1;)