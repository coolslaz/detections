DeviceProcessEvents
| where FileName in~ ("procdump.exe", "procdump64.exe", "rundll32.exe", "taskmgr.exe", "werfault.exe", "comsvcs.dll")
| where ProcessCommandLine has "lsass"
| where ProcessCommandLine has_any ("full", "MiniDump", "-ma", "MINIDUMP_TYPE")
| where ProcessCommandLine !has "lsass.exe -accepteula"
// Detects processes dumping LSASS process memory (e.g. procdump -ma lsass.exe, comsvcs.dll MiniDump) consistent with the credential theft stage observed in the Fengtai OA compromise chain
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
| union (
    DeviceProcessEvents
    | where InitiatingProcessCommandLine has "lsass" and InitiatingProcessCommandLine has_any ("MiniDump", "comsvcs")
    | project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
)
| union (
    DeviceFileEvents
    | where FileName endswith ".dmp" and FolderPath has "lsass"
    | project TimeGenerated, DeviceName, AccountName = "", FileName, ProcessCommandLine = FolderPath, InitiatingProcessFileName = "", InitiatingProcessCommandLine = ""
)