// Detects PamStealer-style browser credential theft: forced termination of
// per-browser Helper processes to release SQLite file locks, followed by
// launch of a masquerading KcHelper binary carrying KC_* environment markers
// used to access browser keychain items without an authorization prompt.
// Primary anchor is the KcHelper process itself (not observed in legitimate
// software); the browser-helper kill sequence is required as corroborating
// context to reduce false positives from unrelated force-quit/cleanup tools.
DeviceProcessEvents
| where Timestamp > ago(14d)
| where FileName =~ "KcHelper" and FolderPath has "Helpers/Helper_" and FolderPath has "Storage.app"
| where ProcessCommandLine has "KC_PASS" or ProcessCommandLine has "KC_STAGING" or ProcessCommandLine has "KC_SERVICE" or ProcessCommandLine has "KC_ACCOUNT"
| project KcHelperTime = Timestamp, DeviceId, DeviceName, KcHelperPath = FolderPath, KcHelperProcess = FileName, InitiatingProcessFileName, InitiatingProcessFolderPath, AccountName
| join kind=inner (
    DeviceProcessEvents
    | where Timestamp > ago(14d)
    | where ProcessCommandLine has "pkill" and ProcessCommandLine has "-9" and ProcessCommandLine has_any ("Google Chrome Helper", "Brave Browser Helper", "Microsoft Edge Helper", "Chromium Helper", "Vivaldi Helper", "Opera Helper", "Firefox Helper")
    | project DeviceId, PkillTime = Timestamp, PkillCommandLine = ProcessCommandLine
) on DeviceId
| where KcHelperTime between (PkillTime .. (PkillTime + 5m))
| project KcHelperTime, PkillTime, DeviceId, DeviceName, AccountName, KcHelperProcess, KcHelperPath, InitiatingProcessFileName, PkillCommandLine
| sort by KcHelperTime desc