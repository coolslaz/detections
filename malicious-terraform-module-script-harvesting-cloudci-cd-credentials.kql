let FileAccess = DeviceFileEvents
    | where TimeGenerated > ago(14d)
    | where FolderPath has_any (".aws/credentials", ".aws/config", ".azure/credentials", ".config/gcloud", ".netrc", ".npmrc", ".docker/config.json", ".git-credentials", ".ssh/id_rsa")
    | where InitiatingProcessFileName in~ ("dlp.sh", "dlp-docker.sh", "terraform", "terraform.exe", "bash", "sh")
    | where InitiatingProcessCommandLine has_any ("dlp.sh", "dlp-docker.sh", "data.external.telemetry", ".terraform")
    | project TimeGenerated, DeviceName, FileName, FolderPath, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessParentFileName, ReportId;
let EnvHarvesting = DeviceProcessEvents
    | where TimeGenerated > ago(14d)
    | where FileName in~ ("dlp.sh", "dlp-docker.sh")
       or ProcessCommandLine has_any ("dlp.sh", "dlp-docker.sh")
    | where ProcessCommandLine has_any ("env", "printenv", "AWS_", "AZURE_", "GCP_", "OPENAI_API_KEY", "ANTHROPIC_API_KEY", "CI_", "CIRCLECI", "GITHUB_TOKEN", "GITLAB_TOKEN", "NETLIFY_AUTH_TOKEN", "NPM_TOKEN", "DOCKER_PASSWORD")
    | project TimeGenerated, DeviceName, FileName, FolderPath=ProcessCommandLine, InitiatingProcessFileName=InitiatingProcessFileName, InitiatingProcessCommandLine=ProcessCommandLine, InitiatingProcessParentFileName=InitiatingProcessParentFileName, ReportId;
FileAccess
| union EnvHarvesting
| sort by TimeGenerated desc