// Detects batch validation of app-embedded OAuth client credentials / API keys extracted via APK/IPA decompilation.
// Pattern: a source IP authenticates as many distinct service principals/app client IDs in a short window with a
// meaningful failure rate, consistent with harvested-secret validation sweeps (T1552.001, T1588.001).
// Legitimate multi-tenant SaaS integrations, API gateways, and corporate NAT/proxy egress commonly present many
// distinct AppIds from one IP but are almost always successful and originate from long-established, recurring IPs.
let lookback = 14d;
let window = 1h;
let minDistinctAppIds = 40;
let minAttempts = 60;
let minFailureRatio = 0.15;
let baselineDaysThreshold = 10;
// Build an allowlist of IPs seen consistently over the long baseline window (established corporate/proxy/gateway egress).
let KnownRecurringIPs =
    AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(lookback)
    | summarize DaysActive = dcount(bin(TimeGenerated, 1d)) by IPAddress
    | where DaysActive >= baselineDaysThreshold
    | project IPAddress;
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(1d)
| extend IsFailure = iff(ResultType != 0 and ResultType != 0, true, false)