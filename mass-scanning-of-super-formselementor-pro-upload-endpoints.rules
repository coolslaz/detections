alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"High-volume automated scanning of Super Forms/Elementor Pro plugin upload endpoints"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/wp-admin/admin-ajax.php"; fast_pattern; pcre:"/action=(super_submit_form|elementor_pro_forms_send_form|super_create_nonce)/"; threshold:type threshold, track by_src, count 20, seconds 60; classtype:web-application-attack; metadata: attack_id T1595, attack_id T1190; sid:1000101; rev:1;)