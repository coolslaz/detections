alert tls $HOME_NET any -> $EXTERNAL_NET 443 (msg:"Max Messenger possible bulk contact-list upload to api-gost.oneme.ru"; flow:to_server,established; tls.sni; content:"api-gost.oneme.ru"; nocase; endswith; fast_pattern; detection_filter:track by_src, count 3, seconds 60; metadata: author Arnold Chan, mitre_technique_id T1119, mitre_technique_id T1005, mitre_technique_id T1636.003; classtype:policy-violation; sid:1000201; rev:1;)