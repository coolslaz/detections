// Analysts: verify matches against known-legitimate MeshAgent/RMM deployment inventories (e.g., authorized IT RMM installs) before escalating.
let SettraC2 = dynamic(["45.13.122.7", "193.5.65.114"]);
let SettraWorkstationId = "WIN-LIVFRVQFMKO";
let MeshAgentProcs = DeviceProcessEvents
| where FileName =~ "mvtcs.exe" or ProcessCommandLine has "MeshAgent" or FolderPath has "MeshAgent"
| extend IsPrimarySignal = (FileName =~ "mvtcs.exe")
| project TimeGenerated, DeviceId, DeviceName, FileName, FolderPath, ProcessCommandLine, InitiatingProcessFileName, AccountName, SHA256, IsPrimarySignal;
// Path 1: C2 network correlation is mandatory (inner join) - generic MeshAgent string match only qualifies when combined with confirmed beaconing to known Settra C2 IPs.
let C2Correlated = MeshAgentProcs
| join kind=inner (
    DeviceNetworkEvents
    | where RemoteIP in (SettraC2)
    | project DeviceId, RemoteIP, RemotePort, RemoteUrl, NetworkTimestamp = TimeGenerated
) on DeviceId
| where IsPrimarySignal or isnotempty(RemoteIP)
| extend MatchReason = "C2 Connection Detected";