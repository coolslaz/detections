// Detects the Mini Shai-Hulud sequence: Bun runtime launches the hidden index.js payload
// from a compromised actions-cool/* action path, scoped to the GitHub Actions workflow context,
// AND is correlated with either a secret/env-read event or an outbound network connection from
// the same process tree within a short time window. Requires the correlation - neither signal alone.
let lookback = 30d;
let corr_window = 5m;
let bun_index_js = DeviceProcessEvents
| where Timestamp > ago(lookback)
| where FileName has_any ("bun", "bun.exe")
| where ProcessCommandLine has "index.js"
| where ProcessCommandLine has "GITHUB_ACTION_PATH"
| where FolderPath has_any ("issues-helper", "maintain-one-comment") or ProcessCommandLine has_any ("issues-helper", "maintain-one-comment")
| project BunTime = Timestamp, DeviceId, DeviceName, BunProcessId = ProcessId, BunCommandLine = ProcessCommandLine, InitiatingProcessAccountName;
let secret_access = DeviceProcessEvents
| where Timestamp > ago(lookback)
| where ProcessCommandLine has_any ("GITHUB_TOKEN", "env", "printenv", "secrets", "ACTIONS_RUNTIME_TOKEN", "process.env")
| project EventTime = Timestamp, DeviceId, LinkProcessId = InitiatingProcessId, EvidenceCommandLine = ProcessCommandLine, EvidenceType = "secret_access";
let net_activity = DeviceNetworkEvents
| where Timestamp > ago(lookback)
| where InitiatingProcessFileName has_any ("bun", "bun.exe") or InitiatingProcessCommandLine has "index.js"
| project EventTime = Timestamp, DeviceId, LinkProcessId = InitiatingProcessId, EvidenceCommandLine = strcat(RemoteUrl, " ", tostring(RemoteIP), ":", tostring(RemotePort)), EvidenceType = "network_connection";
let correlated_evidence = union secret_access, net_activity;
bun_index_js
| join kind=inner (correlated_evidence) on DeviceId
| where EventTime between (BunTime .. (BunTime + corr_window))
| where LinkProcessId == BunProcessId or EvidenceCommandLine has "bun"
| summarize EvidenceTypes = make_set(EvidenceType), EvidenceSamples = make_set(EvidenceCommandLine, 5), FirstEvidenceTime = min(EventTime) by BunTime, DeviceId, DeviceName, InitiatingProcessAccountName, BunCommandLine
| where array_length(EvidenceTypes) > 0
| sort by BunTime asc