// Detects exploitation of an exposed MinIO object storage endpoint using default credentials to retrieve stored credential files from an internal bucket
let ProcessEvents = DeviceProcessEvents
| where TimeGenerated > ago(14d)
| where ProcessCommandLine has_any ("minioadmin", "mc alias set", "mc cp", "mc config host add") 
| where ProcessCommandLine has "minioadmin:minioadmin" // literal default admin:secret pair, not just the word "minioadmin"
| where ProcessCommandLine has_any ("credentials", ".env", "secrets", "config.json", ".aws/credentials", "password")
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName;
let NetworkEvents = DeviceNetworkEvents
| where TimeGenerated > ago(14d)
| where RemotePort in (9000, 9001) // default MinIO API/console ports
| where ActionType in ("ConnectionSuccess")
// Tightened: only correlate connections that also carry the literal default-credential string, not all MinIO traffic
| where InitiatingProcessCommandLine has "minioadmin:minioadmin"
| project TimeGenerated, DeviceName, AccountName = InitiatingProcessAccountName, FileName = InitiatingProcessFileName, ProcessCommandLine = InitiatingProcessCommandLine, InitiatingProcessFileName;
ProcessEvents
| union NetworkEvents
| sort by TimeGenerated desc