alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"NDR Autonomous internet-wide recon pipeline - high rate distinct service probing"; flow:to_server; flags:S; threshold:type both, track by_src, count 200, seconds 60; classtype:attempted-recon; metadata: attack_id T1595.002, attack_id T1596, data_source NDR, author Arnold Chan; reference:url,detections.ai; sid:1000101; rev:2;)

alert tcp $SCANNER_IPS any -> $EXTERNAL_NET any (msg:"NDR Bulk service probing - known internal scanner source, suppressed"; flow:to_server; flags:S; threshold:type both, track by_src, count 200, seconds 60; noalert; classtype:attempted-recon; metadata: attack_id T1595.002, attack_id T1596, data_source NDR; sid:1000104; rev:1;)

alert http any any -> $EXTERNAL_NET any (msg:"NDR Exposed-panel fingerprinting probe pattern from single source"; flow:to_server,established; http.method; content:"GET"; http.uri; content:"/login"; nocase; http.user_agent; content:!"Pingdom"; nocase; http.user_agent; content:!"UptimeRobot"; nocase; http.user_agent; content:!"StatusCake"; nocase; http.user_agent; content:!"ELB-HealthChecker"; nocase; http.user_agent; content:!"GoogleHC"; nocase; http.user_agent; content:!"HealthCheck"; nocase; threshold:type both, track by_src, count 100, seconds 60; classtype:attempted-recon; metadata: attack_id T1595.002, attack_id T1596, data_source NDR; sid:1000102; rev:2;)

alert http any any -> $EXTERNAL_NET any (msg:"NDR Automated attack-surface mapping - repeated favicon/admin panel fingerprinting requests"; flow:to_server,established; http.uri; content:"/favicon.ico"; http.user_agent; content:!"Googlebot"; nocase; http.user_agent; content:!"bingbot"; nocase; http.user_agent; content:!"Pingdom"; nocase; http.user_agent; content:!"UptimeRobot"; nocase; http.user_agent; content:!"StatusCake"; nocase; threshold:type both, track by_src, count 200, seconds 60; classtype:attempted-recon; metadata: attack_id T1595.002, attack_id T1596, data_source NDR; sid:1000103; rev:2;)