alert http $HOME_NET any -> $EXTERNAL_NET 443 (msg:"NeedyMantis C2 HTTP-to-WebSocket upgrade with anomalous firefox/21.0 user-agent"; flow:to_server,established; http.method; content:"GET"; http.user_agent; content:"firefox/21.0"; startswith; endswith; http.header; content:"Upgrade|3a| websocket"; nocase; metadata: author Arnold Chan, mitre_tactic_id TA0011, mitre_technique_id T1071.001, mitre_technique_id T1573; reference:url,microsoft.com/security/blog; classtype:command-and-control; sid:1000501; rev:1;)