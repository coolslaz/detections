alert http $HOME_NET any -> $EXTERNAL_NET 443 (msg:"NeedyMantis HTTPS-to-WebSocket C2 beacon with anomalous client-side Set-Cookie recon exfil"; flow:to_server,established; http.method; content:"GET"; http.uri; content:"/library/zip/"; startswith; fast_pattern; http.header; content:"Upgrade|3a| websocket"; nocase; http.header; content:"Set-Cookie|3a|"; nocase; metadata: author Arnold Chan, created_at 2026-05-30, mitre_tactic_id TA0011, mitre_technique_id T1071.001, mitre_technique_id T1082, mitre_technique_id T1057; classtype:command-and-control; reference:url,https://www.microsoft.com/en-us/security/blog/2026/09/28/needymantis-unpacking-a-post-compromise-malware-family-used-in-targeted-operations/; reference:url,https://thehackernews.com/2026/09/hackers-use-needymantis-to-maintain.html; sid:1000601; rev:1;)