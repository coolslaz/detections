alert http $HOME_NET any -> $EXTERNAL_NET 443 (msg:"NeedyMantis-style C2 beacon - WebSocket upgrade with hard-coded firefox/21.0 user-agent"; flow:to_server,established; http.method; content:"GET"; http.user_agent; content:"firefox/21.0"; startswith; endswith; http.header; content:"Upgrade|3a| websocket"; nocase; metadata: author Arnold Chan, description "ip address, domain and malicious url", mitre_tactic_id TA0011, mitre_technique_id T1071.001, mitre_technique_id T1027; classtype:command-and-control; reference:url,https://www.microsoft.com/en-us/security/blog/2026/09/28/needymantis-unpacking-a-post-compromise-malware-family-used-in-targeted-operations/; reference:url,https://thehackernews.com/2026/09/hackers-use-needymantis-to-maintain.html; sid:1000301; rev:1;)