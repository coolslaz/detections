// Identifies NetScaler ADC/Gateway software inventory entries reporting versions
// that only received the August CVE-2026-19490 fix (14.1-73.32 / 13.1-63.21)
// and remain exposed to CVE-2026-88771 / CVE-2026-88772 until upgraded to
// 14.1-73.37 / 13.1-64.23 or later.
DeviceTvmSoftwareInventory
| where SoftwareName has "netscaler"
| where SoftwareName has_any ("adc", "gateway")
| where SoftwareVersion in ("14.1-73.32", "13.1-63.21")
| project Timestamp, DeviceId, DeviceName, SoftwareName, SoftwareVersion