// Detects the post-compromise sequence described for CVE-2026-88771/CVE-2026-88772:
// (1) risky/anomalous authentication from a NetScaler ADC/Gateway-associated account,
// (2) followed within 1 hour by VPN/remote-access session establishment for that same account,
// (3) followed within 1 hour by a burst of outbound connections from the appliance.
// Requiring all three correlated signals (rather than any single one) suppresses routine
// admin logins, scheduled VPN use, and normal telemetry/update traffic.
let lookback = 1d;
let min_outbound_conns = 20;
let suspicious_signins = SigninLogs
| where TimeGenerated > ago(lookback)
| where AppDisplayName has_any ("NetScaler", "Citrix ADC", "Citrix Gateway")
| where ResultType == 0
| where RiskLevelDuringSignIn in ("high", "medium") or IsInteractive == false
| project SigninTime = TimeGenerated, UserPrincipalName, IPAddress, RiskLevelDuringSignIn;
let vpn_sessions = CommonSecurityLog
| where DeviceVendor =~ "Citrix" and DeviceProduct has_any ("NetScaler Gateway", "NetScaler ADC")
| where Activity has_any ("VPN session established", "SSLVPN Logon")
| project VpnTime = TimeGenerated, SourceUserName, SourceIP;
let outbound_bursts = CommonSecurityLog
| where DeviceVendor =~ "Citrix"
| where isnotempty(DestinationIP)
| summarize ConnCount = count(), BurstStart = min(TimeGenerated) by SourceIP, TimeBucket = bin(TimeGenerated, 1h)
| where ConnCount > min_outbound_conns;
suspicious_signins
| join kind=inner (vpn_sessions) on $left.UserPrincipalName == $right.SourceUserName
| where VpnTime between (SigninTime .. SigninTime + 1h)
| join kind=inner (outbound_bursts) on $left.IPAddress == $right.SourceIP
| where BurstStart between (VpnTime .. VpnTime + 1h)
| project SigninTime, UserPrincipalName, IPAddress, RiskLevelDuringSignIn, VpnTime, ConnCount, BurstStart
| sort by SigninTime desc