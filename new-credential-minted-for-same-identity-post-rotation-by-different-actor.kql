// Detects a new API key/credential minted for the SAME target identity whose credential was just rotated/revoked by a DIFFERENT actor, indicating attacker persistence that survives remediation of the originally stolen credential — as opposed to legitimate self-service rotation automation (same actor, same short window).
let lookback = 1h;
AWSCloudTrail
| where EventName in ("CreateAccessKey", "CreateUser", "CreateLoginProfile", "CreateServiceSpecificCredential")
| extend NewKeyActor = UserIdentityArn, NewKeyEventTime = TimeGenerated, NewKeyEventName = EventName, NewKeyRequestParams = RequestParameters
| extend NewKeyTargetUser = tostring(parse_json(NewKeyRequestParams).userName)
| where isnotempty(NewKeyTargetUser)
| where not(NewKeyActor has_any ("credential-rotation", "key-rotation", "cred-rotation", "secrets-rotation", "rotation-automation", "rotation-lambda", "rotation-service-role"))
| join kind=inner (
    AWSCloudTrail
    | where EventName in ("DeleteAccessKey", "UpdateAccessKey", "RemoveUserFromGroup", "DeactivateMFADevice")
    | extend RotationActor = UserIdentityArn, RotationEventTime = TimeGenerated, RotationEventName = EventName
    | extend RotationTargetUser = tostring(parse_json(RequestParameters).userName)
    | where isnotempty(RotationTargetUser)
) on RecipientAccountId
| where NewKeyTargetUser =~ RotationTargetUser
| where NewKeyActor != RotationActor
| where abs(datetime_diff('minute', NewKeyEventTime, RotationEventTime)) <= 60
| project NewKeyEventTime, NewKeyEventName, NewKeyActor, NewKeyTargetUser, NewKeyRequestParams, RotationEventTime, RotationEventName, RotationActor, RotationTargetUser, RecipientAccountId, SourceIpAddress
| sort by NewKeyEventTime desc