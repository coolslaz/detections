alert tls $SERVER_NET any -> $EXTERNAL_NET any (msg:"Outbound TLS connection to Microsoft Dev Tunnels (devtunnels.ms) from server-role asset - possible covert C2 tunneling"; flow:to_server,established; tls.sni; content:"devtunnels.ms"; nocase; endswith; metadata: author Arnold Chan, mitre_tactic_id TA0011, mitre_technique_id T1572, mitre_technique_id T1090.002, scope Exchange_OWA_DomainControllers_only, note Exclude_hosts_with_dev-tunnels.exe_or_Visual_Studio_process_activity_if_that_context_is_available; classtype:trojan-activity; sid:1000101; rev:2;)