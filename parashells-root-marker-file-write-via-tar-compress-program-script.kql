union (DeviceProcessEvents | where TimeGenerated > ago(7d) | where FileName in~ ("tar", "sh", "bash") | where ProcessCommandLine has "UCP_UID" or ProcessCommandLine has "UCP_USER" or ProcessCommandLine has "ACTOR=" | where InitiatingProcessFileName =~ "prl_disp_service" or ProcessCommandLine has "--use-compress-program" | // The marker is only meaningful as privilege-escalation evidence when it's actually written as root
where AccountName =~ "root" or InitiatingProcessAccountName =~ "root" | project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessAccountName), (DeviceFileEvents | where TimeGenerated > ago(7d) | where FileName has_any ("marker", "ucp") | where InitiatingProcessCommandLine has "UCP_UID" or InitiatingProcessCommandLine has "UCP_USER" or InitiatingProcessCommandLine has "ACTOR=" | project TimeGenerated, DeviceName, AccountName = InitiatingProcessAccountName, FileName, ProcessCommandLine = InitiatingProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessAccountName) | sort by TimeGenerated desc