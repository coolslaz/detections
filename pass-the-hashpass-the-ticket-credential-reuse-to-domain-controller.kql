// Detects credential reuse (Pass-the-Hash, Pass-the-Ticket, Overpass-the-Hash) where a NewCredentials
// (runas /netonly style) logon on a host is followed shortly after by an NTLM or Kerberos network logon
// from that same host/account to another machine (typically a domain controller) without an interactive
// logon in between - the hallmark of reusing dumped hashes/tickets rather than a normal user session.
let lookback = 10m;
// Populate with your domain controller hostnames to scope reuse specifically to DCs, e.g. dynamic(["DC01", "DC02"])
let DomainControllers = dynamic([]);
let StagingLogons = DeviceLogonEvents
| where TimeGenerated > ago(7d)
| where LogonType == "NewCredentials"
| where not(AccountName endswith "$")
| project StageTime = TimeGenerated, StageDeviceId = DeviceId, StageDeviceName = DeviceName, AccountName, AccountDomain, AccountSid;
let ReuseLogons = DeviceLogonEvents
| where TimeGenerated > ago(7d)
| where LogonType in ("Network", "RemoteInteractive") and Protocol in ("Ntlm", "Kerberos")
| where not(AccountName endswith "$")
| where IsLocalAdmin == true
| where array_length(DomainControllers) == 0 or DeviceName in (DomainControllers)
| project ReuseTime = TimeGenerated, ReuseDeviceId = DeviceId, ReuseDeviceName = DeviceName, AccountName, AccountDomain, AccountSid, Protocol, RemoteIP, IsLocalAdmin;
StagingLogons
| join kind=inner (ReuseLogons) on AccountName, AccountDomain
| where ReuseTime > StageTime and (ReuseTime - StageTime) <= lookback
| where ReuseDeviceId != StageDeviceId
| project StageTime, StageDeviceName, ReuseTime, ReuseDeviceName, AccountName, AccountDomain, Protocol, RemoteIP, IsLocalAdmin
| sort by ReuseTime desc;