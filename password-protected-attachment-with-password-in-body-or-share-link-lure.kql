let PasswordHints = dynamic(["password:", "password is", "pwd:", "the password", "open password", "pass:"]);
EmailAttachmentInfo
| where FileType in~ ("zip", "pdf", "docx", "xlsx", "7z", "rar")
| where isnotempty(SenderFromAddress)
| join kind=inner (
    EmailEvents
    | where isnotempty(NetworkMessageId)
) on NetworkMessageId
| extend BodyLower = tolower(tostring(NetworkMessageId))
| join kind=inner (
    EmailEvents
    | extend BodyText = tolower(tostring(Subject))
) on NetworkMessageId
| where AttachmentCount >= 1
| where UrlCount >= 1 or Subject has_any ("share", "shared", "secure document", "view document")
| where Subject has_any (PasswordHints) or Subject has_any ("protected", "secure")
| project TimeGenerated, NetworkMessageId, SenderFromAddress, RecipientEmailAddress, Subject, FileName, FileType, UrlCount, AttachmentCount
| summarize Recipients = make_set(RecipientEmailAddress, 50), Attachments = make_set(FileName, 20) by NetworkMessageId, SenderFromAddress, Subject, UrlCount, TimeGenerated
| where array_length(Attachments) > 0