// Detects a password-spray signature against manager/senior-titled accounts: many distinct
// manager/senior accounts targeted from the same source IP/ASN within a short window, each
// with a low per-account attempt count (spray characteristic, not single-account brute force),
// consistent with TeamFiltration operators selectively weighting privileged accounts within a
// broader spray sweep
let lookback = 1d;
let window = 1h;
let managerTerms = dynamic(["manager", "mgr", "director", "gerente", "jefe", "vp.", "vicepresidente", "ceo", "cfo", "coo"]);
SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType in ("50126", "50053", "50055", "50076") // failed sign-in / lockout / MFA-required result codes
| extend IsManagerAccount = UserPrincipalName has_any (managerTerms) or UserDisplayName has_any (managerTerms)
| where IsManagerAccount
| summarize
    AttemptsPerAccount = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by IPAddress, UserPrincipalName, bin(TimeGenerated, window)
| where AttemptsPerAccount <= 5 // low per-account attempt count - spray, not brute force on one account
| summarize
    DistinctManagerAccounts = dcount(UserPrincipalName),
    TargetedAccounts = make_set(UserPrincipalName, 50),
    TotalAttempts = sum(AttemptsPerAccount),
    AvgAttemptsPerAccount = avg(AttemptsPerAccount),
    FirstSeen = min(FirstSeen),
    LastSeen = max(LastSeen)
    by IPAddress, bin(FirstSeen, window)
| where DistinctManagerAccounts >= 10 // same source IP hitting many distinct manager/senior accounts
| where AvgAttemptsPerAccount <= 3 // reinforces spray pattern: low attempts per account, not lockout/typo repetition
| project FirstSeen, LastSeen, IPAddress, DistinctManagerAccounts, TotalAttempts, AvgAttemptsPerAccount, TargetedAccounts
| sort by DistinctManagerAccounts desc