// Detect PEEP Smart Bookmarks extension using native messaging bridge to extract browser artifacts (cookies, history, credentials, session data)
let PEEP_Process = DeviceProcessEvents
| where FileName =~ "nm_host.exe"
| where InitiatingProcessFileName has_any ("chrome.exe", "msedge.exe")
| where ProcessCommandLine has_any ("ejkndncpkdcjcikfhiamcdehdoegilbj", "bibjjhidpdmfcbkodddndmoejcloobdh") or FolderPath has "com.peep.lab"
| extend MatchedIndicator = "nm_host.exe spawned by browser process, anchored to PEEP extension ID or com.peep.lab path";
let PEEP_Registry = DeviceRegistryEvents
| where RegistryKey has "NativeMessagingHosts"
| where RegistryKey has "com.peep.lab" or RegistryValueData has "com.peep.lab"
| extend MatchedIndicator = "com.peep.lab native messaging host registration";
let PEEP_File = DeviceFileEvents
| where FolderPath has_any (@"%LOCALAPPDATA%\\PEEP\\crx", "LOCALAPPDATA\\PEEP\\crx")
| extend MatchedIndicator = "PEEP CRX staged in LOCALAPPDATA";
let PEEP_Extension = DeviceProcessEvents
| where ProcessCommandLine has_any ("ejkndncpkdcjcikfhiamcdehdoegilbj", "bibjjhidpdmfcbkodddndmoejcloobdh")
| extend MatchedIndicator = "Smart Bookmarks extension ID reference (primary or alternate build)";
union PEEP_Process, PEEP_Registry, PEEP_File, PEEP_Extension
| project TimeGenerated, DeviceName, AccountName, FileName, FolderPath, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, RegistryKey, RegistryValueData, MatchedIndicator
| sort by TimeGenerated desc