alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Phantom Deal - repeated manual access from many distinct source IPs to tracked canary token resource"; flow:to_server,established; http.method; content:"GET"; http.uri; pcre:"/^\/[0-9a-f]{20,}(\/|$)/i"; threshold:type threshold, track by_dst, count 49, seconds 2073600; metadata: author Arnold Chan, created_at 2025-01-01, mitre_technique_id T1071, campaign Phantom_Deal, threat_actor Phantom_Deal; classtype:trojan-activity; sid:1000201; rev:2;)