let SuspiciousKeywords = dynamic(["verify your account","confirm your details","password","invoice","wire transfer","urgent response required","hr survey","it helpdesk"]);
EmailEvents
| where TimeGenerated > ago(24h)
| where DeliveryLocation != "Failed" // successfully delivered inbound mail
| extend SenderDomain = tostring(split(SenderFromAddress, "@")[1])
| extend ReplyToAddress = tostring(parse_json(AdditionalFields).ReplyToAddress)
| extend ReplyToDomain = tostring(split(ReplyToAddress, "@")[1])
| extend ReplyToMismatch = isnotempty(ReplyToDomain) and ReplyToDomain != SenderDomain
| extend SubjectLower = tolower(Subject)
| extend HasSuspiciousKeyword = SubjectLower has_any (SuspiciousKeywords)
| where HasSuspiciousKeyword or ReplyToMismatch
| where AttachmentCount == 0 and UrlCount == 0
| summarize RecipientCount = dcount(RecipientEmailAddress),
            Recipients = make_set(RecipientEmailAddress, 50),
            SuspiciousKeywordHits = countif(HasSuspiciousKeyword),
            ReplyToMismatchCount = countif(ReplyToMismatch),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by SenderFromAddress, SenderDomain, bin(TimeGenerated, 1h)
| where RecipientCount >= 5
| where ReplyToMismatchCount > 0 or SuspiciousKeywordHits > 0
| order by RecipientCount desc