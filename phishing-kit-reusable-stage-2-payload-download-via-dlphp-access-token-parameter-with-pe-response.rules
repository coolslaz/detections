alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Phishing kit reusable stage-2 payload download via dl.php access-token parameter with PE response"; flow:to_server,established; http.method; content:"GET"; http.uri; content:"dl.php?f="; fast_pattern; http.uri; content:"&k=nfe_valid_key"; distance:0; pcre:"/dl\.php\?f=[^&]+\.exe&k=nfe_valid_key/i"; file.data; content:"MZ"; startswith; metadata: author Arnold Chan, created_at 2026-07-21, updated_at 2026-07-21, mitre_technique_id T1566.002, false_positives "Rare; requires exact dl.php URL with nfe_valid_key access-token AND a Windows PE (MZ) executable in the HTTP response body, eliminating generic PHP download or token-only matches"; classtype:trojan-activity; sid:1000201; rev:2;)