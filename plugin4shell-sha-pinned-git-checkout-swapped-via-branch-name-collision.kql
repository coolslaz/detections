let lookback = 10m;
let AgentProcs = dynamic(["claude.exe","claude-code.exe","codex.exe","gh.exe","copilot.exe","gemini.exe","gemini-cli.exe"]);
let AgentTokens = dynamic(["claude","claude-code","codex","copilot","gemini","gemini-cli"]);
let CloneFetchEvents =
    DeviceProcessEvents
    | where FileName =~ "git.exe"
    | where ProcessCommandLine has "clone" or ProcessCommandLine has "fetch"
    | where InitiatingProcessFileName in~ (AgentProcs)
        or (InitiatingProcessFileName =~ "node.exe" and InitiatingProcessCommandLine has_any (AgentTokens))
    | extend RepoHost = extract(@"(?:https?://|git@|ssh://(?:git@)?)([a-zA-Z0-9_\.\-]+)", 1, ProcessCommandLine)
    | where isnotempty(RepoHost) and RepoHost != "github.com"
    | project CloneFetchTimestamp = TimeGenerated, DeviceId, InitiatingProcessId, DeviceName, CloneFetchCommandLine = ProcessCommandLine, RepoHost;
DeviceProcessEvents
| where FileName =~ "git.exe"
| where ProcessCommandLine has "checkout"
| where InitiatingProcessFileName in~ (AgentProcs)
    or (InitiatingProcessFileName =~ "node.exe" and InitiatingProcessCommandLine has_any (AgentTokens))
| extend CheckoutRef = extract(@"checkout\s+(FETCH_HEAD|[0-9a-fA-F]{40})\b", 1, ProcessCommandLine)
| where isnotempty(CheckoutRef)
| join kind=inner (CloneFetchEvents) on DeviceId, InitiatingProcessId
| where CloneFetchTimestamp between ((TimeGenerated - lookback) .. TimeGenerated)
| project
    TimeGenerated,
    DeviceId,
    DeviceName,
    AccountName,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    CheckoutCommandLine = ProcessCommandLine,
    CheckoutRef,
    CloneFetchTimestamp,
    CloneFetchCommandLine,
    RepoHost
| sort by TimeGenerated desc