alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Possible AvisLoader executable payload retrieval via Cloudflare Quick Tunnel or Workers.dev host"; flow:established,to_server; http.method; content:"GET"; http.host; pcre:"/\.(trycloudflare\.com|workers\.dev)$/"; fast_pattern; file.data; content:"MZ"; startswith; content:"PE"; distance:0; within:256; metadata: attack_id T1105, attack_id T1204.004, author Arnold Chan; classtype:trojan-activity; sid:1000201; rev:2;)