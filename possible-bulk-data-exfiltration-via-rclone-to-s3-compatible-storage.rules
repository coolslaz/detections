alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Possible Bulk Data Exfiltration via rclone to S3-Compatible Storage"; flow:to_server,established; http.method; content:"PUT"; http.user_agent; content:"rclone/"; fast_pattern; http.host; pcre:"/(?:^|\.)(?:amazonaws\.com|s3\.amazonaws\.com|digitaloceanspaces\.com|backblazeb2\.com|wasabisys\.com|r2\.cloudflarestorage\.com|storage\.googleapis\.com)$/i"; threshold:type threshold, track by_src, count 10, seconds 60; classtype:policy-violation; metadata: attack_id T1567.002, author Arnold Chan; sid:1000101; rev:2;)