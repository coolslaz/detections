alert tls $HOME_NET any -> $EXTERNAL_NET 443 (msg:"Possible Data Exfiltration via Telegram Bot API (T1567.004)"; flow:to_server,established; tls.sni; content:"api.telegram.org"; nocase; detection_filter:track by_src, count 50, seconds 300; classtype:trojan-activity; metadata: attack_id T1567.004, attack_id T1071.001, author Arnold Chan; sid:1000201; rev:2;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Telegram Bot API Token in Outbound HTTP Request URI"; flow:to_server,established; http.host; content:"api.telegram.org"; nocase; http.uri; content:"/bot"; nocase; pcre:"/\/bot[0-9]{6,10}\:[A-Za-z0-9_-]{30,40}\/(sendDocument|sendPhoto)/i"; fast_pattern; http.request_body; bsize:>2048; classtype:trojan-activity; metadata: attack_id T1567.004, attack_id T1071.001; sid:1000202; rev:2;)