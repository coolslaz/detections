alert dns any any -> $HOME_NET any (msg:"Possible DoppelCart-style fake-shop domain churn - repeated .shop DNS responses"; flow:from_server; dns.query; content:".shop"; nocase; endswith; dns.opcode:0; detection_filter:track by_dst, count 20, seconds 600; metadata: author Arnold Chan, created_at 2026-09-01, mitre_tactic_id TA0042, mitre_technique_id T1584.001; reference:url,https://detections.ai/inspirations/01a08d8f-e6f3-77a9-a6e6-95dd9ce8a67b; classtype:bad-unknown; sid:1000201; rev:2;)