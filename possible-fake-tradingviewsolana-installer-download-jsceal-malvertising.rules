alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Possible fake TradingView/Solana installer download (JSCeal malvertising)"; flow:to_client,established; http.method; content:"GET"; http.uri; content:"tradingview"; nocase; http.uri; pcre:"/(?i)tradingview.*\.(exe|msi)/"; http.host; content:!"tradingview.com"; nocase; content:!"github.com"; nocase; content:!"githubusercontent.com"; nocase; content:!"sourceforge.net"; nocase; content:!"apps.apple.com"; nocase; content:!"play.google.com"; nocase; content:!"microsoft.com"; nocase; metadata: author Arnold Chan, created_at 2025-01-01, mitre_tactic_id TA0001, mitre_technique_id T1204.002, mitre_technique_id T1583.008; classtype:trojan-activity; sid:1000201; rev:2;)