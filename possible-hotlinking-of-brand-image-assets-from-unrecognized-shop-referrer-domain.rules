alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Possible hotlinking of brand image assets from unrecognized .shop referrer domain"; flow:to_server,established; http.method; content:"GET"; http.uri; pcre:"/\.(jpg|jpeg|png|gif|webp|svg)$/i"; http.header_names; content:"Referer"; http.header; pcre:"/Referer\s*:\s*https?:\/\/(?:[a-z0-9-]+\.)+shop(?:[\/:]|\r?$)/im"; threshold:type limit, track by_src, count 1, seconds 3600; metadata: author Arnold Chan, created_at 2026-09-01, mitre_technique_id T1583.001, mitre_technique_id T1583.006; classtype:policy-violation; sid:1000101; rev:2;)