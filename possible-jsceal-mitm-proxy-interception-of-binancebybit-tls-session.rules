alert tls $HOME_NET any -> $EXTERNAL_NET 443 (msg:"Possible JSCeal MITM proxy interception of Binance/Bybit TLS session"; flow:to_server,established; tls.sni; pcre:"/(?:^|\.)(binance|bybit)\.com$/i"; tls.cert_subject; content:!"O="; tls.cert_issuer; content:!"Let's Encrypt"; content:!"DigiCert"; content:!"Sectigo"; content:!"GlobalSign"; content:!"Amazon"; content:!"Google Trust Services"; content:!"ISRG Root"; content:!"GoDaddy"; metadata: attack_id T1557, attack_id T1565, attack_id T1185, author Arnold Chan; classtype:trojan-activity; sid:1000030; rev:2;)