alert tcp [$HOME_NET,!$MGMT_ALLOWLIST_SRC] [8243,8280,9443] -> [$HOME_NET,!$MGMT_ALLOWLIST_DST] [22,445,3389,5985,5986] (msg:"Possible lateral movement fan-out from compromised WSO2 API Gateway/Traffic Manager host to multiple internal services"; flow:to_server,established; tcp.flags:S; threshold:type threshold, track by_src, count 3, seconds 300; metadata: author Arnold Chan, created_at 2026-09-01, updated_at 2026-09-15, cve CVE-2026-5430, mitre_technique_id T1210, mitre_technique_id T1567, mitre_technique_id T1557, note Requires_MGMT_ALLOWLIST_SRC_and_MGMT_ALLOWLIST_DST_vars_configured_for_known_patch_backup_EDR_hosts, false_positives WSO2_gateway_host_connecting_to_single_allowlisted_management_backup_or_monitoring_host_on_admin_ports; classtype:trojan-activity; reference:url,https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2026-5430; reference:cve,2026-5430; sid:1000201; rev:2;)