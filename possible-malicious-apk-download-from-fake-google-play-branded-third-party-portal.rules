alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Possible malicious APK download from fake Google Play branded third-party portal"; flow:to_client,established; http.uri; content:".apk"; nocase; endswith; http.host; content:!"play.google.com"; content:!"googleapis.com"; content:!"gvt1.com"; content:!"apkpure.com"; content:!"apkmirror.com"; http.header; content:"Content-Type: application/vnd.android.package-archive"; nocase; http.response_body; content:"Google Play"; nocase; fast_pattern; classtype:trojan-activity; metadata: attack_id T1660, attack_id T1476, attack_id T1566.003, author Arnold Chan; sid:1000201; rev:2;)