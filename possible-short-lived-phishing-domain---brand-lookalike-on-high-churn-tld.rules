alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"Possible short-lived phishing domain - brand lookalike on high-churn TLD"; flow:to_server,established; tls.sni; pcre:"/(microsoft|office365|outlook|azure|entra|okta|google|gmail|dropbox|docusign|adobe|paypal|apple|amazon|netflix|chase|wellsfargo|coinbase|facebook|instagram|linkedin)/i"; tls.sni; pcre:"/(login|verify|secure|account|support|signin|auth|update)[a-z0-9-]*\.(top|xyz|icu|buzz|cfd|cf|tk|gq|click|link|sbs|rest)$/i"; metadata: author Arnold Chan, created_at 2026_01_01, mitre_tactic_id TA0001, mitre_technique_id T1566, mitre_technique_id T1583.001, tag suricata; classtype:phishing; reference:url,https://thehackernews.com/2026/09/know-your-enemy-browser-based-attack.html; sid:1000101; rev:2;)