// Detect pg_hba.conf rewritten to allow trust authentication (passwordless) followed by unauthenticated PostgreSQL logins
let PgHbaTrustMod = DeviceFileEvents
| where FileName =~ "pg_hba.conf"
| where ActionType in ("FileModified", "FileCreated", "FileRenamed")
| project ModTime = Timestamp, DeviceName, ModAccount = InitiatingProcessAccountName, ModProcess = InitiatingProcessFileName, FileName, FolderPath;
let PgTrustAuthLogs = Syslog
| where ProcessName has "postgres"
| where SyslogMessage has_any ("authentication method: trust", "trust authentication", "connection authorized") and SyslogMessage !has "password"
| project LogTime = TimeGenerated, Computer, SyslogMessage;
PgHbaTrustMod
| join kind=inner (PgTrustAuthLogs) on $left.DeviceName == $right.Computer
| where LogTime between (ModTime .. datetime_add('hour', 1, ModTime))
| project ModTime, DeviceName, ModAccount, ModProcess, FileName, FolderPath, LogTime, SyslogMessage
| sort by ModTime desc