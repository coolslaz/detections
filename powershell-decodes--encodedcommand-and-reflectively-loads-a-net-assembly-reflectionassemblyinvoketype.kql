DeviceProcessEvents
| where FileName in~ ("powershell.exe", "powershell_ise.exe", "pwsh.exe")
| where InitiatingProcessFileName =~ "conhost.exe" and InitiatingProcessCommandLine has "--headless"
| where ProcessCommandLine has_any ("-EncodedCommand", "-enc", "-e ")
| extend EncodedPortion = extract(@"(?i)-(?:encodedcommand|enc|e)\s+([A-Za-z0-9+/=]{40,})", 1, ProcessCommandLine)
| where isnotempty(EncodedPortion)
| extend DecodedCommand = base64_decode_tostring(EncodedPortion)
| where DecodedCommand has "Reflection.Assem" and DecodedCommand has "Invoke" and DecodedCommand has "[type]"
| project TimeGenerated, DeviceId, DeviceName, AccountName, FileName, ProcessCommandLine, DecodedCommand, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessParentFileName