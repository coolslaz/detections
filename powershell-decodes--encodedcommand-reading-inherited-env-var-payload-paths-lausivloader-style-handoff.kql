DeviceProcessEvents
| where FileName in~ ("powershell.exe", "pwsh.exe")
| where InitiatingProcessFileName =~ "conhost.exe" and InitiatingProcessCommandLine has "--headless"
| where ProcessCommandLine has_any ("-EncodedCommand", "-enc", "-e ")
| extend EncodedPortion = extract(@"(?i)-(?:encodedcommand|enc|e)\s+([A-Za-z0-9+/=]{40,})", 1, ProcessCommandLine)
| where isnotempty(EncodedPortion)
| extend DecodedCommand = base64_decode_tostring(EncodedPortion)
| where DecodedCommand has "GetEnvironmentVariable" and DecodedCommand has "'Process'"
| where DecodedCommand has "ReadAllText" and DecodedCommand has "Remove-Item"
| where DecodedCommand matches regex @"GetEnvironmentVariable\('[A-Za-z]{1,4}\d{2,5}'\s*,\s*'Process'\)"
| project TimeGenerated, DeviceId, DeviceName, AccountName, FileName, ProcessCommandLine, DecodedCommand, InitiatingProcessFileName, InitiatingProcessCommandLine, ProcessId, InitiatingProcessId