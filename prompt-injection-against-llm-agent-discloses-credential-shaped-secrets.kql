// Detects prompt injection attempts against victim-deployed LLM agents/bots that result in disclosure of actual credential-shaped secrets
// Warning: 'LLMAgentTelemetry' is a hypothetical table name. Ensure this maps to the appropriate log source (e.g., custom logs, Sentinel workspace).
let LLMAgentTelemetry = view () { print TimeGenerated=datetime(null), InputText="", OutputText="", AgentId="", UserId="", SourceIP="" | limit 0 };
let SecretValuePattern = @"(AKIA[0-9A-Z]{16}|(?i)(api[_-]?key|secret[_-]?key|access[_-]?token|client[_-]?secret|aws_secret|password|pwd)\s*[:=]\s*['\"]?[A-Za-z0-9/+_\-]{12,}['\"]?|Bearer\s+[A-Za-z0-9\-_\.]{20,}|-----BEGIN\s(RSA|EC|OPENSSH|PGP|PRIVATE)\s?PRIVATE KEY-----)";
let PlaceholderPattern = @"(?i)(akiaiosfodnn7example|example|xxxxxxxx|redacted|your_api_key_here|insert_key_here|dummy|sample|test)";
LLMAgentTelemetry
| where isnotempty(InputText) and isnotempty(OutputText)
| where InputText has_any ("ignore previous instructions", "ignore all prior instructions", "disregard your instructions", "system prompt", "reveal your prompt", "print your instructions", "output your configuration", "jailbreak", "developer mode", "bypass your restrictions")
| where OutputText matches regex SecretValuePattern
| extend InjectionIndicator = extract_all(@"(ignore previous instructions|ignore all prior instructions|disregard your instructions|system prompt|reveal your prompt|print your instructions|output your configuration|jailbreak|developer mode|bypass your restrictions)", InputText)
| extend DisclosureIndicator = extract_all(SecretValuePattern, OutputText)
| mv-expand CandidateSecret = DisclosureIndicator to typeof(string)
// Exclusion 1: well-known placeholder/example credential values are not real disclosures
| where not(CandidateSecret matches regex PlaceholderPattern)
// Exclusion 2: model is merely parroting a dummy secret already present in the injection payload itself
| where not(InputText contains CandidateSecret)
| summarize RealDisclosures = make_set(CandidateSecret, 20) by Timestamp=TimeGenerated, AgentId, UserId, SourceIP, InputText, OutputText, InjectionIndicator
| where array_length(RealDisclosures) > 0
| project Timestamp, AgentId, UserId, SourceIP, InputText, OutputText, InjectionIndicator, DisclosureIndicator=RealDisclosures
| sort by Timestamp desc