// Detects workspace provisioner processes (terraform / coderd provisioner) communicating with the
// lookalike attacker domain coder-infra.com, indicative of exfiltration of user OIDC tokens,
// SSH keys, or external auth provider single-time tokens harvested by the malicious module.
let c2Domains = dynamic(["coder-infra.com", "www.coder-infra.com"]);
let DeviceEvents = DeviceNetworkEvents
| where RemoteUrl has_any (c2Domains) or RemoteUrl contains "coder-infra.com"
| where InitiatingProcessFileName in~ ("terraform", "terraform.exe", "coderd", "coder", "coder.exe", "sh", "bash")
 or InitiatingProcessCommandLine has_any ("terraform", "provisioner", "dlp.sh", "dlp-docker.sh")
| project TimeGenerated, DeviceName, InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, RemoteUrl, RemoteIP;
let DnsQueries = DnsEvents
 | where Name has_any (c2Domains)
 | project TimeGenerated, DeviceName = Computer, InitiatingProcessAccountName = tostring(ClientIP), InitiatingProcessFileName = "dns_query", InitiatingProcessCommandLine = Name, RemoteUrl = Name, RemoteIP = "";
DeviceEvents
| union DnsQueries
| sort by TimeGenerated desc;