// Detects the Global Profit phishing-as-a-service pattern: victims enter credentials and MFA codes on
// spoofed logistics-platform pages, and operators immediately relay them to authenticate against the
// real identity provider from attacker-controlled infrastructure. This surfaces as the same user
// principal completing successful, MFA-satisfied sign-ins from multiple distinct source IPs/locations
// within a short window -- the observable signature of real-time credential/MFA interception feeding
// unauthorized access to shipment/logistics systems.
SigninLogs
| where TimeGenerated > ago(1h)
| where ResultType == 0
| where AuthenticationRequirement == "multiFactorAuthentication"
| extend IPAddr = tostring(IPAddress)
| extend City = tostring(LocationDetails.city)
| extend Country = tostring(LocationDetails.countryOrRegion)
| summarize DistinctIPs = dcount(IPAddr), DistinctCountries = dcount(Country), IPs = make_set(IPAddr, 5), Locations = make_set(strcat(City, ",", Country), 5), SignInTimes = make_list(TimeGenerated, 5), Apps = make_set(AppDisplayName, 5) by UserPrincipalName, bin(TimeGenerated, 15m)
| where DistinctIPs >= 2 and DistinctCountries >= 2
| project bin_TimeGenerated = TimeGenerated, UserPrincipalName, DistinctIPs, DistinctCountries, IPs, Locations, SignInTimes, Apps
| sort by DistinctCountries desc, DistinctIPs desc