// Detects automated wallet-draining pattern: outbound network activity to known stealer C2 shortly after GapiUpdate/NeedleStealer stealer process execution on the same device, consistent with private key compromise followed by automated transaction signing
let stealerProcesses = DeviceProcessEvents
| where (FileName in~ ("GapiUpdate.exe", "Launcher.exe") and FolderPath has @"\Apps\2.0\")
 or ProcessCommandLine has "needle-app"
| project DeviceId, StealerTime = TimeGenerated, StealerFile = FileName;
let exfilConnections = DeviceNetworkEvents
| where RemoteUrl has_any ("diegovalanire.digital", "gapidriver.com") or RemoteUrl has "/api/rest.php" or RemoteUrl has "needle-app/internal/api"
| project DeviceId, ExfilTime = TimeGenerated, RemoteUrl, RemoteIP;
stealerProcesses
| join kind=inner (exfilConnections) on DeviceId
| where ExfilTime between (StealerTime .. (StealerTime + 30m))
| project DeviceId, StealerFile, StealerTime, ExfilTime, RemoteUrl, RemoteIP
| sort by StealerTime asc;