// Detects C2 command channel disguised as legitimate Gitea Prometheus metrics API request
// Pattern: /api/v1/metrics?k=<key>&x=<command>
DeviceNetworkEvents
| where RemoteUrl has "/api/v1/metrics"
| where RemoteUrl has "k=" and RemoteUrl has "x="
| where RemoteUrl matches regex @"/api/v1/metrics\?k=[^&]+&x=[^&\s]+"
| project TimeGenerated, DeviceName, InitiatingProcessFileName, InitiatingProcessCommandLine, RemoteUrl, RemoteIP