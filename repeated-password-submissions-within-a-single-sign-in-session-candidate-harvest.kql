// Detects phishing-kit behavior where multiple password attempts are submitted within the same authentication session/correlation before the session advances to success, consistent with an AiTM kit collecting more than one candidate password.
SigninLogs
| where TimeGenerated > ago(1d)
| where ResultType in ("50126", "0") // 50126 = invalid username or password, 0 = success
| summarize AttemptCount = count(), ResultSet = make_set(ResultType), FirstAttempt = min(TimeGenerated), LastAttempt = max(TimeGenerated) by CorrelationId, UserPrincipalName, IPAddress
| where AttemptCount >= 3
| where datetime_diff('minute', LastAttempt, FirstAttempt) <= 5
| where ResultSet has "0" // session eventually advanced to a successful sign-in
| where ResultSet has "50126" // preceded by at least one rejected password submission
| project UserPrincipalName, IPAddress, CorrelationId, AttemptCount, FirstAttempt, LastAttempt, ResultSet
| sort by AttemptCount desc