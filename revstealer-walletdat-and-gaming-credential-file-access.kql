DeviceFileEvents
| where ActionType in ("FileCreated", "FileModified", "FileRenamed", "FileCopied")
| where FolderPath has_any (
    @"\Bitcoin\wallet.dat",
    @"\Electrum\wallets",
    @"\ElectrumSV\wallets",
    @"Battle.net\Battle.net.config",
    @"Steam\loginusers.vdf",
    @"RobloxCookies.dat",
    @".minecraft\launcher_accounts.json",
    @"Battlestate Games"
)
 or FileName in~ ("wallet.dat", "Battle.net.config", "loginusers.vdf", "RobloxCookies.dat", "launcher_accounts.json")
| where InitiatingProcessFileName !in~ ("steam.exe", "electrum.exe", "electrum-sv.exe", "battle.net.exe", "minecraftlauncher.exe", "robloxplayerbeta.exe", "explorer.exe", "onedrive.exe", "dropbox.exe", "backup.exe", "msmpeng.exe", "searchindexer.exe", "javaw.exe")
| project TimeGenerated, DeviceName, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, FileName, FolderPath, ActionType
| sort by TimeGenerated desc