alert tcp $HOME_NET any -> $EXTERNAL_NET [21,20] (msg:"Possible Network Device PCAP Exfiltration via FTP STOR Command"; flow:to_server,established; content:"STOR"; nocase; startswith; pcre:"/^STOR\s+\S*\.pcap/i"; metadata: author detections.ai, created_at 2026-01-01, mitre_technique_id T1040, mitre_technique_id T1048, mitre_technique_id T1560, mitre_technique_id T1041, actor Fire_Ant, actor UNC3886; classtype:trojan-activity; sid:1000101; rev:1;)