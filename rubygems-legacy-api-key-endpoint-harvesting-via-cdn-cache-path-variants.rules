alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"RubyGems Legacy API Key Endpoint Harvesting via CDN Cache Path Variants"; flow:to_server,established; http.host; content:"rubygems.org"; nocase; http.method; content:"GET"; http.uri; content:"/api/v1/api_key"; http.uri; pcre:"/\/api\/v1\/api_key(\?x=1|\.yaml|\.json)?/"; threshold:type threshold, track by_src, count 8, seconds 120; metadata: author Arnold Chan, created_at 2026-06-01, mitre_technique_id T1552.001, mitre_technique_id T1190, mitre_technique_id T1557, campaign GemStuffer; classtype:web-application-attack; sid:1000101; rev:2;)