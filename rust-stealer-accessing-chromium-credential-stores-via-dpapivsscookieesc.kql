let SuspiciousVssOrDpapi = DeviceProcessEvents
| where TimeGenerated > ago(14d)
| where (FileName in~ ("vssadmin.exe") and ProcessCommandLine has "list" and ProcessCommandLine has "shadows")
    or (ProcessCommandLine has_any ("DPAPI", "MasterKey", "master-key"))
| project TimeGenerated, DeviceId, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, FolderPath, EventType = "ProcessActivity";
let NonBrowserCredentialFileAccess = DeviceFileEvents
| where TimeGenerated > ago(14d)
| where FileName has_any ("Login Data", "Cookies", "Local State", "key4.db", "logins.json")
| where FolderPath has_any ("AppData\\Local\\Google\\Chrome", "AppData\\Local\\Microsoft\\Edge", "AppData\\Roaming\\Mozilla\\Firefox", "AppData\\Local\\BraveSoftware")
| where InitiatingProcessFileName !in~ ("chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "GoogleUpdate.exe", "MicrosoftEdgeUpdate.exe")
| project TimeGenerated, DeviceId, AccountName = InitiatingProcessAccountName, FileName, ProcessCommandLine = InitiatingProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, FolderPath, EventType = "CredentialFileAccess";
SuspiciousVssOrDpapi
| union NonBrowserCredentialFileAccess
| sort by TimeGenerated desc