DeviceFileEvents
| where TimeGenerated > ago(1d)
| where (FileName endswith ".kdbx" or FileName =~ "key4.db" or FileName =~ "logins.json")
 or (FolderPath has "KeePass")
 or (FolderPath has ".ssh" and FileName in~ ("id_rsa", "id_ed25519", "id_ecdsa", "known_hosts", "config"))
 or (FolderPath has_any ("OpenVPN", "WireGuard", "NordVPN", "ExpressVPN", "ProtonVPN") and FileName has_any (".ovpn", ".conf", ".config"))
| where (InitiatingProcessFileName in~ ("GapiUpdate.exe", "GapiUpdate.dll", "Launcher.exe") and InitiatingProcessFolderPath has @"\Apps\2.0\")
 or InitiatingProcessCommandLine has_any ("needle-app", "diegovalanire")
| project TimeGenerated, DeviceName, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, FileName, FolderPath, InitiatingProcessAccountName
| sort by TimeGenerated desc