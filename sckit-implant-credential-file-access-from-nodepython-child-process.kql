// Detects the sckit Go implant (spawned by node or python as a detached child) accessing
// developer credential files/config used for cloud, SCM, and package-registry auth.
// The rule keys on a process named 'sckit' (or launched with 'stage0 --config64' args)
// opening known credential-store paths. Because sckit runs detached with no tty, the file
// access is attributed via DeviceFileEvents' InitiatingProcess* fields, not a separate
// process-creation event, so this stays a single-table query against DeviceFileEvents.
DeviceFileEvents
| where TimeGenerated > ago(1d)
// FileRead only (drop FileAccessed): stat/metadata touches don't disclose secret
// contents and are a major noise source from indexers, AV, and backup agents.
| where ActionType == "FileRead"
| where FileName has_any (
    ".npmrc",
    ".pypirc",
    ".vault-token",
    "id_ecdsa",
    "id_rsa",
    "id_ed25519",
    "credentials.db",
    "access_tokens.json",
    "access_tokens.db",
    "stored_tokens",
    ".git-credentials",
    ".netrc",
    "msal_token_cache"
  )
// Exclude public keys: "id_rsa"/"id_ecdsa"/"id_ed25519" substrings also match the
// non-sensitive *.pub counterpart, which is routinely read by ssh-agent/git and isn't
// a credential.
| where not (FileName endswith ".pub")
| where
    // sckit binary accessed the file directly
    InitiatingProcessFileName =~ "sckit"
    or InitiatingProcessFileName =~ "sckit.exe"
    or InitiatingProcessCommandLine has_all ("stage0", "--config64")
// Exclude sandboxed malware-analysis / test harnesses (authorized-research false
// positive) so intentional detonation in an isolated lab doesn't page on-call.
| where not (FolderPath has_any ("\\test\\", "/test/", "\\sandbox\\", "/sandbox/", "\\quarantine\\", "/quarantine/", "malware-analysis", "malware_analysis"))
| project
    TimeGenerated,
    DeviceId,
    DeviceName,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    InitiatingProcessFolderPath,
    FolderPath,
    FileName,
    SHA256
| order by TimeGenerated desc