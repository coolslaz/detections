alert tls $HOME_NET any -> $EXTERNAL_NET 443 (msg:"ScreenConnect Relay TLS Connection to Known Attacker-Controlled Instance (v2e3e2)"; flow:to_server,established; tls.sni; content:"instance-v2e3e2-relay.screenconnect.com"; nocase; startswith; endswith; metadata: author Arnold Chan, created_at 2025-01-01, mitre_tactic_id TA0011, mitre_technique_id T1219, mitre_technique_id T1071.001; classtype:command-and-control; reference:url,https://isc.sans.edu/diary/ScreenConnect%20Client%20%28Ab%29used%20by%20Attackers/33388; sid:1000020; rev:2;)