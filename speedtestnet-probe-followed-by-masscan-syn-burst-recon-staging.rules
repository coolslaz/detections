alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"Speedtest.net Uplink Check Preceding Recon Scan"; flow:to_server,established; tls.sni; content:"speedtest.net"; nocase; flowbits:set,cameraswarm.speedtest_seen; flowbits:noalert; classtype:attempted-recon; metadata: mitre_tactic_id TA0043, mitre_technique_id T1595.002; sid:1000101; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"Masscan-style High-Volume SYN Scan Following Speedtest Probe"; flow:stateless; flowbits:isset,cameraswarm.speedtest_seen; tcp.flags:S; threshold:type threshold, track by_src, count 100, seconds 10; classtype:attempted-recon; metadata: mitre_tactic_id TA0043, mitre_technique_id T1046, author detections.ai; reference:url,detections.ai/inspirations/01a07437-d96b-77d7-824c-cae874556437; sid:1000102; rev:1;)