alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SSRF - non-browser client requesting UK council ModernGov sites (zzwandshostyard/ssrf.rb pattern)"; flow:to_server,established; http.host; pcre:"/^(moderngov\.lambeth|democracy\.wandsworth|moderngov\.southwark|www\.southwark|www\.wandsworth|www\.lambeth)\.gov\.uk$/i"; http.user_agent; content:"Ruby"; threshold:type threshold, track by_src, count 3, seconds 300; metadata: author Arnold Chan, created_at 2026-05-16, mitre_technique_id T1190, mitre_technique_id T1071.001; classtype:trojan-activity; sid:1000201; rev:2;)