DeviceFileEvents
| where TimeGenerated > ago(1d)
| where FileName in~ ("credentials", "config", "known_hosts", "id_rsa", "id_ed25519", "hosts.yml", ".env")
  or FolderPath has_any (
  "\\.aws\\", "/.aws/",
  "\\.ssh\\", "/.ssh/",
  "\\.kube\\", "/.kube/",
  "\\gh\\hosts.yml", "/gh/hosts.yml",
  "\\.config\\gh\\", "/.config/gh/",
  "\\.terraform\\", "/.terraform/",
  "\\.vercel\\", "/.vercel/",
  "\\.netlify\\", "/.netlify/",
  "\\Cursor\\", "/Cursor/",
  "\\Code\\User\\", "/Code/User/",
  "\\KeePass\\", "/KeePass/"
  )
| where InitiatingProcessFileName !in~ ("code.exe", "explorer.exe", "cursor.exe", "terraform.exe", "gh.exe", "vercel.exe", "netlify.exe", "kubectl.exe", "aws.exe", "keepass.exe", "git.exe", "docker.exe", "OneDrive.exe", "MsMpEng.exe", "SearchIndexer.exe")
| summarize DistinctSensitiveFolders = dcount(FolderPath), FileNames = make_set(FileName, 20), FolderPaths = make_set(FolderPath, 20), AccessCount = count() by DeviceId, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessAccountName
| where DistinctSensitiveFolders >= 3 or InitiatingProcessFileName has_any ("GapiUpdate.exe", "GapiUpdate.dll", "Launcher.exe", "NeedleStealer")
| order by DistinctSensitiveFolders desc