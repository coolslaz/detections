DeviceProcessEvents
| where FileName has_any ("mimikatz.exe", "lazagne.exe", "pypykatz.exe")
 or ProcessCommandLine has_any ("mimikatz", "lazagne", "pypykatz")
 or ProcessCommandLine has_any ("sekurlsa::logonpasswords", "sekurlsa::wdigest", "lsadump::", "privilege::debug", "crypto::")
// Exclude common false-positive sources: authorized red/purple-team tooling paths,
// AV/EDR quarantine handling, and the security agents themselves relaying detections.
// Tune these paths/binaries to your environment's approved testing infrastructure.
| where not(FolderPath has_any (@"\AtomicRedTeam\", @"\PurpleTeam\", @"\PenTest\", @"\Quarantine\"))
| where InitiatingProcessFileName !in~ ("MsMpEng.exe", "MsSense.exe", "SenseIR.exe", "SenseCncProxy.exe", "CSFalconService.exe")
| extend HarvestTool = case(
    ProcessCommandLine has "mimikatz" or FileName =~ "mimikatz.exe" or ProcessCommandLine has_any ("sekurlsa::", "lsadump::", "privilege::debug", "crypto::"), "Mimikatz",
    ProcessCommandLine has "lazagne" or FileName =~ "lazagne.exe", "LaZagne",
    ProcessCommandLine has "pypykatz" or FileName =~ "pypykatz.exe", "pypykatz",
    "Unknown")
| project Timestamp, DeviceName, AccountName, FileName, FolderPath, ProcessCommandLine, HarvestTool, InitiatingProcessFileName, InitiatingProcessCommandLine
| sort by Timestamp desc