// Storm-3168/JADEPUFFER: a compromised service principal whose client secret was exposed in a public GitHub issue (including edit history) cannot be directly observed from cloud/identity telemetry -- this rule detects the observable downstream behavior in the attack chain: a service principal authenticating and then, within a short window, performing broad Azure resource-management enumeration (the reconnaissance phase that immediately follows initial access via a leaked credential).
let LookbackWindow = 2d;
let EnumWindow = 1h;
let KnownBenignAppIds = dynamic([]); // populate with your tenant's known CSPM/scanner/automation service principal AppIds (e.g. Defender for Cloud, Wiz, Qualys, Terraform CI/CD) to exclude routine broad-read automation
let SignIns = AADServicePrincipalSignInLogs
| where TimeGenerated > ago(LookbackWindow)
| where ResultType == "0"
| where AppId !in (KnownBenignAppIds)
| project SignInTime = TimeGenerated, ServicePrincipalId, AppId, ServicePrincipalName, IPAddress;
let Enumeration = AzureActivity
| where TimeGenerated > ago(LookbackWindow)
| where OperationNameValue has_any ("listVirtualMachines", "listSubscriptions", "listResourceGroups", "read")
| where isnotempty(Caller)
| extend ResourceProvider = tostring(split(OperationNameValue, "/")[0])
| project ActTime = TimeGenerated, Caller, CallerIpAddress, OperationNameValue, ResourceProvider, ResourceGroup, SubscriptionId;
SignIns
| join kind=inner (Enumeration) on $left.AppId == $right.Caller
| where ActTime between (SignInTime .. SignInTime + EnumWindow)
| summarize DistinctOperations = dcount(OperationNameValue), DistinctResourceProviders = dcount(ResourceProvider), DistinctSubscriptions = dcount(SubscriptionId), ReadCount = count(), FirstAuth = min(SignInTime), LastEnumeration = max(ActTime), SampleIPs = make_set(IPAddress, 5) by AppId, ServicePrincipalId, ServicePrincipalName
| where DistinctOperations >= 15 and ReadCount >= 50
| where DistinctResourceProviders >= 4 // breadth across resource types distinguishes recon from a narrowly-scoped monitoring tool
| where DistinctSubscriptions >= 2 // cross-subscription enumeration is more indicative of recon than routine per-subscription automation
| sort by ReadCount desc