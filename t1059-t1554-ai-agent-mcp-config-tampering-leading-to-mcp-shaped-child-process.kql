// T1554 - Compromise Client Software Binary: modifying an AI agent client's own MCP/tool configuration to embed an attacker-controlled command/args entry is functionally equivalent to compromising the client software binary, since the client will faithfully execute the tampered configuration the next time it loads.
// T1059 - Command and Scripting Interpreter: the resulting spawned MCP-server process (shell/interpreter/MCP server runtime) is the execution stage triggered by the tampered config.
let lookback = 1d;
let editor_procs = dynamic(["notepad.exe","code.exe","vim","vi","nano","gedit","sublime_text.exe","atom.exe"]);
let agent_ui_procs = dynamic(["claude.exe","cursor.exe","code.exe","windsurf.exe","cline.exe"]);
let mcp_related_terms = dynamic(["mcp","@modelcontextprotocol","npx -y","uvx","mcp-server","mcp_server","server-filesystem","server-github","server-slack","server-postgres"]);
let mcp_runtime_files = dynamic(["node.exe","python.exe","python3.exe","uvx.exe","npx.exe","node","python","uvx","npx"]);
let noise_dirs = dynamic(["node_modules","site-packages","dist","build",".cache"]);
let plausible_config_dirs = dynamic(["AppData\\Roaming",".config",".cursor",".vscode",".continue",".mcp","windsurf","Windsurf","cline","Cline"]);
let mcp_config_files = DeviceFileEvents
| where TimeGenerated > ago(lookback)
| where ActionType in ('FileCreated','FileModified','FileRenamed')
| where not(FolderPath has_any (noise_dirs))
| where (FileName =~ "claude_desktop_config.json")
    or (FolderPath has ".cursor" and FileName =~ "mcp.json")
    or (FolderPath has ".vscode" and FileName =~ "mcp.json")
    or (FolderPath has ".continue" and FileName in~ ("config.json","config.yaml"))
    or (FileName =~ "cline_mcp_settings.json")
    or (FolderPath has_any ("windsurf","Windsurf") and FileName =~ "mcp_config.json")
    or (FileName in~ ("mcp.json","mcp_servers.json") and FolderPath has_any (plausible_config_dirs))
    or (FolderPath has ".mcp" and FileName =~ "config.json")
    or (FolderPath has_any ("crewai","CrewAI") and FileName =~ "agents.yaml")
    or (FileName =~ "OAI_CONFIG_LIST.json" and FolderPath has_any (plausible_config_dirs))
| extend ConfigFileName = FileName, ConfigFolderPath = FolderPath, ModifyingProcessFileName = InitiatingProcessFileName, ModifyingProcessCommandLine = InitiatingProcessCommandLine, ConfigModifiedTime = TimeGenerated
| project DeviceId, ConfigModifiedTime, ConfigFileName, ConfigFolderPath, ModifyingProcessFileName, ModifyingProcessCommandLine;
let agent_child_spawns = DeviceProcessEvents
| where TimeGenerated > ago(lookback)
| where InitiatingProcessFileName in~ (agent_ui_procs)
| where (SpawnedChildCommandLine has_any (mcp_related_terms))
    or (FileName in~ (mcp_runtime_files) and ProcessCommandLine has_any (mcp_related_terms))
| project DeviceId, SpawnTime = TimeGenerated, AccountName, DeviceName, SpawnedChildFileName = FileName, SpawnedChildCommandLine = ProcessCommandLine, ParentFileName = InitiatingProcessFileName;
mcp_config_files
| join kind=inner (agent_child_spawns) on DeviceId
| where SpawnTime > ConfigModifiedTime and SpawnTime - ConfigModifiedTime <= 5m
| extend Confidence = case(
    not(ModifyingProcessFileName has_any (agent_ui_procs)) and not(ModifyingProcessFileName has_any (editor_procs)),
    "HIGH",
    ModifyingProcessFileName has_any (editor_procs),
    "MEDIUM",
    "MEDIUM")
| project Timestamp = SpawnTime, DeviceName, AccountName, ConfigFileName, ConfigFolderPath, ModifyingProcessFileName, ModifyingProcessCommandLine, SpawnedChildFileName, SpawnedChildCommandLine, Confidence
| order by Timestamp desc
// false_positives: (1) Correlation is now restricted to child processes whose command line is MCP-server-shaped (contains 'mcp', '@modelcontextprotocol', 'npx -y', 'uvx', or a known MCP server package name, or is a node/python/uvx/npx invocation referencing an MCP-related package) rather than any subprocess spawned by an agent app within 5 minutes of a config edit -- this removes the near-continuous noise previously generated by VS Code (code.exe) spawning unrelated background children (extension host, ripgrep, git, language servers, tasks). (2) Bare-filename matches for mcp.json/mcp_servers.json and OAI_CONFIG_LIST.json now exclude paths under node_modules, site-packages, dist, build, or .cache, and require the file to sit under a plausible user/agent config directory (AppData\\Roaming, .config, or one of the already-scoped agent config folders) instead of matching any copy of these filenames shipped inside dependency/package directories.