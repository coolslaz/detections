// T1555.006 - Credentials from Password Stores: Cloud Secrets Management Stores
// Correlates AI agent tool process execution on endpoints with subsequent Key Vault data-plane access
// false_positives:
//   1) Endpoint processes with no resolved AccountUpn and cloud audit events with no UPN claim (service-principal/managed-identity auth) are excluded pre-join to prevent fabricated empty-string correlations.
//   2) 'DefaultAzureCredential'/'ManagedIdentityCredential' are generic Azure SDK auth patterns (used by Storage, Cosmos DB, Graph API, etc.); they only count as a Key Vault indicator when the same command line also references 'vault.azure.net' or 'keyvault'.
//   3) Correlation window narrowed from 10m to 5m to reduce coincidental matches for identities with frequent Key Vault activity from multiple sources.
//   4) Bulk enumeration signal excludes known automation/service-account UPN naming patterns (svc-, sa-, automation, pipeline, ci-cd, devops) and requires OpCount > DistinctSecrets (sustained repeated gets) so a single SecretList/VaultGet-style listing call is not flagged.
let aiAgentTools = dynamic(["claude","claude-code","cursor","copilot","gh-copilot","autogpt","langchain","langgraph","ollama","aider","continue","open-interpreter","openinterpreter","autogen","crewai","chatgpt"]);
let kvOps = dynamic(["SecretGet","SecretList","SecretListVersions","KeyGet","KeyList","KeyDecrypt","KeySign","KeyUnwrapKey","CertificateGet","CertificateList"]);
let kvIndicators = dynamic(["az keyvault secret","az keyvault key","az keyvault certificate","Get-AzKeyVaultSecret","Get-AzKeyVaultKey","Get-AzKeyVaultCertificate","SecretClient(","KeyClient(","CertificateClient(","azure.keyvault","azure-keyvault"]);
let kvGenericAuthIndicators = dynamic(["DefaultAzureCredential","ManagedIdentityCredential"]);
let automationUpnPatterns = dynamic(["svc-","sa-","automation","pipeline","ci-cd","devops"]);
let EndpointAgentKVAccess = DeviceProcessEvents
| where InitiatingProcessFileName has_any (aiAgentTools) or InitiatingProcessFolderPath has_any (aiAgentTools)
| where isnotempty(AccountUpn)
| where ProcessCommandLine has_any (kvIndicators)
    or (ProcessCommandLine has_any (kvGenericAuthIndicators) and (ProcessCommandLine contains "vault.azure.net" or ProcessCommandLine contains "keyvault"))
| project Timestamp, DeviceName, AccountUpn, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, ProcessCommandLine;
let CloudKVAccess = AzureDiagnostics
| where ResourceProvider == "MICROSOFT.KEYVAULT"
| where ResourceType == "VAULTS"
| where Category == "AuditEvent"
| where ResultType == "Success"
| where OperationName in (kvOps)
| extend UPN = tostring(identity_claim_http_schemas_xmlsoap_org_ws_2005_05_identity_claims_upn_s)
| where isnotempty(UPN)
| project TimeGenerated, UPN, Resource, OperationName, CallerIPAddress, requestUri_s, clientInfo_s;
// Primary correlation: AI-agent process on endpoint followed by cloud-plane Key Vault access from the same identity within 5 minutes
EndpointAgentKVAccess
| join kind=inner (
    CloudKVAccess
) on $left.AccountUpn == $right.UPN
| where TimeGenerated between (Timestamp .. (Timestamp + 5m))
| project Timestamp, TimeGenerated, DeviceName, AccountUpn, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, ProcessCommandLine, Resource, OperationName, CallerIPAddress, requestUri_s, clientInfo_s
| extend AlertType = "AI Agent Endpoint-to-Cloud Key Vault Access Correlation", Confidence = "High"
| union (
    // Secondary, lower-confidence standalone signal: bulk/rapid secret enumeration by a single identity
    // characteristic of automated/agentic retrieval rather than a human opening one secret in the portal
    CloudKVAccess
    | where OperationName in ("SecretGet", "SecretList")
    | where not(UPN has_any (automationUpnPatterns))
    | extend SecretName = extract(@"secrets/([^/]+)", 1, requestUri_s)
    | summarize DistinctSecrets = dcount(SecretName), OpCount = count(), Vaults = make_set(Resource, 20), IPs = make_set(CallerIPAddress, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by UPN, bin(TimeGenerated, 5m)
    | where DistinctSecrets > 10 and OpCount > DistinctSecrets
    | project TimeGenerated = FirstSeen, AccountUpn = UPN, Resource = tostring(Vaults), OperationName = "BulkSecretEnumeration", CallerIPAddress = tostring(IPs), DistinctSecrets, OpCount, LastSeen
    | extend AlertType = "Bulk Key Vault Secret Enumeration", Confidence = "Low"
)