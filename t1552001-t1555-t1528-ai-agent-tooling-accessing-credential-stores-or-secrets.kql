// Detects AI coding assistants / LLM agent frameworks touching credential material
// Behavior class 1: file access to known credential/secret locations
// Behavior class 2: process execution retrieving credentials programmatically
// MITRE ATT&CK: T1552.001, T1555, T1528
let ai_agent_tools = dynamic(["claude", "claude-code", "cursor", "copilot", "gh-copilot", "autogpt", "langchain", "langgraph", "ollama", "aider", "continue", "open-interpreter", "openinterpreter", "autogen", "crewai", "chatgpt"]);
let cred_paths = dynamic([".aws/credentials", ".aws/config", ".ssh/id_rsa", ".ssh/id_ed25519", ".netrc", ".npmrc", ".pypirc", ".docker/config.json", ".kube/config", "application_default_credentials.json", "accessTokens.json", ".env", "credentials.json", "secrets.yaml", "secrets.yml", "id_rsa", ".pem", ".pfx", ".kdbx", "Login Data", "Cookies", "login.keychain-db", "ntds.dit"]);
let registry_hive_export_patterns = dynamic(["\\config\\sam", "\\config\\system"]);
let registry_hive_export_commands = dynamic(["reg save hklm\\sam", "reg save hklm\\system", "reg.exe save hklm\\sam", "reg.exe save hklm\\system"]);
let cred_template_files = dynamic([".env.example", ".env.sample", ".env.template"]);
let ai_provider_cred_vars = dynamic(["OPENAI_API_KEY", "ANTHROPIC_API_KEY", "AZURE_OPENAI_API_KEY", "GOOGLE_API_KEY", "COHERE_API_KEY", "HUGGINGFACE_TOKEN"]);
let FileAccessByAgent = 
    DeviceFileEvents
    | where ActionType in ("FileCreated", "FileModified", "FileRenamed")
    | where InitiatingProcessFileName has_any (ai_agent_tools) or InitiatingProcessFolderPath has_any (ai_agent_tools)
    | where (FolderPath has_any (cred_paths) or FileName has_any (cred_paths))
        or (FolderPath has_any (registry_hive_export_patterns) or FileName has_any (registry_hive_export_patterns))
    | project Timestamp, DeviceId, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine = "", ActionType;
let ProcExecByAgent = 
    DeviceProcessEvents
    | where InitiatingProcessFileName has_any (ai_agent_tools) or InitiatingProcessFolderPath has_any (ai_agent_tools)
    | extend matched_cred_var = extract(@"(?i)([A-Z0-9_]*(?:SECRET|TOKEN|API_KEY|PASSWORD))\s*=", 1, ProcessCommandLine)
    | where ProcessCommandLine has_any (
        "security find-generic-password", "security find-internet-password",
        "gcloud auth print-access-token", "aws sts get-session-token", "aws configure list",
        "az account get-access-token", "vault kv get", "op item get",
        "git credential-fill", "git credential fill")
        or ProcessCommandLine has_any (registry_hive_export_commands)
        or (
            ProcessCommandLine has_any ("cat ", "type ", "Get-Content")
            and ProcessCommandLine has_any (cred_paths)
            and not(ProcessCommandLine has_any (cred_template_files))
            and not(ProcessCommandLine matches regex @"(?i)[\\/](test|tests|fixtures|node_modules)[\\/]")
        )
        or (
            isnotempty(matched_cred_var)
            and not(matched_cred_var in~ (ai_provider_cred_vars))
        )
    | project Timestamp, DeviceId, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName = "", FolderPath = "", ProcessCommandLine, ActionType = "ProcessCreated";
FileAccessByAgent
| union ProcExecByAgent
| project Timestamp, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine, ActionType
| distinct Timestamp, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine, ActionType
| order by Timestamp desc
// False positives: (1) AI coding assistants may legitimately read non-secret config/template files
// (.env.example, .env.sample, .env.template) or files under test/tests/fixtures/node_modules directories
// during normal development - these are excluded from the cat/type/Get-Content condition.
// (2) The SECRET|TOKEN|API_KEY|PASSWORD regex excludes known first-party AI-provider credential variable
// names (OPENAI_API_KEY, ANTHROPIC_API_KEY, AZURE_OPENAI_API_KEY, GOOGLE_API_KEY, COHERE_API_KEY,
// HUGGINGFACE_TOKEN) that the agent itself routinely passes to authenticate to its own LLM provider.
// (3) Registry hive access is now matched only via specific hive export path fragments
// (\\config\\sam, \\config\\system) and reg save hklm\\sam|system command patterns, rather than the
// bare words SAM/SYSTEM which over-matched ordinary filenames such as System32 paths or files named
// SAMPLE/SYSTEM.log. Triage remaining matches for signs of exfiltration intent (e.g. subsequent network
// egress, clipboard copy, or upload activity) rather than treating matches as inherently malicious.