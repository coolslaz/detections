let TrustedVendorPathPatterns = dynamic([
  @"Program Files\Microsoft Azure AD Connect",
  @"Program Files\Microsoft Azure Active Directory Connect",
  @"Program Files\Cisco\Cisco AnyConnect",
  @"Program Files\OpenVPN",
  @"Program Files\Palo Alto Networks\GlobalProtect",
  @"Program Files\Juniper Networks",
  @"Program Files\Pulse Secure",
  @"Program Files\Fortinet\FortiClient",
  @"Program Files\NetIQ",
  @"Program Files\SpecOps",
  @"Program Files\Thycotic",
  @"Program Files\CyberArk"
]);
let SuspiciousPathPatterns = dynamic([
  @"\AppData\",
  @"\Temp\",
  @"\ProgramData\",
  @"\Users\Public\",
  @"\Downloads\",
  @"\Windows\Tasks\",
  @"\PerfLogs\"
]);
let InstallerProcessNames = dynamic([
  "msiexec.exe", "setup.exe", "install.exe", "trustedinstaller.exe",
  "installutil.exe", "drvinst.exe", "wusa.exe", "tiworker.exe"
]);
let TrustedSigners = dynamic([
  "Microsoft Corporation", "Microsoft Windows", "Cisco Systems", "Palo Alto Networks",
  "Juniper Networks", "Pulse Secure", "Fortinet", "NetIQ Corporation", "CyberArk Software Ltd",
  "Thycotic Software LLC", "Specops Software"
]);
let RegistryDetections = DeviceRegistryEvents
| where ActionType in ("RegistryValueSet", "RegistryKeyCreated")
| where RegistryKey has_any (dynamic([
    @"HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa\Notification Packages",
    @"HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa\Authentication Packages",
    @"HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa\Security Packages",
    @"HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa\OSConfig\Security Packages",
    @"HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NetworkProvider\Order"
  ]))
| where not(InitiatingProcessFileName in~ (InstallerProcessNames))
| where not(RegistryValueData has_any (TrustedVendorPathPatterns))
| join kind=leftouter (
    DeviceFileCertificateInfo
    | project InitiatingProcessSHA1 = SHA1, IsSigned, IsTrusted, CertificateSubject = Signer
  ) on $left.InitiatingProcessSHA1 == $right.InitiatingProcessSHA1
| where isnull(IsSigned) or IsSigned == false or IsTrusted == false or not(CertificateSubject has_any (TrustedSigners))
| where RegistryValueData has_any (SuspiciousPathPatterns) or isnull(IsSigned) or IsSigned == false
| project TimeGenerated, DeviceName, ActionType, RegistryKey, RegistryValueName, RegistryValueData, InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, IsSigned, IsTrusted, CertificateSubject
| extend DetectionType = "LSA Registry Modification (Password Filter/SSP-AP/Network Provider) - Unsigned/Untrusted";
let PAMDetections = DeviceFileEvents
| where ActionType in ("FileModified", "FileCreated", "FileRenamed")
| where FolderPath has "/etc/pam.d/" or FolderPath has "/etc/security/pam_env.conf" or FolderPath has "/etc/pam.conf"
| where not(InitiatingProcessFileName in~ (InstallerProcessNames))
| project TimeGenerated, DeviceName, ActionType, FolderPath, FileName, InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine
| extend DetectionType = "Linux PAM Configuration Modification";
RegistryDetections
| union PAMDetections
| sort by TimeGenerated desc