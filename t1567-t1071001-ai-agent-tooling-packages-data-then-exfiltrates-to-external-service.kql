// Detects AI coding/agent tooling (Claude Code, Cursor, Copilot CLI, AutoGPT, LangChain/LangGraph, Ollama, Aider, Continue, OpenInterpreter, AutoGen, CrewAI, ChatGPT) packaging sensitive data then exfiltrating it to a non-AI-provider external destination
// MITRE ATT&CK T1567 - Exfiltration Over Web Service, T1071.001 - Application Layer Protocol: Web Protocols
let lookback = 1d;
let ai_agent_tools = dynamic(["claude","claude-code","cursor","copilot","gh-copilot","autogpt","langchain","langgraph","ollama","aider","continue","open-interpreter","openinterpreter","autogen","crewai","chatgpt"]);
let known_ai_providers = dynamic(["api.openai.com","api.anthropic.com","generativelanguage.googleapis.com","api.cohere.ai","openrouter.ai","huggingface.co"]);
let known_dev_services = dynamic(["github.com","raw.githubusercontent.com","objects.githubusercontent.com","registry.npmjs.org","pypi.org","files.pythonhosted.org","hub.docker.com","crates.io","proxy.golang.org"]);
let exfil_services = dynamic(["transfer.sh","file.io","anonfiles","mega.nz","wetransfer","pastebin.com","ghostbin","0bin","gofile.io","webhook.site","requestbin","ngrok","pipedream"]);
let pkg_mgr_dirs = dynamic(["node_modules",".npm",".cache\\pip","site-packages","__pycache__",".venv","venv","dist-packages","AppData\\Local\\pip\\Cache",".cargo\\registry","go\\pkg\\mod"]);
let packaging_events = DeviceFileEvents
| where Timestamp > ago(lookback)
| where ActionType in ("FileCreated","FileModified","FileRenamed")
| where InitiatingProcessFileName has_any (ai_agent_tools) or InitiatingProcessFolderPath has_any (ai_agent_tools)
| where FileName has_any (".zip",".tar",".gz",".7z",".rar",".sql",".db",".sqlite",".bak")
| where not(FolderPath has_any (pkg_mgr_dirs))
| project DeviceId, InitiatingProcessId, PackageTimestamp = Timestamp, FileName, FolderPath, InitiatingProcessFileName, InitiatingProcessCommandLine, DeviceName, AccountName;
let egress_events = DeviceNetworkEvents
| where Timestamp > ago(lookback)
| where ActionType == "ConnectionSuccess"
| where InitiatingProcessFileName has_any (ai_agent_tools) or InitiatingProcessFolderPath has_any (ai_agent_tools)
| where not(RemoteUrl has_any (known_ai_providers))
| where not(RemoteUrl has_any (known_dev_services))
| extend IsKnownExfilService = RemoteUrl has_any (exfil_services)
| extend IsRawIp = RemoteUrl matches regex @"^\d{1,3}(\.\d{1,3}){3}$"
| extend IsPrivateIp = IsRawIp and (ipv4_is_private(RemoteUrl) or RemoteUrl startswith "127." or RemoteUrl startswith "169.254." or RemoteUrl == "::1" or RemoteUrl startswith "fe80")
| extend IsRawIpNonstandardPort = (IsRawIp and RemotePort !in (80,443) and not(IsPrivateIp))
| where IsKnownExfilService or IsRawIpNonstandardPort
| project DeviceId, InitiatingProcessId, NetTimestamp = Timestamp, RemoteUrl, RemoteIP, RemotePort, ActionType, InitiatingProcessFileName2 = InitiatingProcessFileName;
packaging_events
| join kind=inner (egress_events) on DeviceId, InitiatingProcessId
| where NetTimestamp between (PackageTimestamp .. (PackageTimestamp + 10m))
| project Timestamp = NetTimestamp, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, RemoteUrl, RemoteIP, RemotePort, ActionType
| order by Timestamp desc
// false_positives: (1) Package-manager/dependency-cache directories (node_modules, .npm, .cache/pip, site-packages, __pycache__, .venv, venv, dist-packages, AppData\Local\pip\Cache, .cargo\registry, go/pkg/mod) are excluded from packaging_events to avoid flagging normal pip/npm/yarn/cargo/go package downloads and caching of .tar.gz/.whl archives.
// (2) Raw-IP connections to RFC1918 private ranges, loopback, and link-local addresses are excluded from IsRawIpNonstandardPort since these are internal destinations, not exfiltration to an external service.
// (3) Known legitimate developer/package-registry services (github.com, raw.githubusercontent.com, objects.githubusercontent.com, registry.npmjs.org, pypi.org, files.pythonhosted.org, hub.docker.com, crates.io, proxy.golang.org) are excluded from egress_events alongside known AI providers, since AI agents routinely push/pull code and packages to these destinations.