// MITRE ATT&CK: T1591 - Gather Victim Org Information
// Severity: Low/Medium
// False Positives: legitimate BI/market-research/OSINT tools rapidly viewing many company profiles (mitigated below by requiring 5+ distinct profile URLs and excluding known search-engine/SEO crawler user agents)
CommonSecurityLog
| where DestinationHostName has "linkedin.com"
| where RequestURL has "/about/"
| where not(RequestClientApplication has_any ("Googlebot", "bingbot", "Slurp", "DuckDuckBot", "Baiduspider", "YandexBot", "facebookexternalhit", "AhrefsBot", "SemrushBot"))
| summarize RequestCount = count(), URLs = make_set(RequestURL, 10), DistinctPages = dcount(RequestURL) by SourceIP, TimeBucket = bin(ReceiptTime, 60s)
| where RequestCount >= 10 and DistinctPages >= 5
| project TimeBucket, SourceIP, RequestCount, DistinctPages, URLs
| sort by RequestCount desc