// Detects TeamFiltration/UNK_CondorFiltration-style password spray: many distinct target
// accounts, each receiving only a handful of attempts, spread across multiple distinct
// AWS EC2-hosted source IPs and multiple regions against the SAME tenant within a short
// window. A single sign-in from an AWS-hosted IP is never sufficient on its own -
// legitimate VPN exit nodes and corporate cloud proxies also originate from AWS ranges.
let AwsRange1 = "3.101.0.0/16";
let AwsRange2 = "18.144.76.0/24";
let AwsRange3 = "13.52.201.0/24";
SigninLogs
| where TimeGenerated > ago(1d)
| extend IsKnownAwsRange = ipv4_is_in_range(IPAddress, AwsRange1) or ipv4_is_in_range(IPAddress, AwsRange2) or ipv4_is_in_range(IPAddress, AwsRange3)
| where IsKnownAwsRange
| extend Hour = bin(TimeGenerated, 1h)
// Stage 1: per-account, per-tenant, per-hour attempt volume and IP diversity
| summarize AttemptsPerAccount = count(),
            FailedPerAccount = countif(ResultType != "0"),
            DistinctIPsPerAccount = dcount(IPAddress),
            DistinctRegionsPerAccount = dcount(Location)
            by UserPrincipalName, TenantId, Hour
// Campaign signature at the account level: low attempt volume, at least one failure
| where AttemptsPerAccount between (1 .. 3) and FailedPerAccount > 0
// Stage 2: roll up per tenant/hour to find the distributed spray fan-out
| summarize DistinctAccounts = dcount(UserPrincipalName),
            TotalAttempts = sum(AttemptsPerAccount),
            MaxAttemptsPerAccount = max(AttemptsPerAccount),
            AvgAttemptsPerAccount = avg(AttemptsPerAccount),
            DistinctAwsRegions = max(DistinctRegionsPerAccount)
            by TenantId, Hour
| where DistinctAccounts >= 20 and AvgAttemptsPerAccount <= 3 and MaxAttemptsPerAccount <= 5
| project Hour, TenantId, DistinctAccounts, TotalAttempts, AvgAttemptsPerAccount, MaxAttemptsPerAccount, DistinctAwsRegions
| sort by Hour desc