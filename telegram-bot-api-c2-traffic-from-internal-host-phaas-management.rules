alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"NDR - Telegram Bot API TLS SNI Contact - Possible PhaaS C2/Management Channel"; flow:to_server,established; tls.sni; content:"api.telegram.org"; nocase; fast_pattern; classtype:command-and-control; metadata: author detections.ai, created_at 2026-08-15, mitre_tactic_id TA0011, mitre_technique_id T1102.002, mitre_technique_id T1583.006; sid:1000101; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"NDR - Telegram Bot API HTTP Request - Possible PhaaS C2/Management Channel"; flow:to_server,established; http.host; content:"api.telegram.org"; nocase; fast_pattern; http.uri; content:"/bot"; nocase; classtype:command-and-control; metadata: author detections.ai, created_at 2026-08-15, mitre_tactic_id TA0011, mitre_technique_id T1102.002, mitre_technique_id T1583.006; sid:1000102; rev:1;)