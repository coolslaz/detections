DeviceRegistryEvents
| where RegistryKey has @"Software\synapse\Config" and RegistryValueName =~ "SealedConfig"
| where ActionType in ("RegistryValueSet", "RegistryKeyCreated")
| join kind=leftouter (
    DeviceFileEvents
    | where ActionType == "FileDeleted"
    | where FileName =~ "config.toml"
    | project DeviceId, ConfigDeletedTime = TimeGenerated, DeletedFileName = FileName
) on DeviceId
| project-reorder TimeGenerated, DeviceId, RegistryKey, RegistryValueName, ActionType, InitiatingProcessFileName, InitiatingProcessCommandLine, ConfigDeletedTime, DeletedFileName