DeviceFileEvents
| where FileName == "c8c68e629bba773a10ac80012d10bf19"
| where FolderPath has "/var/lib/sshd/"
| where ActionType in ("FileCreated", "FileModified")
| join kind=leftouter (
    DeviceProcessEvents
    | where FileName == "sshd"
    | where SHA256 == "4bb923eb040aa13ca8fd409c31ee4729c60ddff32e350efe1c5a4a9168a065f5"
) on DeviceId
| project TimeGenerated, DeviceId, FolderPath, FileName, InitiatingProcessFileName, InitiatingProcessSHA256, SHA256
// Also directly flag any process matching the known trojanized sshd hash
| union (DeviceProcessEvents
| where FileName == "sshd"
| where SHA256 == "4bb923eb040aa13ca8fd409c31ee4729c60ddff32e350efe1c5a4a9168a065f5")