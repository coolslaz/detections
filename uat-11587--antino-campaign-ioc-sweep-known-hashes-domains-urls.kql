let known_domains = dynamic(["microsoft-flash.com","wps-cn.com","osc-cdn.com","d32tpl7xt7175h.cloudfront.net","d2nq35tel3ucuo.cloudfront.net","oisadjfoinsiduhfnoisdnfosdnoifnsoid.pages.dev"]);
let known_urls = dynamic(["https://microsoft-flash.com/download/flashcenter_pp_ax_install_en.exe","https://www.wps-cn.com/downloads/flashcenter_pp_ax_install_en.exe","https://my-662ylt3w.pages.dev/Institutional_Disciplinary_Action_Report_May_2026.hta","https://my-662ylt3w.pages.dev/Institutional_Disciplinary_Action_Report_May_2026.wsf","https://my-6g16qsfe.pages.dev/the%20May%2027%20inauguration%20of%20the%20TPiE.hta","https://my-6g16qsfe.pages.dev/the%20May%2027%20inauguration%20of%20the%20TPiE.wsf","https://my-goq6xmbm.pages.dev/Tehran_Bilateral_Summit_Proceedings_May2026.hta","https://my-goq6xmbm.pages.dev/Tehran_Bilateral_Summit_Proceedings_May2026.wsf","https://my-h3qli6kq.pages.dev/CrossBorder_Repression_Seminar_Agenda.hta"]);
// This Talos report does not list any dedicated malicious IPv4 addresses for the Antino chain;
// Antino's C2 rides Microsoft Graph domains (graph.microsoft.com / login.microsoftonline.com), not dedicated IPs.
// The IP array is left empty and ready for analysts to populate as new intel emerges.
let known_ips = dynamic([]);
let hash_hits = DeviceFileEvents
| where TimeGenerated > ago(30d)
| where SHA256 in~ (known_sha256_list)
| extend MatchType = "SHA256", Indicator = SHA256
| project TimeGenerated, DeviceId, MatchType, Indicator, FileName, FolderPath;
let domain_hits = DeviceNetworkEvents
| where TimeGenerated > ago(30d)
| extend RemoteHost = tostring(parse_url(RemoteUrl).Host)
// Tightened for FP: anchors the match to the actual DNS host (exact or true subdomain) instead of a raw substring
// match anywhere in the URL, which could false-positive on unrelated URLs referencing the domain text in a path,
// query string, or redirect parameter.
| where RemoteHost matches regex @"(?i)(^|\.)(microsoft-flash\.com|wps-cn\.com|osc-cdn\.com|d32tpl7xt7175h\.cloudfront\.net|d2nq35tel3ucuo\.cloudfront\.net|oisadjfoinsiduhfnoisdnfosdnoifnsoid\.pages\.dev)$"
| extend MatchType = "Domain", Indicator = RemoteHost
| project TimeGenerated, DeviceId, MatchType, Indicator, RemoteUrl, RemoteIP, InitiatingProcessFileName;
let url_hits = DeviceNetworkEvents
| where TimeGenerated > ago(30d)
| where RemoteUrl in~ (known_urls)
| extend MatchType = "URL", Indicator = RemoteUrl
| project TimeGenerated, DeviceId, MatchType, Indicator, RemoteUrl, RemoteIP, InitiatingProcessFileName;
let ip_hits = DeviceNetworkEvents
| where TimeGenerated > ago(30d)
| where RemoteIP in (known_ips)
| extend MatchType = "IP", Indicator = RemoteIP
| project TimeGenerated, DeviceId, MatchType, Indicator, RemoteUrl, RemoteIP, InitiatingProcessFileName;
union hash_hits, domain_hits, url_hits, ip_hits
| sort by TimeGenerated desc