// Detects unauthenticated access to an AI agent management backend that discloses agent configurations
// (including Dify application keys and Coze private keys) or accepts unauthenticated agent config creation
let SuspiciousRequests = AppServiceHTTPLogs
| where CsUriStem has "agent" and CsUriStem has_any ("config", "configuration", "configs")
| where isempty(CsUsername) or isempty(CsUriQuery) or not(CsUriStem has "auth")
| where CsMethod in ("GET", "POST")
| where ScStatus == 200;
let SecretResponses = AppServiceAppLogs
| where Message has_any ("dify", "application_key", "coze", "private_key");
SuspiciousRequests
| join kind=leftouter (SecretResponses) on $left.TimeGenerated == $right.TimeGenerated
| extend ResponseHasSecrets = isnotempty(Message)
| where ResponseHasSecrets == true or CsMethod == "POST"
| project TimeGenerated, CIp, CsMethod, CsUriStem, CsUriQuery, ScStatus, ResponseHasSecrets
| sort by TimeGenerated desc