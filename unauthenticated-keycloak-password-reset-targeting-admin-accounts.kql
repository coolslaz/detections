// Detects anomalous unauthenticated password reset requests against Keycloak's
// reset-credentials endpoint that target administrative accounts, or a single
// source correlating reset attempts across multiple usernames (CVE-2026-18963)
AppRequests
| where RequestUri has "/login-actions/reset-credentials"
| where EventType in ("RESET_PASSWORD", "RESET_PASSWORD_ERROR", "UPDATE_PASSWORD")
| where isempty(SessionId) or Authenticated == false
| extend IsAdminTarget = Username has_any ("admin", "administrator", "root", "superadmin")
| extend TimeBucket = bin(TimeGenerated, 15m)
| summarize
    ResetAttempts = count(),
    TargetedUsernames = make_set(Username, 50),
    DistinctUsernames = dcount(Username),
    AdminTargeted = countif(IsAdminTarget)
    by ClientIP, RealmName, TimeBucket
| where AdminTargeted > 0 or DistinctUsernames >= 3
| project TimeBucket, ClientIP, RealmName, ResetAttempts, DistinctUsernames, AdminTargeted, TargetedUsernames
| sort by ResetAttempts desc