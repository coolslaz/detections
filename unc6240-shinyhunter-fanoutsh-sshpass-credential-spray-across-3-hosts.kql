// Detects a fanout.sh-style script in /tmp whose child sshpass process tree sprays SSH credentials against 3 or more distinct internal hosts within a 10-minute window, as used by UNC6240 for lateral movement across PeopleSoft nodes
DeviceProcessEvents
| where FileName =~ "bash" and ProcessCommandLine matches regex @"/tmp/\w*_?fanout\.sh"
| project FanoutTimestamp = Timestamp, DeviceId, DeviceName, FanoutCommandLine = ProcessCommandLine, InitiatingProcessAccountName
| join kind=inner (
    DeviceProcessEvents
    | where FileName =~ "sshpass"
    | where ProcessCommandLine matches regex @"-p\s+\S+"
    | where ProcessCommandLine has "StrictHostKeyChecking=no"
    | where InitiatingProcessCommandLine matches regex @"/tmp/\w*_?fanout\.sh"
    | extend TargetHost = extract(@"@([\w\.-]+)", 1, ProcessCommandLine)
    | where isnotempty(TargetHost)
    | project SshTimestamp = Timestamp, DeviceId, SshCommandLine = ProcessCommandLine, InitiatingProcessCommandLine, TargetHost
) on DeviceId
| where abs(datetime_diff('second', SshTimestamp, FanoutTimestamp)) < 600
| summarize DistinctTargets = dcount(TargetHost), TargetList = make_set(TargetHost, 20), AttemptCount = count(), FirstAttempt = min(SshTimestamp), LastAttempt = max(SshTimestamp) by DeviceId, DeviceName, FanoutCommandLine, InitiatingProcessAccountName
| where DistinctTargets >= 3
| extend AlertReason = "fanout.sh-spawned sshpass process tree sprayed SSH credentials with StrictHostKeyChecking disabled against 3+ distinct internal hosts within 10 minutes"