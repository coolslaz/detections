let meshAgentNames = dynamic(["meshagent", "meshagent.msh", "meshagent.db"]);
let maliciousDomains = dynamic(["azurenetfiles.net", "microsoft-entra.net", "enroll.azuredevice.cloud", "winmanage-me.network"]);
let maliciousIP = "104.219.234.138";
DeviceProcessEvents
| where FileName in~ (meshAgentNames)
| where FolderPath has "/tmp"
| project Timestamp, DeviceId, FileName, FolderPath, ProcessCommandLine, InitiatingProcessFileName, SHA256, ReportId
| join kind=inner (
    DeviceNetworkEvents
    | where RemoteUrl has_any (maliciousDomains) or RemoteIP == maliciousIP
    | project NetTimestamp = Timestamp, DeviceId, RemoteUrl, RemoteIP, RemotePort, InitiatingProcessFileName
) on DeviceId
| where NetTimestamp between (Timestamp .. (Timestamp + 15m))
| project Timestamp, NetTimestamp, DeviceId, FileName, FolderPath, ProcessCommandLine, SHA256, RemoteUrl, RemoteIP, RemotePort
| sort by Timestamp desc