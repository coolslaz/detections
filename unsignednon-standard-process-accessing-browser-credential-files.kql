DeviceProcessEvents
| where FolderPath !endswith "\\chrome.exe" and FolderPath !endswith "\\msedge.exe" and FolderPath !endswith "\\firefox.exe" and FolderPath !endswith "\\brave.exe" and FolderPath !endswith "\\opera.exe" and FolderPath !endswith "\\iexplore.exe"
| where not(FolderPath has_any ("1Password", "Bitwarden", "LastPass", "KeePass", "OneDrive", "GoogleDrive", "Dropbox", "MsMpEng", "MsSense", "SenseIR", "SenseCncProxy", "CSFalconService", "cb.exe", "CrowdStrike", "Defender", "Symantec", "McAfee", "TrendMicro", "Sophos"))
| where ProcessCommandLine has_any ("Login Data", "Cookies", "key4.db", "logins.json", "Login Data-journal")
| where ProcessCommandLine has_any ("\\Google\\Chrome\\User Data", "\\Microsoft\\Edge\\User Data", "\\Mozilla\\Firefox\\Profiles", "\\BraveSoftware\\Brave-Browser\\User Data", "\\Opera Software")
| where not(FolderPath has_any ("\\Program Files\\", "\\Program Files (x86)\\"))
| project TimeGenerated, DeviceName, AccountName, FileName, FolderPath, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessAccountName
| order by TimeGenerated desc