// DeviceNetworkEvents uses Timestamp as its time column; aliased to TimeGenerated in output per request
let lookback = 30d;
let knownHashesSha256 = dynamic([
 "297292d46d4f11fc801f5d6d01251735698a8419aa3196db7b3aa7bb8ea85cad",
 "d398f11c236a59e44a9dff6f99af3aacefcb4a4bdf77bb7cf790cd0b13b0439a",
 "ec47a2101de4f1fc25995e775ddb48e20977081c4d885e6ff8fdfe9109d05495",
 "c88165d943f59014d668818d99d9819e6d295d355c4e935ad7a2380bbe32ccc4",
 "cd0a48b5ebd946ea2b8964e9d6a73a48d73777fdb7c8da99c28404150b560f6c",
 "0db1e8a3075ffc2f5caa91abaeabb6ba4365ae0eda64d179374614a79e317733"
]);
let knownHashesMd5 = dynamic([
 "5dd387acef74a14a63dbc883aadee854"
]);
let knownC2IPs = dynamic([
 "111.92.246.145"
]);
let knownDomains = dynamic([
 "medianewsonline.com",
 "elementfx.com",
 "onlinewebshop.net",
 "mywebcommunity.org",
 "mygamesonline.org"
]);
let knownUrls = dynamic([
 "p1o2i3u4y5t6r7e8w9q0.medianewsonline.com/login.php",
 "p1o2i3u4y5t6r7e8w9q0.medianewsonline.com/logout.php",
 "iuh234.medianewsonline.com/dwnkl.php",
 "pg50kb75nh.mywebcommunity.org/phdown.php",
 "wersdfxcv.mygamesonline.org/view.php",
 "raw.githubusercontent.com/omskiwdcvoiuyfd0998"
]);
DeviceNetworkEvents
| where TimeGenerated > ago(lookback)
| where InitiatingProcessSHA256 in (knownHashesSha256)
 or InitiatingProcessMD5 in (knownHashesMd5)
 or RemoteIP in (knownC2IPs)
 or RemoteUrl has_any (knownDomains)
 or RemoteUrl has_any (knownUrls)
| extend MatchedIOCType = case(
 InitiatingProcessSHA256 in (knownHashesSha256) or InitiatingProcessMD5 in (knownHashesMd5), "hash",
 RemoteIP in (knownC2IPs), "ip",
 RemoteUrl has_any (knownUrls), "url",
 RemoteUrl has_any (knownDomains), "domain",
 "unknown"
)
| project TimeGenerated, DeviceId, DeviceName, RemoteIP, RemotePort, RemoteUrl, InitiatingProcessFileName, InitiatingProcessSHA256, InitiatingProcessMD5, InitiatingProcessCommandLine, MatchedIOCType
| sort by TimeGenerated desc