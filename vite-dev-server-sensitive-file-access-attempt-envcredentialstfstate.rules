alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Vite Dev Server Sensitive File Access Attempt (.env/credentials/tfstate)"; flow:to_server,established; http.uri; pcre:"/(?:\.env(?!\.(?:example|sample|template|dist|test))\b|\.aws\/credentials|\.azure\/(?:credentials|azureProfile\.json)|terraform\.tfstate)/i"; http.uri; pcre:!"/\.(?:example|sample|template|dist|test)(?:\?|$)/i"; http.user_agent; pcre:!"/^(?:code-oss|Visual Studio Code|JetBrains|WebStorm|IntelliJ)/i"; reference:url,attack.mitre.org/techniques/T1552/001; classtype:web-application-attack; metadata: author Arnold Chan, mitre_tactic_id TA0009, mitre_technique_id T1552.001, mitre_technique_id T1005, mitre_technique_id T1190; sid:1000101; rev:2;)