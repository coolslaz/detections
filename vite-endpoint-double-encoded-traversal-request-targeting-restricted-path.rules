alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Vite endpoint double-encoded traversal request targeting restricted path"; flow:to_server,established; http.uri; pcre:"/(%252e%252e|%25 2e%25 2e|%2e%2e%252f|%252e%252e%2f|%2e%2e%2f\.\.%2f)/i"; http.uri; pcre:"/(@fs\/|node_modules\/\.\.|\/etc\/passwd|\/proc\/self|\.env(\?|$)|\.git\/config)/i"; http.uri; content:!".js"; http.uri; content:!".css"; http.uri; content:!".map"; http.uri; content:!".png"; http.uri; content:!".svg"; http.uri; content:!".woff"; flowbits:set,vite.traversal.doubleenc; flowbits:noalert; classtype:web-application-attack; metadata: mitre_tactic_id TA0001, mitre_technique_id T1190, mitre_technique_id T1027, author Arnold Chan; sid:1000101; rev:2;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Vite /@fs/ path traversal attempt with encoded or literal traversal sequence"; flow:to_server,established; http.uri; content:"/@fs/"; http.uri; pcre:"/\/@fs\/.*(\.\.%2f|\.\.\/|%2e%2e%2f|%252e%252e)/i"; http.uri; content:!".js"; http.uri; content:!".css"; http.uri; content:!".map"; http.uri; content:!".png"; http.uri; content:!".svg"; flowbits:set,vite.traversal.atfs; flowbits:noalert; classtype:web-application-attack; metadata: mitre_tactic_id TA0001, mitre_technique_id T1190; sid:1000102; rev:2;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"HTTP request with encoded path traversal sequence targeting restricted Vite path"; flow:to_server,established; http.uri; content:"%2e%2e"; nocase; http.uri; pcre:"/(@fs\/|node_modules\/\.\.|\/etc\/passwd|\/proc\/self|\.env(\?|$)|\.git\/config)/i"; http.uri; content:!".js"; http.uri; content:!".css"; http.uri; content:!".map"; http.uri; content:!".png"; http.uri; content:!".svg"; flowbits:set,vite.traversal.singleenc; flowbits:noalert; classtype:web-application-attack; metadata: mitre_tactic_id TA0001, mitre_technique_id T1190, mitre_technique_id T1027; sid:1000103; rev:2;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Successful response to Vite double-encoded/traversal path traversal attempt"; flow:to_client,established; flowbits:isset,vite.traversal.doubleenc; flowbits:isset,vite.traversal.atfs; flowbits:isset,vite.traversal.singleenc; http.stat_code; content:"200"; classtype:web-application-attack; metadata: mitre_tactic_id TA0001, mitre_technique_id T1190, mitre_technique_id T1027, mitre_technique_id T1552.001; sid:1000104; rev:1;)