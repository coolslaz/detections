#event_simpleName=EmailEvents | EmailDirection=Inbound | SubjectText := coalesce(field=Subject, value="") | SubjectForScriptCheck := replace(field=SubjectText, regex="(?i)\\b(microsoft ?365|office ?365|microsoft|sharepoint|onedrive|outlook|teams|paypal|amazon|apple|google|adobe|dhl|fedex|ups)\\b", with="") | HasLatin := regex("[A-Za-z]", field=SubjectForScriptCheck) | HasCyrillic := regex("[\\u0400-\\u04FF]", field=SubjectText) | HasGreek := regex("[\\u0370-\\u03FF]", field=SubjectText) | HasArabic := regex("[\\u0600-\\u06FF]", field=SubjectText) | HasHebrew := regex("[\\u0590-\\u05FF]", field=SubjectText) | HasCJK := regex("[\\u4E00-\\u9FFF\\u3400-\\u4DBF]", field=SubjectText) | HasKana := regex("[\\u3040-\\u30FF]", field=SubjectText) | HasHangul := regex("[\\uAC00-\\uD7A3]", field=SubjectText) | HasDevanagari := regex("[\\u0900-\\u097F]", field=SubjectText) | HasThai := regex("[\\u0E00-\\u0E7F]", field=SubjectText) | ScriptCount := (if(HasLatin, 1, 0) + if(HasCyrillic, 1, 0) + if(HasGreek, 1, 0) + if(HasArabic, 1, 0) + if(HasHebrew, 1, 0) + if(HasCJK, 1, 0) + if(HasKana, 1, 0) + if(HasHangul, 1, 0) + if(HasDevanagari, 1, 0) + if(HasThai, 1, 0)) | NonLatinScriptCount := (ScriptCount - if(HasLatin, 1, 0)) | MixedScriptIndicator := if(NonLatinScriptCount >= 2, 1, if(HasLatin, if(NonLatinScriptCount >= 1, 1, 0), 0)) | HomoglyphIndicator := regex("(?:[A-Za-z]+[\\u0400-\\u04FF\\u0370-\\u03FF]|[\\u0400-\\u04FF\\u0370-\\u03FF]+[A-Za-z])", field=SubjectText) | PhishingKeywordHits := if(regex("(?i)(log[ -]?in|password|passwd|\\bmfa\\b|multi-factor|verify|verification|\\baccount\\b|invoice|payment|payroll|voice[ -]?mail|security alert|password reset|reset your|expired|expire[sd]?|urgent|action required|suspend(ed)?|microsoft 365|office 365|sharepoint|onedrive|confirm your|update your|click here|unusual sign-?in|unusual activity|wire transfer)", field=SubjectText), 1, 0) | Sig_MixedScript := MixedScriptIndicator | Sig_Homoglyph := if(HomoglyphIndicator, 1, 0) | Sig_PhishVocab := if(PhishingKeywordHits > 0, 1, 0) | LanguageConfusionScore := ((if(Sig_MixedScript, 2, 0)) + (if(Sig_Homoglyph, 3, 0)) + (if(Sig_PhishVocab, 2, 0))) | LanguageSignalPresent := if(Sig_MixedScript >= 1, 1, if(Sig_Homoglyph >= 1, 1, 0)) | LanguageSignalPresent >= 1 | LanguageConfusionScore >= 6 | table([@timestamp, RecipientEmailAddress, SenderFromDomain, Subject, LanguageConfusionScore])