index=email sourcetype=email* earliest=-1d | eval SubjectText=coalesce(Subject, "") | rex field=SubjectText "(?i)(?<brandToken>microsoft\s?365|office\s?365|microsoft|sharepoint|onedrive|outlook|teams|paypal|amazon|apple|google|adobe|dhl|fedex|ups)" | eval SubjectForScriptCheck=replace(SubjectText, "(?i)\b(microsoft ?365|office ?365|microsoft|sharepoint|onedrive|outlook|teams|paypal|amazon|apple|google|adobe|dhl|fedex|ups)\b", "") | eval HasLatin=if(match(SubjectForScriptCheck, "[A-Za-z]"), 1, 0), HasCyrillic=if(match(SubjectText, "[\u0400-\u04FF]"), 1, 0), HasGreek=if(match(SubjectText, "[\u0370-\u03FF]"), 1, 0), HasArabic=if(match(SubjectText, "[\u0600-\u06FF]"), 1, 0), HasHebrew=if(match(SubjectText, "[\u0590-\u05FF]"), 1, 0), HasCJK=if(match(SubjectText, "[\u4E00-\u9FFF\u3400-\u4DBF]"), 1, 0), HasKana=if(match(SubjectText, "[\u3040-\u30FF]"), 1, 0), HasHangul=if(match(SubjectText, "[\uAC00-\uD7A3]"), 1, 0), HasDevanagari=if(match(SubjectText, "[\u0900-\u097F]"), 1, 0), HasThai=if(match(SubjectText, "[\u0E00-\u0E7F]"), 1, 0) | eval ScriptCount=HasLatin+HasCyrillic+HasGreek+HasArabic+HasHebrew+HasCJK+HasKana+HasHangul+HasDevanagari+HasThai, NonLatinScriptCount=ScriptCount-HasLatin | eval MixedScriptIndicator=if((HasLatin==1 AND NonLatinScriptCount>=1) OR (NonLatinScriptCount>=2), 1, 0) | eval HomoglyphIndicator=if(match(SubjectText, "(?:[A-Za-z]+[\u0400-\u04FF\u0370-\u03FF]|[\u0400-\u04FF\u0370-\u03FF]+[A-Za-z])"), 1, 0) | eval PhishingKeywordHits=if(match(SubjectText, "(?i)(log[ -]?in|password|passwd|\bmfa\b|multi-factor|verify|verification|\baccount\b|invoice|payment|payroll|voice[ -]?mail|security alert|password reset|reset your|expired|expire[sd]?|urgent|action required|suspend(ed)?|microsoft 365|office 365|sharepoint|onedrive|confirm your|update your|click here|unusual sign-?in|unusual activity|wire transfer)"), 1, 0) | eval Sig_MixedScript=MixedScriptIndicator, Sig_Homoglyph=HomoglyphIndicator, Sig_PhishVocab=PhishingKeywordHits | eval LanguageConfusionScore=(Sig_MixedScript*2)+(Sig_Homoglyph*3)+(Sig_PhishVocab*2) | where (Sig_MixedScript==1 OR Sig_Homoglyph==1) AND LanguageConfusionScore>=6 | stats count by SubjectText, Sig_MixedScript, Sig_Homoglyph, Sig_PhishVocab, SenderFromDomain, LanguageConfusionScore