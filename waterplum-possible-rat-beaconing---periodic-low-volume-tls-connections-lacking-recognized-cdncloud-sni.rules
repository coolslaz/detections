alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"WaterPlum possible RAT beaconing - periodic low-volume TLS connections lacking recognized CDN/cloud SNI"; flow:to_server,established; dsize:<200; tls.sni; absent: or_else; content:!"amazonaws.com"; nocase; content:!"cloudfront.net"; nocase; content:!"akamai.net"; nocase; content:!"akamaiedge.net"; nocase; content:!"googleapis.com"; nocase; content:!"google.com"; nocase; content:!"gstatic.com"; nocase; content:!"microsoft.com"; nocase; content:!"windowsupdate.com"; nocase; content:!"office.com"; nocase; content:!"apple.com"; nocase; content:!"icloud.com"; nocase; content:!"cloudflare.com"; nocase; content:!"fastly.net"; nocase; detection_filter:track by_src, count 5, seconds 60; classtype:trojan-activity; metadata: author Arnold Chan, technique Application_Layer_Protocol, tactic Command_and_Control, actor WaterPlum, malware BeaverTail_InvisibleFerret_OtterCookie_OtterCandy, attack_id T1071; reference:url,https://www.ic3.gov/CSA/2026/260918.pdf; sid:1000037; rev:2;)