// Detects the SectopRAT WbElevation.dll harvesting module loading and then reading
// browser/email/wallet credential stores within a short time window on the same device
let lookback = 10m;
let WbElevationLoads =
    DeviceImageLoadEvents
    | where FileName =~ "WbElevation.dll"
    | project DeviceId, LoadTime = Timestamp, InitiatingProcessFileName, InitiatingProcessId
    | union (
        DeviceProcessEvents
        | where ProcessCommandLine has "WbElevation.dll" or FileName =~ "WbElevation.dll"
        | project DeviceId, LoadTime = Timestamp, InitiatingProcessFileName, InitiatingProcessId
    );
let CredentialStoreAccess =
    DeviceFileEvents
    | where FileName in~ ("Login Data", "Cookies", "Web Data", "key4.db", "logins.json", "cookies.sqlite")
       or FolderPath has_any ("MetaMask", "TronLink", "Coinbase Wallet", "Atomic Wallet", "Exodus", "Electrum", "Daedalus mainnet", "Thunderbird")
    | project DeviceId, AccessTime = Timestamp, FileName, FolderPath, InitiatingProcessFileName1 = InitiatingProcessFileName;
WbElevationLoads
| join kind=inner (CredentialStoreAccess) on DeviceId
| where AccessTime between (LoadTime .. (LoadTime + lookback))
| project DeviceId, LoadTime, AccessTime, InitiatingProcessFileName, FileName, FolderPath
| sort by AccessTime desc