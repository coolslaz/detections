// Detects new WordPress administrator account creation occurring shortly after a request to the Mushr00w web shell or a dropped PHP payload in plugin upload paths
let lookback = 1h;
let webshellHits = W3CIISLog
| where cs_uri_stem has_any ("Mushr00w_upl.php", "/wp-content/uploads/elementor/forms/")
| where cs_uri_stem endswith ".php"
| project ShellTime = TimeGenerated, ShellHost = cs_host, ShellUri = cs_uri_stem, ShellClientIP = c_ip;
let adminCreations = WordPressAuditLog_CL
| where Action_s in ("user_register", "add_user", "wp_insert_user")
| where Role_s =~ "administrator" or Capabilities_s has "administrator"
| project AdminTime = TimeGenerated, SiteHost = SiteUrl_s, NewUsername = Username_s, NewUserRole = Role_s, NewUserCapabilities = Capabilities_s;
webshellHits
| join kind=inner (adminCreations) on $left.ShellHost == $right.SiteHost
| where AdminTime between (ShellTime .. (ShellTime + lookback))
| project ShellTime, ShellHost, ShellUri, ShellClientIP, AdminTime, NewUsername, NewUserRole, NewUserCapabilities
| sort by AdminTime desc