// Detects new WordPress administrator account creation occurring shortly after a request to the Mushr00w web shell or a dropped PHP payload in plugin upload paths
let lookback = 1h;
let webshellHits = W3CIISLog
| where csUriStem has_any ("Mushr00w_upl.php", "/wp-content/uploads/elementor/forms/")
| where csUriStem endswith ".php"
| project ShellTime = TimeGenerated, ShellHost = csHost, ShellUri = csUriStem, ShellClientIP = cIP;
let adminCreations = W3CIISLog // Placeholder table for WordPressAuditLog_CL
| where csUriStem in ("user_register", "add_user", "wp_insert_user")
| where csUserAgent =~ "administrator" or csUserAgent has "administrator"
| project AdminTime = TimeGenerated, SiteHost = csHost, NewUsername = csUserName, NewUserRole = csUserAgent, NewUserCapabilities = csUserAgent;
webshellHits
| join kind=inner (adminCreations) on $left.ShellHost == $right.SiteHost
| where AdminTime between (ShellTime .. (ShellTime + lookback))
| project ShellTime, ShellHost, ShellUri, ShellClientIP, AdminTime, NewUsername, NewUserRole, NewUserCapabilities
| sort by AdminTime desc